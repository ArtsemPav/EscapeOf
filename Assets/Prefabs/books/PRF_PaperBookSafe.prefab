--- !u!114 &9071138858589150517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2821017291781188346}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1) \u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u0437\u0430\u043C\u043E\u043A
    \u0438 \u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435  \u0432\u043E\u043A\u0440\u0443\u0433
    \u0446\u0435\u043D\u0442\u0440\u0430 \u0434\u0438\u0441\u043A\u0430. \u0414\u0438\u0441\u043A
    \u043D\u0430\u0447\u043D\u0451\u0442 \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F.\r\n2)
    \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0449\u0435\u043B\u0447\u043A\u0438.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0449\u0435\u043B\u0447\u043E\u043A \u2014
    \u043E\u0434\u0438\u043D \u0448\u0430\u0433, \u043E\u0434\u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F.
    \u041D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u0435: \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
    \u0449\u0435\u043B\u0447\u043E\u043A \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0434\u0438\u043D \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0448\u0430\u0433\u0435.
    \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u0447\u0438\u0441\u043B\u0435. \u0422\u043E\u043B\u044C\u043A\u043E \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.\r\n3) \u0412\u0435\u0434\u0438\u0442\u0435
    \u0434\u0438\u0441\u043A \u0432 \u043D\u0443\u0436\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.
    \u0415\u0441\u043B\u0438 \u0448\u0430\u0433 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u2014 \u043A\u0440\u0443\u0442\u0438\u0442\u0435
    \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439. \u041F\u0440\u043E\u0442\u0438\u0432
    \u2014 \u043F\u0440\u043E\u0442\u0438\u0432. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C.\r\n4)
    \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u043D\u0430
    \u043D\u0443\u0436\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435. \u041D\u0435
    \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u0442\u0435. \u041D\u0435 \u043D\u0435\u0434\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u0435.
    \u0414\u0438\u0441\u043A \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043C\u0435\u0440\u0435\u0442\u044C
    \u0442\u043E\u0447\u043D\u043E \u043D\u0430 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438,
    \u0433\u0434\u0435 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
    \u0449\u0435\u043B\u0447\u043E\u043A.\r\n5) \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435
    \u0437\u0430\u043C\u043E\u043A. \u0418\u043C\u0435\u043D\u043D\u043E \u0432 \u044D\u0442\u043E\u0442
    \u043C\u043E\u043C\u0435\u043D\u0442 \u0437\u0430\u043C\u043E\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442:\r\n\t-
    \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u043B\u0438
    \u0432\u044B \u043D\u0430 \u043D\u0443\u0436\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435?\r\n\t-
    \u0411\u044B\u043B\u043E \u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438?\n\r\n\t\u0415\u0441\u043B\u0438
    \u043E\u0431\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B
    \u2014 \u0448\u0430\u0433 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043D. \u0412\u044B
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443."
