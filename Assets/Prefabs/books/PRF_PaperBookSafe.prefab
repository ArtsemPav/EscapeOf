  m_text: "\t\u041C\u0435\u0434\u0432\u0435\u0436\u0430\u0442\u043D\u0438\u043A,
    \u0447\u0442\u043E \u0441\u043F\u0435\u0448\u0438\u0442, \u2014 \u043C\u0451\u0440\u0442\u0432\u044B\u0439
    \u043C\u0435\u0434\u0432\u0435\u0436\u0430\u0442\u043D\u0438\u043A. \u0421\u0435\u0439\u0444
    \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u0441\u0443\u0435\u0442\u044B.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0431\u0440\u043E\u0441 \u2014 \u043D\u0435
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u0430 \u0443\u0440\u043E\u043A.
    \u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0440\u0430\u0437\u043E\u043C \u0442\u044B
    \u0441\u043B\u044B\u0448\u0438\u0448\u044C \u043B\u0443\u0447\u0448\u0435. \u0421
    \u043A\u0430\u0436\u0434\u044B\u043C \u0440\u0430\u0437\u043E\u043C \u0440\u0443\u043A\u0430
    \u0442\u0432\u043E\u044F \u0442\u0432\u0451\u0440\u0436\u0435.\r\n\t\u0418 \u043A\u043E\u0433\u0434\u0430
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437
    \u0449\u0451\u043B\u043A\u043D\u0435\u0442 \u0437\u0430\u043C\u043E\u043A \u0438
    \u0434\u0432\u0435\u0440\u0446\u0430 \u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F
    \u2014 \u0442\u044B \u043F\u043E\u0439\u043C\u0451\u0448\u044C, \u0447\u0442\u043E
    \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u043D\u0435 \u0441\u0435\u0439\u0444.
    \n\t\u0422\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0441\u0435\u0431\u044F."
