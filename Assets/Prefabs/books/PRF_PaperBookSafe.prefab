--- !u!114 &3971979729676591412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3539544152559270770}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434:
    \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439\r\n\t\u041D\u0430\u0447\u043D\u0438\u0442\u0435
    \u0432\u0440\u0430\u0449\u0430\u0442\u044C \u0434\u0438\u0441\u043A \u043F\u043E
    \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435.
    \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
    \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435.\r\n\t\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u0448\u0430\u0433\u043E\u0432 \u0437\u0432\u0443\u0447\u0430\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
    - \u0440\u043E\u0432\u043D\u044B\u0435, \u0441\u0443\u0445\u0438\u0435 \u0449\u0435\u043B\u0447\u043A\u0438.
    \u041D\u043E \u0433\u0434\u0435-\u0442\u043E \u043D\u0430 \u043A\u0440\u0443\u0433\u0435
    \u0440\u0430\u0437\u0434\u0430\u0441\u0442\u0441\u044F \u0434\u0440\u0443\u0433\u043E\u0439
    \u0437\u0432\u0443\u043A. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439.
    \u0422\u043E\u0442 \u0441\u0430\u043C\u044B\u0439. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
    \u0447\u0438\u0441\u043B\u043E, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043E\u043D \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B.\r\n\t\u0415\u0441\u043B\u0438
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0433\u043E \u0449\u0435\u043B\u0447\u043A\u0430
    \u043D\u0435\u0442 \u2014 \u0437\u043D\u0430\u0447\u0438\u0442, \u043D\u0430
    \u044D\u0442\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430
    \u043D\u0435\u0442. \u041D\u043E \u043E\u043D\u043E \u0431\u0443\u0434\u0435\u0442.
    \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C.\r\n\t\u0412\u0442\u043E\u0440\u043E\u0439
    \u043F\u0440\u043E\u0445\u043E\u0434: \u043F\u0440\u043E\u0442\u0438\u0432 \u0447\u0430\u0441\u043E\u0432\u043E\u0439\r\n\t\u0422\u0435\u043F\u0435\u0440\u044C
    \u043D\u0430\u0447\u043D\u0438\u0442\u0435 \u0432\u0440\u0430\u0449\u0430\u0442\u044C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0447\u0430\u0441\u043E\u0432\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u0438. \u0421\u043D\u043E\u0432\u0430 \u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435.
    \u0421\u043D\u043E\u0432\u0430 \u0438\u0449\u0438\u0442\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
    \u0449\u0435\u043B\u0447\u043E\u043A. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
    \u0447\u0438\u0441\u043B\u043E, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043E\u043D \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B.\r\n\t\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \u043A \u043D\u0430\u0447\u0430\u043B\u0443. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
    \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E
    \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430. \u0428\u0430\u0433
    \u0437\u0430 \u0448\u0430\u0433\u043E\u043C. \u0429\u0435\u043B\u0447\u043E\u043A
    \u0437\u0430 \u0449\u0435\u043B\u0447\u043A\u043E\u043C. \u041F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0439\u0442\u0435\u0441\u044C
    \u043A \u0442\u043E\u043C\u0443 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E,
    \u0433\u0434\u0435 \u0432\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
    \u0437\u0432\u0443\u043A.\r\n\t\u0415\u0441\u043B\u0438 \u0432\u044B \u043D\u0430\u0448\u043B\u0438
    \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u0449\u0435\u043B\u0447\u043E\u043A
    \u2014 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F \u0432\u0435\u0440\u043D\u0430.
    \u041E\u0442\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435 \u0437\u0430\u043C\u043E\u043A.\n\t\u0418
    \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435 \u043F\u043E\u043A\u0430
    \u0441\u0435\u0439\u0444 \u043D\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
