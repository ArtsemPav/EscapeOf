--- !u!114 &1700331062126603185
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2152746693506807017}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\u041E\u0448\u0438\u0431\u043A\u0430 \u2014 \u044D\u0442\u043E \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E. \u042D\u0442\u043E \u0438 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u043A\u0430
    \u0432 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
    \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u0438.\r\n\r\n\u0415\u0441\u043B\u0438
    \u0432\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C:\r\n\t- \u0414\u0438\u0441\u043A
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0434\u0432\u0430 \u043F\u043E\u043B\u043D\u044B\u0445
    \u043E\u0431\u043E\u0440\u043E\u0442\u0430 \u0438 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044E 0.\r\n\t- \u0412\u0435\u0441\u044C
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438
    \u043E\u0431\u043D\u0443\u043B\u044F\u0435\u0442\u0441\u044F.\r\n\t- \u0412\u044B
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u2014 \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430,
    \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430,
    \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\r\n\r\n\t\u041E\u0448\u0438\u0431\u043A\u0430
    \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u0448\u0430\u0433\u0435 \u2014 \u0431\u0443\u0434\u044C
    \u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u0438\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u2014 \u0441\u0442\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0451. \u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F
    \u0432\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0439
    \u043E\u0448\u0438\u0431\u043A\u0438, \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u0430
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430."
  m_isRightToLeft: 0
