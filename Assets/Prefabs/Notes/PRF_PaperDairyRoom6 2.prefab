    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "                                                           \u0418\u0437
        \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0421\u0442\u0435\u0444\u0430\u043D\u0438\u0438
        \u042D\u0439\u043B\u0438\u0440\n\t<b>***</b>\n\t\u041F\u043E\u0441\u043B\u0435
        \u043D\u043E\u0432\u043E\u0433\u043E \u0443\u043A\u043E\u043B\u0430 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
        \u0441\u0442\u0430\u043B\u0430 \u0442\u0435\u0441\u043D\u0435\u0435. \u041D\u0435
        \u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u043E\u0433\u043D\u0443\u0442\u044C
        \u0440\u0443\u043A\u0438.\r\n\t\u0417\u0430\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
        \u0432\u0438\u0436\u0443 \u0434\u0432\u0435\u0440\u044C. \u041E\u043D\u0430
        \u0434\u0430\u043B\u0435\u043A\u043E, \u0437\u0430 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0439
        \u0441\u0442\u0435\u043D\u043A\u043E\u0439. \u041F\u043E\u0434 \u043D\u0435\u0439
        \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430.\r\n\t\u0414\u043E\u043A\u0442\u043E\u0440
        \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442, \u043C\u043E\u0433\u0443
        \u043B\u0438 \u044F \u0442\u0443\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.\r\n\t\u042F
        \u0435\u0449\u0451 \u0434\u0430\u0436\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C
        \u043E\u0442\u0441\u044E\u0434\u0430.\r\n\r\n\t<b>***</b> \r\n\t\u041B\u0435\u0441
        \u0441\u0442\u0430\u043B \u0433\u0440\u043E\u043C\u0447\u0435. \u041E\u0434\u0438\u043D
        \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0432\u0441\u043F\u043B\u0435\u0441\u043A,
        \u0441\u0442\u0440\u0435\u043A\u043E\u0442, \u043F\u0430\u0443\u0437\u0430.\r\n\t\u0417\u0430
        \u0434\u0432\u0435\u0440\u044C\u044E \u0442\u043E\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E
        \u0441\u043B\u044B\u0448\u043D\u043E.\r\n\t\u041D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0441\u044F.\r\n\r\n\t<b>***</b>\r\n\t\u0421\u0435\u0433\u043E\u0434\u043D\u044F
        \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
        \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0440\u044B\u043B\u043E.\r\n\t\u0417\u043D\u0430\u044E,
        \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0433\u043E \u043D\u0435\u0442
        \u2013 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430 \u0440\u0443\u043A\u043E\u0439,
        \u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0433\u043B\u0430 \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F.\r\n\t\u041D\u043E
        \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.\r\n\r\n\t<b>***</b>\r\n\t\u041C\u043E\u0440\u0440\u043E
        \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C
        \u043C\u043D\u0435 \u0432\u044B\u0439\u0442\u0438.\r\n\t\u041D\u0443\u0436\u043D\u043E
        \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C, \u043A\u0443\u0434\u0430.\r\n\t\u041F\u043E\u0447\u0435\u043C\u0443
        \u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430?\r\n\r\n\t<b>***</b>\r\n\t\u042F
        \u0432\u0441\u0451 \u0435\u0449\u0451 \u0445\u043E\u0447\u0443 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0434\u0432\u0435\u0440\u044C.\r\n\t\u0422\u043E\u043B\u044C\u043A\u043E
        \u043F\u0443\u0441\u0442\u044C \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0441 \u044D\u0442\u043E\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B.\r\n"
      objectReference: {fileID: 0}
