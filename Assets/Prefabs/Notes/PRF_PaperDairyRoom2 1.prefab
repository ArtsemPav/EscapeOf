--- !u!114 &8961362730243468445
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6433008227041686786}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t<b>15 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\r\n\t\u041F\u0440\u043E\u0447\u043B\u0430
    \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C.
    \u041C\u0430\u043C\u0430 \u0443\u043C\u0435\u0440\u043B\u0430 \u043C\u043D\u043E\u0433\u043E
    \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u041D\u0443\u0436\u043D\u043E
    \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u041A\u043B\u0430\u0440\u0443
    \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u044D\u0442\u043E\u0433\u043E
    \u0434\u0435\u0432\u043E\u0447\u043A\u0435. \u041D\u0435 \u043D\u0443\u0436\u043D\u043E
    \u0435\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C.
    \r\n\t\u2026\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u041A\u043B\u0430\u0440\u0435
    \u043E Cirque du Soleil. \u041E\u043D\u0430 \u0442\u0430\u043A \u0441\u043B\u0443\u0448\u0430\u043B\u0430,
    \u0447\u0442\u043E \u044F \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0430 \u0435\u0439
    \u0431\u0438\u043B\u0435\u0442 \u043D\u0430 \u0444\u0435\u0432\u0440\u0430\u043B\u044C\u0441\u043A\u0443\u044E
    \u043F\u0440\u0435\u043C\u044C\u0435\u0440\u0443. \u041F\u0440\u0438\u044F\u0442\u043D\u043E
    \u0445\u043E\u0442\u044C \u0440\u0430\u0437 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C \u0447\u0442\u043E-\u0442\u043E, \u043D\u0435
    \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0435 \u0441 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E.\r\n\r\n\t<b>18
    \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\r\n\t\u0421\u043D\u043E\u0432\u0430
    \u0441\u043D\u0438\u043B\u0430\u0441\u044C \u0434\u043E\u043B\u0438\u043D\u0430.
    \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043F\u0438\u0441\u0430\u043B\u0430
    \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E: \u0442\u0430\u043C \u0431\u044B\u043B
    \u0441\u0430\u0434. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0430\u043C \u0445\u043E\u0434\u044F\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0439.\r\n\t\u0420\u0438\u0441\u0443\u044E
    \u0438\u0445 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u044F.
    \u041D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0438\u0445 \u0432 \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u0445. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0432\u043E \u0441\u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E:
    \u0432\u0447\u0435\u0440\u0430 \u044F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0430
    \u0434\u043E\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u0435\u043C\u0443
    \u0440\u0443\u043A\u0438.\r\n\t\u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B
    \u043C\u043D\u0435, \u0433\u0434\u0435 \u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u0442\u044C.\r\n\r\n\r\n"
  m_isRightToLeft: 0
