    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "   <b>3 \u0438\u044E\u043D\u044F </b>\n   \n\n   \u0412\u0447\u0435\u0440\u0430
        \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0432\u0451\u043B \u0441\u0435\u0431\u0435
        \xAB\u0413\u0440\u0430\u043D\u044C\xBB. \u041C\u044B\u0441\u043B\u0438 \u0441\u0442\u0430\u043B\u0438
        \u044F\u0441\u043D\u0435\u0435. \u0417\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C
        \u044F \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E
        \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432 \u0444\u043E\u0440\u043C\u0443\u043B\u0435.\n  
        \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
        \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0431\u044B\u043B\u043E\n\u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.\n  
        \u041D\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u043C \u043C\u043E\u0437\u0433\u0435
        \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
        \u0438\u043D\u0430\u0447\u0435. \u042F \u0431\u044B\u043B \u043F\u0440\u0430\u0432.\n\n                                
        \u0420.\u041C\u043E\u0440\u0440\u043E"
