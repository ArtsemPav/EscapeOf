      value: PRF_NoteNurceryRoom 3
      objectReference: {fileID: 0}
    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "<b>\u0417\u0435\u043B\u0435\u043D\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u0438\u043D</b>,
        \u0432\u0435\u0442\u0432\u044F\u043C\u0438 \u0432\u044B\u0441\u044C \u043E\u0431\u044A\u044F\u0432,\n\n\u0420\u043E\u0436\u0434\u0430\u0435\u0442
        <b>\u0438\u0441\u043A\u0440\u0443</b> \u0432 \u0448\u0435\u043B\u0435\u0441\u0442\u0435
        <b>\u0434\u0443\u0431\u0440\u0430\u0432</b>.\n\n\u0410 \u0438\u0437 <b>\u043A\u043E\u0441\u0442\u0440\u0430</b>,
        \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0433\u043E \u0434\u043E\u0442\u043B\u0430,\n\n\u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
        <b>\u043F\u0440\u0430\u0445</b>, \u0447\u044C\u044F \u0442\u043E\u043B\u0449\u0430
        \u0442\u044F\u0436\u0435\u043B\u0430.\n\n\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0430\u0445
        <b>\u043D\u0435\u0434\u0440</b> \u0442\u0430\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u044B\u0439
        <b>\u0449\u0438\u0442</b>,\n\n\u0410 <b>\u0441\u0442\u0430\u043B\u044C</b>
        \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F <b>\u0441\u043B\u0435\u0437\u043E\u044E</b>
        \u0432\u043E\u0437\u043E\u043C\u043D\u0438\u0442\n\n\u0421\u0435\u0431\u044F,
        \u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0442\u0430\u0435\u0442.
        \u042D\u0442\u0430 <b>\u0433\u043B\u0430\u0434\u044C</b>\n\n\u041F\u043E\u043C\u043E\u0436\u0435\u0442
        <b>\u0432\u0435\u043B\u0438\u043A\u0430\u043D\u0443</b> \u0441\u043D\u043E\u0432\u0430
        \u0432\u0441\u0442\u0430\u0442\u044C."
      objectReference: {fileID: 0}
