  m_text: "- W - \u0432\u043F\u0435\u0440\u0435\u0434\n- S - \u043D\u0430\u0437\u0430\u0434\n-
    A - \u0432\u043B\u0435\u0432\u043E \n- D - \u0432\u043F\u0440\u0430\u0432\u043E\n-
    Tab - \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\n-\u041F\u0440\u043E\u0431\u0435\u043B
    - \u041F\u0440\u044B\u0436\u043E\u043A\n- F - \u0412\u041A\u043B/ \u0412\u044B\u043A\u043B
    \u0444\u043E\u043D\u0430\u0440\u0438\u043A\n- Left Ctrl - \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C\n-
    Esc - \u043F\u0430\u0443\u0437\u0430/ \u0432\u044B\u0445\u043E\u0434 \u0438\u0437
    \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A, \u0438\u043D\u0432\u0435\u0442\u0430\u0440\u044F
    \u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432,
    \u0447\u0442\u0435\u043D\u0438\u044F \u043A\u043D\u0438\u0433\n- \u041B\u041A\u041C
    - \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438/ \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438"
