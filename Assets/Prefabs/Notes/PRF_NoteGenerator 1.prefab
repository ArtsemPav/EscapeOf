      objectReference: {fileID: 0}
    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "   \u041C\u043E\u0439 \u0434\u0435\u0434, \u0431\u044B\u0432\u0430\u043B\u043E,
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \u201C\u0412\u044B\u043F\u044C\u0435\u0448\u044C
        \u043D\u0435 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u2014
        \u0442\u0440\u044F\u0445\u043D\u0451\u0442, \u043A\u0430\u043A \u0442\u043E\u043A\u043E\u043C\u201D.
        \n   \u0418 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u0438\u043B
        \u0431\u0443\u0442\u044B\u043B\u043A\u0438 \u0432 \u0440\u044F\u0434: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
        \u043B\u0451\u0433\u043A\u0438\u0435, \u043F\u043E\u0442\u043E\u043C \u0437\u043B\u044B\u0435.
        \u041F\u0443\u0441\u0442\u044B\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043B
        \u2014 \u0431\u043E\u043B\u044C\u043D\u043E  \u044D\u0442\u0438\u043A\u0435\u0442\u043A\u0438
        \u044F\u0440\u043A\u0438\u0435, \u0440\u0443\u043A\u0430 \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C.
        \n   \u041C\u044B \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C, \u0430
        \u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u044B \u043A\u0440\u0443\u0442\u0438\u043B.
        \n   \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u043E\u0442 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B
        \u2014 \u0438 \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F, \u0447\u0442\u043E
        \u043E\u043D \u0438\u043C\u0435\u043B \u0432 \u0432\u0438\u0434\u0443?"
      objectReference: {fileID: 0}
