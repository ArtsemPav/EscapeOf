    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "   \u041F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
        \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C \u0421\u0442\u0435\u0444\u0430\u043D\u0438\u0438
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B \u0441\u043F\u043E\u0440\u0438\u043B
        \u0441 \u041C\u043E\u0440\u0440\u043E. \u042F \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0430
        \u0438\u0445 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F
        \u0435\u043C\u0443 \u0435\u0449\u0451 \u0440\u0430\u0437.\r\n   \u0427\u0435\u0440\u0435\u0437
        \u0447\u0430\u0441 \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C
        \u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430
        \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C.\r\n   \u042F \u0432\u0441\u0451
        \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E, \u0447\u0442\u043E \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
        \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C.
        \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u043C\u0435\u043D\u043D\u043E
        \u044F \u0443\u0431\u0435\u0436\u0434\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C.\n\n                                 
        \u041A. \u0412\u0435\u0439\u043D"
