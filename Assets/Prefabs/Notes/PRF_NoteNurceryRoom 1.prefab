    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "   \u0414\u043E\u043A\u0442\u043E\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
        \u043C\u043D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
        \u2014 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0442\u044C
        \u043F\u043E\u0440\u044F\u0434\u043E\u043A: \u0442\u0435\u043F\u043B\u043E
        \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0430\u0435\u0442 \u0441\u043E\u0441\u0442\u0430\u0432,
        \u043D\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E
        \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C. \u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u043E\u0435
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0435\u0449\u0451
        \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C.\n  
        \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u043B \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C
        \u0432\u043D\u0435\u0448\u043D\u0435\u043C\u0443 \u0432\u0438\u0434\u0443.
        \u0414\u0430\u0436\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
        \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0449\u0430\u044F \u0441\u043C\u0435\u0441\u044C
        \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
        \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439. \u041F\u0440\u0435\u0436\u0434\u0435
        \u0447\u0435\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0435\u0451, \u044F \u0434\u043E\u043B\u0436\u043D\u0430 \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F,
        \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0438\u043C\u0435\u043D\u043D\u043E
        \xAB\u0413\u0440\u0430\u043D\u044C\xBB.\n\n   \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
        \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432
        \u044F \u0441\u043C\u043E\u0433\u0443. \u041D\u043E \u043A\u0442\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442,
        \u0447\u0442\u043E \u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435
        \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0432\u0432\u043E\u0434\u0438\u0442\u044C?\n\n                                   
        <b>\u041A. \u0412\u0435\u0439\u043D</b>"
