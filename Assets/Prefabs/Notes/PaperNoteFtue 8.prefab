    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "\u0414\u0432\u0435\u0440\u044C. \u0417\u0430\u043A\u0440\u044B\u0442\u0430.
        \u0420\u0443\u0447\u043A\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u0430.
        \u041A\u0442\u043E \u0435\u0451 \u0441\u043B\u043E\u043C\u0430\u043B? \u041D\u0435\u0432\u0430\u0436\u043D\u043E.
        \u041D\u0435\u0432\u0430\u0436\u043D\u043E.\r\n\r\n\u041E\u0442\u0432\u0435\u0440\u0442\u043A\u0430.
        \u041D\u0443\u0436\u043D\u0430 \u043E\u0442\u0432\u0435\u0440\u0442\u043A\u0430.\r\n\r\n\u0416\u043C\u0438
        \u041B\u041A\u041C. \u0422\u044F\u043D\u0438. \u041F\u0440\u043E\u0431\u0435\u043B.
        \u041F\u043E\u043F\u0430\u0434\u0430\u0439 \u0432 \u0437\u043E\u043D\u0443.
        \u0412 \u0431\u0435\u043B\u0443\u044E. \u0412 \u0437\u0435\u043B\u0451\u043D\u0443\u044E.\r\n\r\n\u041F\u0440\u043E\u043C\u0430\u0445\u043D\u0451\u0448\u044C\u0441\u044F
        \u2014 \u0438 \u044F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0437\u0434\u0435\u0441\u044C.\r\n\r\n\u042F
        \u043D\u0435 \u0445\u043E\u0447\u0443 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
        \u0437\u0434\u0435\u0441\u044C.\r\n\r\n\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
