    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "                                                             \u0418\u0437
        \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0410\u043D\u043D\u044B
        \u041F\u0438\u0440\u0441\r\n\n\t<b>***</b>\r\n\t\u2026\u0421\u043D\u0430\u0447\u0430\u043B\u0430
        \u044F \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0447\u0438\u0441\u043B\u0430.\r\n\t\u2014
        2, 3, 5, 7, 11, 13,\u2026\r\n\t\u041A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
        \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u043F\u0430\u0443\u0437\u044B.
        \u0416\u0434\u0430\u043B \u043C\u0435\u043D\u044F.\r\n\t\u2014 \u202617,
        19, 23,...\r\n\t\u041E\u0442\u043A\u0440\u044B\u043B\u0430 \u0433\u043B\u0430\u0437\u0430.
        \u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0443 \u043A\u0440\u043E\u0432\u0430\u0442\u0438
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F
        \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C \u041C\u043E\u0440\u0440\u043E.
        \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u0435\u0433\u043E
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C. \u041F\u043E\u043A\u0430
        \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u043B, \u044F \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0430
        \u043A\u0440\u0430\u0439 \u043E\u0434\u0435\u044F\u043B\u0430, \u0434\u0432\u0435\u0440\u043D\u043E\u0439
        \u043F\u0440\u043E\u0451\u043C, \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
        \u0440\u0443\u043A\u0438.\r\n\r\n\t<b>***</b>\r\n\t\u2026\u041F\u043E\u043A\u0430
        \u044F \u0431\u044B\u043B\u0430 \u043D\u0435 \u0437\u0434\u0435\u0441\u044C,
        \u044F \u0448\u043B\u0430 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443.\r\n\t\u0422\u0430\u043C
        \u0442\u0435\u043F\u043B\u043E. \u0421\u0432\u0435\u0442 \u0442\u0430\u043A\u043E\u0439,
        \u0431\u0443\u0434\u0442\u043E \u0437\u0430 \u043E\u043A\u043D\u0430\u043C\u0438
        \u043B\u0435\u0442\u043D\u0438\u0439 \u0434\u0435\u043D\u044C, \u0445\u043E\u0442\u044F
        \u0441\u0430\u043C\u0438\u0445 \u043E\u043A\u043E\u043D \u044F \u043D\u0435
        \u043F\u043E\u043C\u043D\u044E. \u0417\u043E\u043B\u043E\u0442\u044B\u0435
        \u043F\u044B\u043B\u0438\u043D\u043A\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
        \u043A\u0440\u0443\u0436\u0430\u0442\u0441\u044F. \u041C\u043E\u0436\u043D\u043E
        \u0441\u0435\u0441\u0442\u044C \u0443 \u0441\u0442\u0435\u043D\u044B, \u0437\u0430\u043A\u0440\u044B\u0442\u044C
        \u0433\u043B\u0430\u0437\u0430. \u0412\u043F\u0435\u0440\u0432\u044B\u0435
        \u0437\u0430 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043C\u043D\u0435
        \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E
        \u0441\u0447\u0438\u0442\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
        \u0441\u0442\u0430\u043B\u043E \u0442\u0438\u0445\u043E.\r\n\t\u0418 \u0432\u0441\u0451
        \u0436\u0435 \u2013 \u044F \u043D\u0435 \u0441\u0430\u0436\u0443\u0441\u044C.
        \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0442\u043E\u0438\u0442
        \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0443\u0434\u043E\u0431\u043D\u0435\u0435,
        \u0438 \u044F \u0437\u0430\u0431\u0443\u0434\u0443, \u0437\u0430\u0447\u0435\u043C
        \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C.\r\n\r\n\t<b>***</b>\r\n\t\u0412\u043E
        \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u0440\u043E\u0441\u0442\u044B\u0435
        \u0447\u0438\u0441\u043B\u0430 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u0438.
        \u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0433\u043E\u043B\u043E\u0441
        \u0434\u043E\u043A\u0442\u043E\u0440\u0430, \u043D\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0430,
        \u043A\u0430\u043A \u0434\u043E \u043D\u0435\u0433\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.
        \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u043D\u0430\u0447\u0430\u043B
        \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u044F\u0434.\r\n\t1, 1, 2, 3,
        5, 8\u2026\r\n\t\u042F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435. \u0417\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
        \u0437\u0430 \u044D\u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435\u2026\r\n\t\u041F\u043E\u0441\u043B\u0435
        \u043C\u044B \u0434\u043E\u043B\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438.
        \u0414\u043E\u043A\u0442\u043E\u0440 \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
        \r\n\t\u042F \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0435\u043C\u0443,
        \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435\u043C
        \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 \u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430
        \u0434\u0432\u0435\u0440\u044C. \u041D\u0435 \u0442\u0430, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u0439
        \u044F \u0448\u043B\u0430. \u041F\u043E\u0437\u0430\u0434\u0438 \u043C\u0435\u043D\u044F.\r\n\r\n\t<b>***</b>\r\n\t\u0422\u0435\u043F\u0435\u0440\u044C
        \u041E\u043D \u0442\u0430\u043C. \u042F \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430,
        \u043A\u0430\u043A \u041E\u043D \u0432\u043E\u0448\u0451\u043B. \u041F\u0440\u043E\u0441\u0442\u043E
        \u043C\u0435\u0436\u0434\u0443 \u043B\u043E\u043F\u0430\u0442\u043A\u0430\u043C\u0438
        \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u043B \u0445\u043E\u043B\u043E\u0434\u043E\u043A.
        \u0421\u0432\u0435\u0442 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u044B\u0439.
        \u041D\u043E \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E
        \u0445\u0443\u0436\u0435.\r\n\t\u042F \u0438\u0434\u0443 \u043A \u0434\u0432\u0435\u0440\u0438.
        \u0421\u0447\u0438\u0442\u0430\u044E \u0448\u0430\u0433\u0438. \u0420\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
        \u043D\u0435 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F.\r\n\t\u041D\u0435\u043B\u044C\u0437\u044F
        \u0438\u0434\u0442\u0438 \u043D\u0430\u0443\u0433\u0430\u0434! \u0423 \u044D\u0442\u043E\u0433\u043E
        \u043C\u0435\u0441\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
        \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C.\r\n\r\n"
