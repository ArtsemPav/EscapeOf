    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "\u041D\u0435 \u043A\u0430\u0436\u0434\u0430\u044F \u0434\u0432\u0435\u0440\u044C
        \u043E\u0442\u043A\u0440\u044B\u0442\u0430\n\u041D\u0435 \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0439
