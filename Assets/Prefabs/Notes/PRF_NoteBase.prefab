  m_text: "\u0415\u0449\u0451 \u0440\u0430\u0437: \u0447\u0442\u043E\u0431\u044B
    \u0432\u0437\u044F\u0442\u044C \u0438\u043B\u0438 \n\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430\u0436\u043C\u0438 <sprite
    name=\"LMB\">.\n\n\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u043B\u0430\u0446\u0430\u0439
