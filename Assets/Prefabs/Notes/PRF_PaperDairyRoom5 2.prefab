    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "                                                           \u0418\u0437
        \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0410\u0440\u0438\u0430\u0434\u043D\u044B
        \u0411\u0430\u0440\u0440\u0435\u0442\n\t<b>***</b>\n\t\u2026\u0421\u0440\u0435\u0434\u0438
        \u0441\u0435\u0440\u044B\u0445 \u0441\u0442\u0435\u043D \u0441\u043B\u044B\u0448\u043D\u044B
        \u0448\u0430\u0433\u0438. \u041A\u0442\u043E-\u0442\u043E \u0448\u0451\u043B
        \u043C\u043D\u0435 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443.\r\n\t\u042F
        \u043F\u043E\u0437\u0432\u0430\u043B\u0430.\r\n\t\u0428\u0430\u0433\u0438
        \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.\r\n\t\u0413\u043E\u043B\u043E\u0441
        \u041C\u043E\u0440\u0440\u043E \u0431\u044B\u043B \u0441\u043E\u0432\u0441\u0435\u043C
        \u0440\u044F\u0434\u043E\u043C, \u043D\u043E \u0434\u043E\u043D\u043E\u0441\u0438\u043B\u0441\u044F
        \u0441\u0432\u0435\u0440\u0445\u0443.\n\n\t<b>***</b>\r\n\t\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u0430\u043B\u043E.\r\n\t\u042F
        \u0437\u043D\u0430\u044E. \u041D\u043E \u0435\u0441\u043B\u0438 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F,
        - \u0432\u0441\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
        \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C\u0438.\r\n\r\n\t<b>***</b>\r\n\t\u041D\u0438\u0442\u044C
        \u0435\u0449\u0451 \u0441\u043E \u043C\u043D\u043E\u0439. \u0417\u0430\u0436\u0438\u043C\u0430\u044E
        \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438.\r\n\t\u0421
        \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430
        \u0442\u044F\u043D\u0443\u0442.\r\n\t\u0425\u043E\u0442\u0435\u043B\u0430
        \u043A\u0440\u0438\u043A\u043D\u0443\u0442\u044C: \r\n\t\u2013 \u041D\u0435
        \u0442\u044F\u043D\u0438! \u041E\u043D\u0430 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
        \u0437\u0430 \u0443\u0433\u043E\u043B. \u041D\u0443\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043E\u0441\u043B\u0430\u0431\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
        \u044F \u043C\u043E\u0433\u043B\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
        \u0435\u0451.\r\n\t\u041D\u043E \u043C\u043E\u0439 \u0433\u043E\u043B\u043E\u0441
        \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F \u0432 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0435\u0439
        \u0442\u044C\u043C\u0435.\r\n\r\n\t<b>***</b>\r\n\t\u0421\u0432\u0435\u0442
        \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432\u0438\u0434\u0435\u043D\u2026\r\n\t\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u043D\u0435 \u0442\u044F\u043D\u0438\u0442\u0435 \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E\u2026\r\n\r\n"
      objectReference: {fileID: 0}
