  m_text: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u2014 \u041C\u043B\u0430\u0434\u0435\u043D\u0435\u0446,<br>\u0416\u0451\u043B\u0442\u044B\u0439
    \u2014 \u042E\u043D\u0435\u0446,\n\u0421\u0438\u043D\u0438\u0439 \u0421\u0442\u0430\u0440\u0438\u043A
    \u2014 \u0432\u043E\u0442 \u0438 \u0436\u0438\u0437\u043D\u0438 \u043A\u043E\u043D\u0435\u0446.\n\u0410
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u2014 \u0417\u0440\u0435\u043B\u043E\u0441\u0442\u044C
