    - target: {fileID: 2318303281141391688, guid: 8b55f77619342fc4b8ab532cbf30fbe0, type: 3}
      propertyPath: m_text
      value: "\t\u041A\u043B\u044E\u0447 \u0441\u043E\u043A\u0440\u044B\u0442 \u0432
        \u0421\u043F\u0438\u0440\u0430\u043B\u0438 \u0416\u0438\u0437\u043D\u0438.
        \u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440 \u0432\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439
        \u043D\u0435 \u0441\u0442\u0440\u043E\u0438\u043B \u043F\u0440\u044F\u043C\u044B\u0445
        \u043B\u0438\u043D\u0438\u0439. \u041E\u043D \u0437\u0430\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u043B
        \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0443 \u043D\u0430\u0443\u0442\u0438\u043B\u0443\u0441\u0430,
        \u0441\u043E\u0441\u043D\u043E\u0432\u044B\u0435 \u0448\u0438\u0448\u043A\u0438
        \u0438 \u0434\u0430\u043B\u0435\u043A\u0438\u0435 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438
        \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0435\u0437\u044B\u0431\u043B\u0435\u043C\u043E\u043C\u0443
        \u0437\u0430\u043A\u043E\u043D\u0443 \u0440\u043E\u0441\u0442\u0430. \u0428\u0430\u0433\u043D\u0438
        \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443 (0), \u0441\u0442\u0430\u043D\u044C
        \u0435\u0434\u0438\u043D\u0438\u0446\u0435\u0439 (1), \u043F\u043E\u0432\u0442\u043E\u0440\u0438
        \u0441\u0435\u0431\u044F (1)... \n\t\u0430 \u0434\u0430\u043B\u044C\u0448\u0435
        \u043F\u0443\u0441\u0442\u044C \u043F\u0430\u043C\u044F\u0442\u044C \u043E
        \u0434\u0432\u0443\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
        \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u0445 \u0440\u043E\u0436\u0434\u0430\u0435\u0442
        \u0442\u0440\u0435\u0442\u044C\u044E"
