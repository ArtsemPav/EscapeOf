    - target: {fileID: 7877143702991089789, guid: c4c47bbdfadc94744b8baf15bf8b1d52, type: 3}
      propertyPath: m_text
      value: "   \n   <b>21 \u043D\u043E\u044F\u0431\u0440\u044F</b>\n\n   \u041C\u0438\u0441\u0442\u0435\u0440
        \u0421\u0443 \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430
        \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
        \u0447\u0430\u044F. \u041F\u043E\u0441\u043B\u0435 \u043C\u0435\u0441\u044F\u0446\u0430
        \u043A\u043E\u043C\u044B \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
        \u0447\u0430\u044F.\n   \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0447\u0430\u0441\u043E\u0432 \u043E\u043D \u0441\u043D\u043E\u0432\u0430
        \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435.
        \u041D\u043E \u041C\u043E\u0440\u0440\u043E \u0443\u0432\u0435\u0440\u0435\u043D:
        \u0435\u0441\u043B\u0438 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C
        \u0435\u0433\u043E \u043E\u0434\u043D\u0430\u0436\u0434\u044B, \u043C\u043E\u0436\u043D\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C.\n  
        \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
        \u043F\u043E\u0432\u0435\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u044E
        \u0432 \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435\n\u0441\u043E\u0432\u0435\u0440\u0448\u0430\u044E\u0442
        \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435.\n\n                                  
        \u041A.\u0412\u0435\u0439\u043D"
