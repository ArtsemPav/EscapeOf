      \u0434\u0430\u0436\u0435 \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C\n\u0418\u043B\u0438
      \u0437\u0430\u043B\u0435\u0437\u0442\u044C \u043F\u043E\u0434..."
  - key: note.ftuenote8.page0.1
    value: "\u041D\u0435 \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u043B\u0435\u0436\u0430\u0442\u044C
      \u043D\u0430 \u0432\u0438\u0434\u0443\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u0435\u0449\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u044B\n\n\u041D\u0435
      \u0431\u043E\u0439\u0441\u044F \u0437\u0430\u043F\u0430\u0447\u043A\u0430\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \n\u043D\u0430\u043C\u043E\u043A\u043D\u0443\u0442\u044C\n"
  - key: note.note_doctor_dairy_1.page0.0
    value: "   <b>\u0420\u0430\u0431\u043E\u0447\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430</b>\n\n  
      \u041D\u0443\u0436\u043D\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E
      \u0441\u043A\u0440\u044B\u0442\u043E \u0432 \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0439
      \u0441\u0443\u0441\u043F\u0435\u043D\u0437\u0438\u0438. \u041F\u0440\u0435\u0436\u0434\u0435
      \u0432\u0441\u0435\u0433\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0435\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438
      \u2014 \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0443\u044E
      \u0444\u0440\u0430\u043A\u0446\u0438\u044E \u043E\u0442 \u043F\u0440\u0438\u043C\u0435\u0441\u0435\u0439.\n  
      \u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u043D\u0451\u0441 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439\n\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B."
  - key: note.note_doctor_dairy_2.page0.0
    value: "   <b>\u041B\u0438\u0447\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C</b>\n\n  
      \u041C\u043D\u0435 \u0431\u044B\u043B\u043E \u0442\u0440\u0438\u043D\u0430\u0434\u0446\u0430\u0442\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u043C\u0430\u0442\u0435\u0440\u0438
      \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u0438\u043D\u0441\u0443\u043B\u044C\u0442.
      \u041D\u0435\u0434\u0435\u043B\u044E \u044F \u0441\u0438\u0434\u0435\u043B
      \u0443 \u0435\u0451 \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0438 \u043F\u0440\u043E\u0441\u0438\u043B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430.\n  
      \u0412\u0440\u0430\u0447\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C.
      \u041E\u0442\u0435\u0446 \u0441\u043A\u0430\u0437\u0430\u043B: \u043D\u0430
      \u0432\u0441\u0451 \u0432\u043E\u043B\u044F \u0411\u043E\u0436\u044C\u044F.\n  
      \u041C\u0430\u043C\u0430 \u0443\u0447\u0438\u043B\u0430, \u0447\u0442\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043E\u0434\u0438\u043D.\n   \u042F \u0441\u0442\u0430\u043B \u0432\u0440\u0430\u0447\u043E\u043C,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043D\u0435 \u0441\u043C\u043E\u0433
      \u0441 \u044D\u0442\u0438\u043C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F."
  - key: note.note_generator_1.page0.1
    value: "   \u041C\u043E\u0439 \u0434\u0435\u0434, \u0431\u044B\u0432\u0430\u043B\u043E,
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \u201C\u0412\u044B\u043F\u044C\u0435\u0448\u044C
      \u043D\u0435 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u2014
      \u0442\u0440\u044F\u0445\u043D\u0451\u0442, \u043A\u0430\u043A \u0442\u043E\u043A\u043E\u043C\u201D.
      \n   \u0418 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u0438\u043B
      \u0431\u0443\u0442\u044B\u043B\u043A\u0438 \u0432 \u0440\u044F\u0434: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043B\u0451\u0433\u043A\u0438\u0435, \u043F\u043E\u0442\u043E\u043C \u0437\u043B\u044B\u0435.
      \u041F\u0443\u0441\u0442\u044B\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043B
      \u2014 \u0431\u043E\u043B\u044C\u043D\u043E  \u044D\u0442\u0438\u043A\u0435\u0442\u043A\u0438
      \u044F\u0440\u043A\u0438\u0435, \u0440\u0443\u043A\u0430 \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C.
      \n   \u041C\u044B \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C, \u0430
      \u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u044B \u043A\u0440\u0443\u0442\u0438\u043B.
      \n   \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u043E\u0442 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B
      \u2014 \u0438 \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F, \u0447\u0442\u043E
      \u043E\u043D \u0438\u043C\u0435\u043B \u0432 \u0432\u0438\u0434\u0443?"
  - key: note.note_generator_2.page0.1
    value: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E! \n\u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0432\u0438\u0434\u0435\u0442\u044C
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0435!\n\n\u041E\u0442\u043A\u0440\u043E\u0439
      \u0438\u043D\u0432\u0435\u0442\u0430\u0440\u044C \u0438 \u0441\u043C\u0435\u043D\u0438
      \u0441\u0442\u0435\u043A\u043B\u043E \u043D\u0430 \u0444\u043E\u043D\u0430\u0440\u0435.\n\n\u041D\u0430\u0439\u0434\u0438
      \u0441\u043E\u043A\u0440\u044B\u0442\u044B\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
  - key: note.note_laboratory_1.page0.1
    value: "   <b>3 \u0438\u044E\u043D\u044F </b>\n   \n\n   \u0412\u0447\u0435\u0440\u0430
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0432\u0451\u043B \u0441\u0435\u0431\u0435
      \xAB\u0413\u0440\u0430\u043D\u044C\xBB. \u041C\u044B\u0441\u043B\u0438 \u0441\u0442\u0430\u043B\u0438
      \u044F\u0441\u043D\u0435\u0435. \u0417\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C
      \u044F \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432 \u0444\u043E\u0440\u043C\u0443\u043B\u0435.\n  
      \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0431\u044B\u043B\u043E\n\u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.\n  
      \u041D\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u043C \u043C\u043E\u0437\u0433\u0435
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0438\u043D\u0430\u0447\u0435. \u042F \u0431\u044B\u043B \u043F\u0440\u0430\u0432.\n\n                                
      \u0420.\u041C\u043E\u0440\u0440\u043E"
  - key: note.note_nurcery_room_1.page0.1
    value: "   \u0414\u043E\u043A\u0442\u043E\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043C\u043D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u2014 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0442\u044C
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A: \u0442\u0435\u043F\u043B\u043E
      \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0430\u0435\u0442 \u0441\u043E\u0441\u0442\u0430\u0432,
      \u043D\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E
      \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C. \u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u043E\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0435\u0449\u0451 \u043D\u0443\u0436\u043D\u043E
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C.\n   \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u043B
      \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0432\u043D\u0435\u0448\u043D\u0435\u043C\u0443
      \u0432\u0438\u0434\u0443. \u0414\u0430\u0436\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0449\u0430\u044F \u0441\u043C\u0435\u0441\u044C
      \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439. \u041F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0435\u0451, \u044F \u0434\u043E\u043B\u0436\u043D\u0430 \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0438\u043C\u0435\u043D\u043D\u043E
      \xAB\u0413\u0440\u0430\u043D\u044C\xBB.\n\n   \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432
      \u044F \u0441\u043C\u043E\u0433\u0443. \u041D\u043E \u043A\u0442\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442,
      \u0447\u0442\u043E \u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0432\u0432\u043E\u0434\u0438\u0442\u044C?\n\n                                   
      <b>\u041A. \u0412\u0435\u0439\u043D</b>"
  - key: note.note_nurcery_room_3.page0.1
    value: "<b>\u0417\u0435\u043B\u0435\u043D\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u0438\u043D</b>,
      \u0432\u0435\u0442\u0432\u044F\u043C\u0438 \u0432\u044B\u0441\u044C \u043E\u0431\u044A\u044F\u0432,\n\n\u0420\u043E\u0436\u0434\u0430\u0435\u0442
      <b>\u0438\u0441\u043A\u0440\u0443</b> \u0432 \u0448\u0435\u043B\u0435\u0441\u0442\u0435
      <b>\u0434\u0443\u0431\u0440\u0430\u0432</b>.\n\n\u0410 \u0438\u0437 <b>\u043A\u043E\u0441\u0442\u0440\u0430</b>,
      \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0433\u043E \u0434\u043E\u0442\u043B\u0430,\n\n\u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      <b>\u043F\u0440\u0430\u0445</b>, \u0447\u044C\u044F \u0442\u043E\u043B\u0449\u0430
      \u0442\u044F\u0436\u0435\u043B\u0430.\n\n\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0430\u0445
      <b>\u043D\u0435\u0434\u0440</b> \u0442\u0430\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u044B\u0439
      <b>\u0449\u0438\u0442</b>,\n\n\u0410 <b>\u0441\u0442\u0430\u043B\u044C</b>
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F <b>\u0441\u043B\u0435\u0437\u043E\u044E</b>
      \u0432\u043E\u0437\u043E\u043C\u043D\u0438\u0442\n\n\u0421\u0435\u0431\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0442\u0430\u0435\u0442.
      \u042D\u0442\u0430 <b>\u0433\u043B\u0430\u0434\u044C</b>\n\n\u041F\u043E\u043C\u043E\u0436\u0435\u0442
      <b>\u0432\u0435\u043B\u0438\u043A\u0430\u043D\u0443</b> \u0441\u043D\u043E\u0432\u0430
      \u0432\u0441\u0442\u0430\u0442\u044C."
  - key: note.note_nurcery_station_1.page0.1
    value: "   \n   <b>21 \u043D\u043E\u044F\u0431\u0440\u044F</b>\n\n   \u041C\u0438\u0441\u0442\u0435\u0440
      \u0421\u0443 \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0447\u0430\u044F. \u041F\u043E\u0441\u043B\u0435 \u043C\u0435\u0441\u044F\u0446\u0430
      \u043A\u043E\u043C\u044B \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u0447\u0430\u044F.\n   \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0447\u0430\u0441\u043E\u0432 \u043E\u043D \u0441\u043D\u043E\u0432\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435.
      \u041D\u043E \u041C\u043E\u0440\u0440\u043E \u0443\u0432\u0435\u0440\u0435\u043D:
      \u0435\u0441\u043B\u0438 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0435\u0433\u043E \u043E\u0434\u043D\u0430\u0436\u0434\u044B, \u043C\u043E\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C.\n  
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u043F\u043E\u0432\u0435\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u044E
      \u0432 \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435\n\u0441\u043E\u0432\u0435\u0440\u0448\u0430\u044E\u0442
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435.\n\n                                  
      \u041A.\u0412\u0435\u0439\u043D"
  - key: note.note_procedural_1.page0.1
    value: "   \n   <b>14 \u0438\u044E\u043D\u044F </b>\n\n   \u041F\u0435\u0440\u0435\u0434
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
      \u0421\u0442\u0435\u0444\u0430\u043D\u0438\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B
      \u0441\u043F\u043E\u0440\u0438\u043B \u0441 \u041C\u043E\u0440\u0440\u043E.
      \u042F \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0430 \u0438\u0445
      \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u0435\u043C\u0443
      \u0435\u0449\u0451 \u0440\u0430\u0437.\n   \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043E\u043D\u0430
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C.\n  
      \u042F \u0432\u0441\u0451 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E,
      \u0447\u0442\u043E \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0435\u0433\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C. \u041D\u043E
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u043C\u0435\u043D\u043D\u043E
      \u044F \u0443\u0431\u0435\u0436\u0434\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C.\n\n                                 
      \u041A. \u0412\u0435\u0439\u043D"
  - key: note.note_room2_1.page0.0
    value: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 1"
  - key: note.note_room2_1.page0.1
    value: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u2014 \u041C\u043B\u0430\u0434\u0435\u043D\u0435\u0446,<br>\u0416\u0451\u043B\u0442\u044B\u0439
      \u2014 \u042E\u043D\u0435\u0446,\n\u0421\u0438\u043D\u0438\u0439 \u0421\u0442\u0430\u0440\u0438\u043A
      \u2014 \u0432\u043E\u0442 \u0438 \u0436\u0438\u0437\u043D\u0438 \u043A\u043E\u043D\u0435\u0446.\n\u0410
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u2014 \u0417\u0440\u0435\u043B\u043E\u0441\u0442\u044C
      \u0440\u0430\u0441\u0442\u0451\u0442:\n\u0416\u0451\u043B\u0442\u044B\u0439
      \u043F\u043B\u044E\u0441 \u0421\u0438\u043D\u0438\u0439 - \u0417\u0435\u043B\u0451\u043D\u044B\u0439
      \u0434\u0430\u0451\u0442."
  - key: note.note_room3_1.page0.1
    value: "\t\n\n   \u041A\u043B\u044E\u0447 \u0441\u043E\u043A\u0440\u044B\u0442
      \u0432 \u0421\u043F\u0438\u0440\u0430\u043B\u0438 \u0416\u0438\u0437\u043D\u0438.
      \u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440 \u0432\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439
      \u043D\u0435 \u0441\u0442\u0440\u043E\u0438\u043B \u043F\u0440\u044F\u043C\u044B\u0445
      \u043B\u0438\u043D\u0438\u0439. \u041E\u043D \u0437\u0430\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u043B
      \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0443 \u043D\u0430\u0443\u0442\u0438\u043B\u0443\u0441\u0430,
      \u0441\u043E\u0441\u043D\u043E\u0432\u044B\u0435 \u0448\u0438\u0448\u043A\u0438
      \u0438 \u0434\u0430\u043B\u0435\u043A\u0438\u0435 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0435\u0437\u044B\u0431\u043B\u0435\u043C\u043E\u043C\u0443
      \u0437\u0430\u043A\u043E\u043D\u0443 \u0440\u043E\u0441\u0442\u0430. \n   \u0428\u0430\u0433\u043D\u0438
      \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443 (0), \u0441\u0442\u0430\u043D\u044C
      \u0435\u0434\u0438\u043D\u0438\u0446\u0435\u0439 (1), \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u0441\u0435\u0431\u044F (1)... \n   \u0430 \u0434\u0430\u043B\u044C\u0448\u0435
      \u043F\u0443\u0441\u0442\u044C \u043F\u0430\u043C\u044F\u0442\u044C \u043E
      \u0434\u0432\u0443\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u0445 \u0440\u043E\u0436\u0434\u0430\u0435\u0442
      \u0442\u0440\u0435\u0442\u044C\u044E"
  - key: note.note_room3_2.page0.1
    value: "   \n   <b>\u041F\u0430\u0446\u0438\u0435\u043D\u0442\u043A\u0430 \u21163
      </b>\n\n   \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0410\u043D\u043D\u0430
      \u043F\u043E\u0447\u0442\u0438 \u043A\u0440\u0438\u0447\u0430\u043B\u0430,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0441\u043E\u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0440\u0438\u0442\u043C\u044B \u0432\u0441\u0435\u0445\n\u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432
      \u0441\u0440\u0430\u0437\u0443.\n   \u041A\u043B\u0430\u0440\u0430 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0430\u0443\u0437\u0443.
      \u041E\u043D\u0430 \u0432\u0438\u0434\u0438\u0442 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0443.
      \u042F \u0432\u0438\u0436\u0443\n\u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u0431\u0430\u0440\u044C\u0435\u0440\u043E\u043C.\n   \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
      \u0434\u043E\u0437\u0443.\n   \u041E\u043D\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438,
      \u043D\u043E \u043D\u0435 \u0432\u0438\u0434\u044F\u0442 \u043E\u0431\u0449\u0435\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B.\n\n                                
      \u0420. \u041C\u043E\u0440\u0440\u043E"
  - key: note.note_room4_1.page0
    value: "\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0432\u0440\u0435\u043C\u044F...\n\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F...\n\u0422\u0440\u043E\u0435
      \u0435\u0441\u0442\u044C, \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0435\u0449\u0435
      \u043E\u0434\u0438\u043D ..."
  - key: note.note_room5_1.page0.0
    value: "\u0422\u0440\u0438 \u0433\u043B\u0430\u0432\u043D\u044B\u0445 \u0437\u0430\u043A\u043E\u043D\u0430
      \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0442\u043E\u043A\u0430"
  - key: note.note_room5_1.page0.1
    value: "   <b>\u041D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u044C
      \u0442\u043E\u043A\u0430</b>\n   \u042D\u043D\u0435\u0440\u0433\u0438\u044F
      \u0442\u0435\u0447\u0451\u0442 \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E
      \u0445\u043E\u0434\u0443 \u043D\u0430\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F
      \u0440\u0443\u043D\u044B \u2014 \u043E\u0442 \u0438\u0441\u0442\u043E\u043A\u0430
      \u043A \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044E. \u0417\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E
      \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0442\u044C \u043F\u043E\u0442\u043E\u043A,
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043A
      \u0443\u0436\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u043E\u043C\u0443
      \u0437\u0432\u0435\u043D\u0443 \u0438\u043B\u0438 \xAB\u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C\xBB
      \u043B\u0438\u043D\u0438\u044E \u0437\u0430\u0434\u043D\u0438\u043C \u0445\u043E\u0434\u043E\u043C.
      \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043C\u0430\u0433\u0438\u0438
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043F\u043E \u0441\u043F\u0438\u0440\u0430\u043B\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430.\n\n  
      <b>\u041F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u043D\u0438\u0439</b>\n  
      \u0420\u0443\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u044F\u0437\u044C
      \u043D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442 \u0443\u0433\u043B\u043E\u0432\u0430\u0442\u044B\u0445
      \u0438\u0437\u043B\u043E\u043C\u043E\u0432 \u0438 \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432. \u0412\u0441\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B
      \u043C\u0435\u0436\u0434\u0443 \u0440\u0443\u043D\u0430\u043C\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u043F\u043B\u0430\u0432\u043D\u044B\u043C\u0438,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0432\u044B\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u044B\u043C\u0438
      \u043E\u0434\u043D\u0438\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C
      \u043A\u0438\u0441\u0442\u0438. \u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0434\u043E\u043B\u0436\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0434\u0443\u0433\u0438,
      \u0431\u0435\u0437 \u043E\u0441\u0442\u0440\u044B\u0445 \xAB\u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439\xBB
      \u0438 \u0441\u043A\u0430\u0447\u043A\u043E\u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\n\n  
      <b>\u0421\u0430\u043A\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A</b>\n  
      \u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0431\u044F\u0437\u0430\u043D \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0440\u0443\u043D\u044B \u0438\u043C\u0435\u043D\u043D\u043E \u0432 \u0442\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435, \u0432 \u043A\u0430\u043A\u043E\u043C
      \u043E\u043D\u0438 \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u044B
      \u0441\u0432\u0438\u0442\u043A\u043E\u043C-\u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C.
      \u041D\u0438 \u043E\u0434\u043D\u0443 \u0440\u0443\u043D\u0443 \u043D\u0435\u043B\u044C\u0437\u044F
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0438\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0439
      \u2014 \u0438\u043D\u0430\u0447\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u0438\u043B\u0443.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u043E\u0433\u043E\u0435
      \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u0446\u0435\u043F\u043E\u0447\u043A\u0435
      \u0437\u043D\u0430\u043A\u043E\u0432 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044C \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0439
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u0440\u0443\u0433."
