  - key: note.dairy_room3_1.page0.1
    value: "    <b>***</b>\n    \u2026\u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u044F \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0447\u0438\u0441\u043B\u0430.\n\n   
      \u2014 2, 3, 5, 7, 11, 13,\u2026\n\n    \u041A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u043F\u0430\u0443\u0437\u044B.
      \u0416\u0434\u0430\u043B \u043C\u0435\u043D\u044F.\n\n    \u2014 \u202617,
      19, 23,...\n\n    \u041E\u0442\u043A\u0440\u044B\u043B\u0430 \u0433\u043B\u0430\u0437\u0430.
      \u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0443 \u043A\u0440\u043E\u0432\u0430\u0442\u0438
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C
      \u041C\u043E\u0440\u0440\u043E. \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0435\u0433\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u043B,
      \u044F \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0430
      \u043A\u0440\u0430\u0439 \u043E\u0434\u0435\u044F\u043B\u0430, \u0434\u0432\u0435\u0440\u043D\u043E\u0439
      \u043F\u0440\u043E\u0451\u043C, \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0440\u0443\u043A\u0438.\n\n    <b>***</b>\n    \u2026\u041F\u043E\u043A\u0430
      \u044F \u0431\u044B\u043B\u0430 \u043D\u0435 \u0437\u0434\u0435\u0441\u044C,
      \u044F \u0448\u043B\u0430 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443.\n   
      \u0422\u0430\u043C \u0442\u0435\u043F\u043B\u043E. \u0421\u0432\u0435\u0442
      \u0442\u0430\u043A\u043E\u0439, \u0431\u0443\u0434\u0442\u043E \u0437\u0430
      \u043E\u043A\u043D\u0430\u043C\u0438 \u043B\u0435\u0442\u043D\u0438\u0439 \u0434\u0435\u043D\u044C,
      \u0445\u043E\u0442\u044F \u0441\u0430\u043C\u0438\u0445 \u043E\u043A\u043E\u043D
      \u044F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E. \u0417\u043E\u043B\u043E\u0442\u044B\u0435
      \u043F\u044B\u043B\u0438\u043D\u043A\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043A\u0440\u0443\u0436\u0430\u0442\u0441\u044F. \u041C\u043E\u0436\u043D\u043E
      \u0441\u0435\u0441\u0442\u044C \u0443 \u0441\u0442\u0435\u043D\u044B, \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0433\u043B\u0430\u0437\u0430. \u0412\u043F\u0435\u0440\u0432\u044B\u0435
      \u0437\u0430 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043C\u043D\u0435
      \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0441\u0442\u0430\u043B\u043E \u0442\u0438\u0445\u043E.\n    \u0418 \u0432\u0441\u0451
      \u0436\u0435 \u2013 \u044F \u043D\u0435 \u0441\u0430\u0436\u0443\u0441\u044C.
      \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0442\u043E\u0438\u0442
      \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0443\u0434\u043E\u0431\u043D\u0435\u0435,
      \u0438 \u044F \u0437\u0430\u0431\u0443\u0434\u0443, \u0437\u0430\u0447\u0435\u043C
      \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C.\n\n    <b>***</b>\n    \u0412\u043E
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u0440\u043E\u0441\u0442\u044B\u0435
      \u0447\u0438\u0441\u043B\u0430 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u0438.
      \u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0433\u043E\u043B\u043E\u0441
      \u0434\u043E\u043A\u0442\u043E\u0440\u0430, \u043D\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0430,
      \u043A\u0430\u043A \u0434\u043E \u043D\u0435\u0433\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u043D\u0430\u0447\u0430\u043B
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u044F\u0434.\n\n    1, 1, 2, 3,
      5, 8\u2026\n\n    \u042F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435. \u0417\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
      \u0437\u0430 \u044D\u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435\u2026\n   
      \u041F\u043E\u0441\u043B\u0435 \u043C\u044B \u0434\u043E\u043B\u0433\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438. \u0414\u043E\u043A\u0442\u043E\u0440
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D. \n    \u042F \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430
      \u0435\u043C\u0443, \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 \u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430
      \u0434\u0432\u0435\u0440\u044C. \u041D\u0435 \u0442\u0430, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u044F \u0448\u043B\u0430. \u041F\u043E\u0437\u0430\u0434\u0438 \u043C\u0435\u043D\u044F.\n\n   
      <b>***</b>\n    \u0422\u0435\u043F\u0435\u0440\u044C \u041E\u043D \u0442\u0430\u043C.
      \u042F \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0430\u043A
      \u041E\u043D \u0432\u043E\u0448\u0451\u043B. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043C\u0435\u0436\u0434\u0443 \u043B\u043E\u043F\u0430\u0442\u043A\u0430\u043C\u0438
      \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u043B \u0445\u043E\u043B\u043E\u0434\u043E\u043A.
      \u0421\u0432\u0435\u0442 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u044B\u0439.
      \u041D\u043E \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0445\u0443\u0436\u0435.\n    \u042F \u0438\u0434\u0443 \u043A \u0434\u0432\u0435\u0440\u0438.
      \u0421\u0447\u0438\u0442\u0430\u044E \u0448\u0430\u0433\u0438. \u0420\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043D\u0435 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F.\n   
      \u041D\u0435\u043B\u044C\u0437\u044F \u0438\u0434\u0442\u0438 \u043D\u0430\u0443\u0433\u0430\u0434!
      \u0423 \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C."
  - key: note.dairy_room3_2.page0.1
    value: "    \n    <b>\u0422\u0440\u0435\u0442\u044C\u0435 \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435</b>\n   
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0424\u0438\u0431\u043E\u043D\u0430\u0447\u0447\u0438.
      \u041F\u043E\u0442\u043E\u043C \u0443\u0434\u0432\u043E\u0435\u043D\u0438\u0435:
      \n\n    1, 2, 4, 8\u2026 \n\n    \u041D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435.\n    \u0422\u0435\u043F\u0435\u0440\u044C
      \u044F \u0441\u043B\u044B\u0448\u0443 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043A\u0438 \u043C\u0435\u0436\u0434\u0443
      \u0447\u0438\u0441\u043B\u0430\u043C\u0438. \u0412 \u043D\u0438\u0445 \u2014
      \u0448\u0430\u0433\u0438.\n\n    <b>***</b>\n    \u0420\u0438\u0441\u0443\u044E
      \u0433\u043B\u0430\u0437\u0430. \u041F\u044B\u0442\u0430\u044E\u0441\u044C
      \u0432\u043E\u0441\u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043F\u0443\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u043F\u044B\u043B\u0438\u043D\u043E\u043A.
      \u041E\u043D\u0438 \u0434\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u043D\u0435
      \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u043E. \u0421\u043F\u0438\u0440\u0430\u043B\u044C
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u043E\u0442
      \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B, \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u2026\n    \u041D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434.\n\n    <b>***</b>\n    \u042F \u043F\u043E\u043C\u043D\u044E,
      \u043A\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0431\u044B\u043B\u043E
      \u0442\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u2026\n   
      \u042D\u0442\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435 \u0448\u0430\u0433\u043E\u0432\u2026\n\n   
      <b>***</b>\n    \u0414\u043E\u043A\u0442\u043E\u0440 \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C \u043C\u0435\u043D\u044F
      \u0435\u0449\u0451 \u0440\u0430\u0437.\n    \u041D\u0443\u0436\u043D\u043E
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0440\u0430\u0441\u0447\u0451\u0442
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u0441\u043D\u043E\u0432\u0430
      \u043E\u043A\u0430\u0436\u0443\u0441\u044C \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435.\n   
      \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044F \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0445\u043E\u0447\u0443 \u0432\u044B\u0439\u0442\u0438
      \u043E\u0442\u0442\u0443\u0434\u0430.\n    \u041D\u043E \u0443\u0436\u0435
      \u043D\u0435 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F."
  - key: note.dairy_room4_1.page0.1
    value: "    \n    <b>***</b>\n    \u041C\u043D\u0435 \u0431\u044B\u043B\u043E
      \u0432\u043E\u0441\u0435\u043C\u044C, \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u0435\u0446
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0441\u0430\u0434\u0438\u043B
      \u043C\u0435\u043D\u044F \u0437\u0430 \u0441\u0442\u0430\u043D\u043E\u043A.
      \u041D\u043E\u0433\u0438 \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438
      \u0434\u043E \u043F\u043E\u043B\u0430. \u041F\u043E\u043C\u043D\u044E \u0435\u0433\u043E
      \u043F\u0430\u043B\u044C\u0446\u044B \u043F\u043E\u0432\u0435\u0440\u0445 \u043C\u043E\u0438\u0445:
      \xAB\u041D\u0435 \u0434\u0430\u0432\u0438. \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0439,
      \u0433\u0434\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0435\u0442\u0441\u044F\xBB.\n   
      \u0421\u043C\u0435\u0448\u043D\u043E. \u0421 \u0436\u0435\u043B\u0435\u0437\u043E\u043C
      \u043E\u043D \u044D\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043B.\n   
      \u042F \u0432\u044B\u0442\u0430\u0449\u0438\u043B \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
      \u0438\u0437 \u0434\u043E\u043B\u0433\u043E\u0432, \u043F\u0435\u0440\u0435\u0432\u0451\u0437
      \u0432 \u043D\u043E\u0432\u043E\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435.
      \u041A \u043D\u0430\u043C \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u043D\u0430
      \u043C\u0435\u0441\u044F\u0446\u044B \u0432\u043F\u0435\u0440\u0435\u0434.
      \u041D\u043E \u043E\u0442\u0435\u0446 \u0432\u0441\u0451 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u0439\u0434\u0443\u0442 \u043D\u0430\u0448\u0438
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0447\u0430\u0441\u044B.
      \u042F \u043E\u0442\u0432\u0435\u0447\u0430\u043B: \u0441\u043A\u043E\u0440\u043E.
      \u0418 \u0441\u043D\u043E\u0432\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u043D\u043E\u0447\u044C.\n\n   
      <b>***</b>\n    \u041C\u043E\u0440\u0440\u043E \u0437\u0430\u0431\u0440\u0430\u043B
      \u0447\u0430\u0441\u044B. \u0421\u043A\u0430\u0437\u0430\u043B, \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430 \u0441\u043F\u0435\u0448\u0438\u0442\u044C.\n   
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0437\u043B\u0438\u043B\u0441\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
      \u0441\u0438\u0434\u0435\u0442\u044C \u043D\u0430 \u0432\u0435\u0440\u0430\u043D\u0434\u0435
      \u0431\u0435\u0437 \u0434\u0435\u043B\u0430. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0438\u0434\u0435\u0442\u044C. \u041E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0440\u0430\u043D\u044C\u0448\u0435 \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u0442\u0430\u043A \u043D\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B.\n   
      \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u0432\u0447\u0435\u0440\u0430 \u044F \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432,
      \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u044F \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B.
      \u0414\u043B\u044F \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0448\u043B\u043E
      \u043E\u0434\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435.
      \u041C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u0430 \u0441\u0442\u043E\u044F\u043B\u0430
      \u0443 \u0434\u0432\u0435\u0440\u0438 \u2014 \u0438 \u0432\u0434\u0440\u0443\u0433
      \u0443\u0436\u0435 \u0440\u044F\u0434\u043E\u043C, \u0434\u0435\u0440\u0436\u0438\u0442
      \u043C\u0435\u043D\u044F \u0437\u0430 \u043F\u043B\u0435\u0447\u043E.\n\n   
      <b>***</b>\n    \u041C\u0435\u043D\u044F \u0432\u0435\u0440\u043D\u0443\u043B\u043E
      \u0442\u0438\u043A\u0430\u043D\u044C\u0435.\n    \u0415\u0449\u0451 \u043D\u0435
      \u043E\u0442\u043A\u0440\u044B\u0432 \u0433\u043B\u0430\u0437\u0430, \u0430
      \u0443\u0436\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u043B: \u043C\u0430\u044F\u0442\u043D\u0438\u043A,
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0445\u043E\u0434. \u041F\u043E\u0447\u0442\u0438
      \u043A\u0430\u043A \u0443 \u0434\u0435\u0434\u043E\u0432\u044B\u0445 \u043A\u0430\u043C\u0438\u043D\u043D\u044B\u0445.
      \u0421\u0440\u0430\u0437\u0443 \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C.\n   
      \u041F\u043E\u0441\u043B\u0435 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u0438,
      \u0440\u0443\u043A\u0438 \u0441\u043D\u043E\u0432\u0430 \u0441\u043B\u0443\u0448\u0430\u044E\u0442\u0441\u044F.
      \u0414\u043E\u043A\u0442\u043E\u0440 \u043F\u0440\u0438\u043D\u0451\u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.\n   
      \u042F \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0441\u044E\u0434\u0430,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043C\u043E\u0433 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0447\u0430\u0441\u044B. \u0422\u0435\u043F\u0435\u0440\u044C \u0431\u0435\u0437
      \u043D\u0438\u0445 \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F.\n\n   
      <b>***</b>\n    \u0422\u0430\u043C \u044F \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
      \u0438\u0434\u0443 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443.
      \u041E\u043D \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0430\u043F\u0440\u0430\u0432\u043E.
      \u041F\u043E\u0432\u043E\u0440\u043E\u0442, \u0435\u0449\u0451 \u043F\u043E\u0432\u043E\u0440\u043E\u0442,
      \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u043A\u0430
      \u043D\u0435\u0442. \u041E\u043D \u0442\u0430\u043A\u043E\u0439 \u0436\u0435
      \u043A\u0430\u043A \u0437\u0430\u0432\u043E\u0434\u043D\u0430\u044F \u043F\u0440\u0443\u0436\u0438\u043D\u0430.\n\n   
      <b>***</b>\n    \u041F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u0435\u0449\u0451
      \u0447\u0430\u0441\u044B. \u041E\u0434\u043D\u0438\u0445 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.\n   
      \u041F\u044B\u0442\u0430\u044E\u0441\u044C \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0434\u0438\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F. \u041D\u0443\u0436\u043D\u043E
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u043A\u0430\u043A\u043E\u0435.\n   
      \u0418\u0437 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439 \u043C\u0435\u043D\u044F
      \u0443\u0432\u0435\u0437\u043B\u0438. \u0420\u0430\u0431\u043E\u0442\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0442\u0430 \u0436\u0435."
  - key: note.dairy_room4_2.page0.1
    value: "\t\n    <b>***</b>\n    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
      \u0434\u0432\u0435\u0440\u044C. \u0417\u0430 \u043D\u0435\u0439 \u0431\u044B\u043B
      \u0441\u0432\u0435\u0442. \n    \u042F \u0448\u0430\u0433\u043D\u0443\u043B
      \u0442\u0443\u0434\u0430 \u2014 \u0438 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430 \u0432 \u043F\u0430\u043B\u0430\u0442\u0435.\n   
      \u041F\u043E\u0434\u0443\u043C\u0430\u043B: \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u041D\u043E \u043F\u043E\u0442\u043E\u043C \u043E\u043F\u044F\u0442\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043D\u0430 \u0442\u043E\u043C
      \u0436\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435.\n    \u041C\u043E\u0440\u0440\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0434\u0432\u0435\u0440\u044C
      \u044F \u0441\u043E\u0437\u0434\u0430\u043B \u0441\u0430\u043C. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0432\u044B\u0445\u043E\u0434 \u2014 \u0447\u0442\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0435.
      \u0425\u043E\u0442\u0435\u043B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D \u0437\u043D\u0430\u0435\u0442,
      \u043D\u043E \u043E\u043D \u0443\u0436\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u044B.\n\n    <b>***</b>\n   
      \u041E\u0442\u0435\u0446 \u0443\u0447\u0438\u043B: \u0435\u0441\u043B\u0438
      \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043D\u0435 \u0438\u0434\u0451\u0442,
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0437\u0430\u0432\u043E\u0434\u0438\u0442\u044C
      \u043D\u0435\u043B\u044C\u0437\u044F. \u041D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043C\u0435\u0448\u0430\u0435\u0442.\n    \u0425\u043E\u0442\u0435\u043B
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0434\u043E\u043A\u0442\u043E\u0440\u0443.
      \u041E\u043D \u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0441\u044F.\n\n   
      <b>***</b>\n    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F.
      \n    \u041D\u0435 \u043E\u0442\u0446\u0443. \n    \u041D\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439.\n   
      \u041C\u043D\u0435.\n"
  - key: note.dairy_room5_1.page0.1
    value: "    \n    <b>***</b>\n   \u0414\u043E\u043C\u0430 \u0434\u0430\u0436\u0435
      \u043A\u0440\u0435\u0441\u043B\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0431\u044B\u043B\u043E
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u043D\u0443\u0442\u044C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0442\u0435\u043B\u0430
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043C\u0435\u0441\u0442\u0430,
      \u0433\u0434\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0430\u043C
      \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442 \u043F\u0443\u0442\u044C.\n\u2026\u041F\u0435\u0440\u0432\u044B\u0439
      \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442 \u0441\u0442\u0440\u043E\u0438\u043B\u0430
      \u0441 \u041A\u0440\u0438\u0441\u0442\u0438\u0430\u043D\u043E\u043C. \u0414\u043E\u0432\u0435\u0440\u0438\u043B\u0430
      \u0435\u043C\u0443 \u0432\u0441\u0451. \u041F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E
      \u043F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432 \u0442\u0443\u043F\u0438\u043A\u0435:
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0438 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C.\n  
      \u041D\u043E \u044F \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C.
      \u041F\u043E\u0437\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u0446\u0435\u043D\u0442\u0440.
      \u0418 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u0430:
      \xAB\u041D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442\u0435, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0430\u043C\u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C\xBB.\n\n   <b>***</b>\n   \u041F\u043E\u043C\u043D\u044E
      \u0444\u0430\u0440\u044B \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0430.
      \u041F\u043E\u0442\u043E\u043C \u2014 \u0441\u0442\u0435\u043D\u044B.\n   \u041A\u0430\u043C\u0435\u043D\u044C
      \u0441\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043C\u0440\u0430\u043C\u043E\u0440\u043E\u043C
      \u043D\u0430\u0448\u0435\u0433\u043E \u0434\u043E\u043C\u0430, \u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C \u0448\u0435\u043B\u0435\u0441\u0442\u0438\u0442
      \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0430. \u0412 \u0437\u0435\u0440\u043A\u0430\u043B\u0430\u0445
      \u0441\u0442\u043E\u0438\u0442 \u041A\u0440\u0438\u0441\u0442\u0438\u0430\u043D.
      \u0417\u043D\u0430\u044E, \u0447\u0442\u043E \u043E\u043D \u0441\u043A\u0430\u0436\u0435\u0442.\n  
      \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u0430 \u0438\u0437 \u043C\u043E\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E. \u042F \u0434\u043E\u043B\u0436\u043D\u0430
      \u0437\u043D\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443.\n   \u041D\u043E
      \u0432\u0441\u0435 \u0434\u043E\u0440\u043E\u0433\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B
      \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E.\n\n   <b>***</b>\n  
      \u042F \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C... \u041A\u0442\u043E-\u0442\u043E
      \u0434\u0435\u0440\u0436\u0430\u043B \u043C\u043E\u044E \u043B\u0430\u0434\u043E\u043D\u044C.
      \u042F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u043D\u0435\u0439 \u0437\u043D\u0430\u043A \u0437\u0430\u0449\u0438\u0442\u044B.
      \u041F\u043E\u043B\u0443\u0447\u0438\u043B\u0430\u0441\u044C \u0440\u0443\u043D\u0430
      \u0410\u043B\u044C\u0433\u0438\u0437.\n   \u041C\u043E\u0440\u0440\u043E \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043C\u043D\u0435.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
      \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
      \u043F\u043E\u0434 \u0431\u043E\u0441\u044B\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u043B.\n\n  
      <b>***</b>\n   \u041D\u0430 \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0435
      \u043B\u0435\u0436\u0438\u0442 \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043A\u043B\u0443\u0431\u043E\u043A
      \u0438 \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043D\u0441\u0430\u0439.
      \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435\n\u043E\u0442
      \u041C\u0430\u0440\u043A\u0430, \u043C\u043E\u0435\u0433\u043E \u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430. \u0411\u0435\u0437
      \u043D\u0435\u0433\u043E \u044F \u0431\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C...\n  
      \u041F\u0440\u043E\u0432\u0435\u043B\u0430 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u043A\u043E\u0440\u0435 \u0438 \u0441\u0440\u0435\u0434\u0438
      \u0441\u0442\u0435\u043D, \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043A\u043E\u0440\u0435\u043D\u044C. \u0417\u043D\u0430\u0447\u0438\u0442,\n\u044F
      \u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C.\n   \u0420\u0438\u0441\u0443\u044E
      \u0435\u0433\u043E. \u041E\u0442 \u041E\u0434\u0430\u043B \u2014 \u0434\u043E\u043C\u0430,
      \u0433\u0434\u0435 \u0432\u0441\u0451 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C,
      \u2014 \u043A \u0413\u0435\u0431\u043E. \u0414\u043E\u0432\u0435\u0440\u0438\u0435\n\u043D\u0443\u0436\u043D\u043E
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0434\u0432\u0430\u0436\u0434\u044B:
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
      \u0438\u0437\u0432\u043D\u0435 \u0438 \u043E\u0442\u0434\u0430\u0442\u044C
      \u0441\u0438\u043B\u0443\n\u0432\u0437\u0430\u043C\u0435\u043D. \u041A\u043E\u043D\u0435\u0447\u043D\u0430\u044F
      \u0446\u0435\u043B\u044C \u2014 \u0410\u043B\u044C\u0433\u0438\u0437, \u0437\u043D\u0430\u043A
      \u0438\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u044F \u0438 \u0437\u0430\u0449\u0438\u0442\u044B.
      \u0412\u0443\u043D\u044C\u043E \u2014\n\u043C\u043E\u044F \u043F\u0440\u0435\u0436\u043D\u044F\u044F
      \u0431\u0435\u0437\u0437\u0430\u0431\u043E\u0442\u043D\u0430\u044F \u0440\u0430\u0434\u043E\u0441\u0442\u044C
      \u2014 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043B\u0438\u0448\u044C
      \u0442\u0435\u043F\u043B\u044B\u043C\n\u043E\u0442\u0431\u043B\u0435\u0441\u043A\u043E\u043C
      \u0443 \u043A\u0440\u043E\u043C\u043A\u0438.\n   \u041F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0437\u043D\u0430\u043A \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043D\u0430\u0440\u0443\u0436\u0438.
      \u041D\u0435 \u0432\u043F\u043B\u0435\u0442\u0430\u0442\u044C \u0435\u0433\u043E
      \u0441\u043D\u043E\u0432\u0430.\n\n   <b>***</b>\n   \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u0441\u0432\u0435\u0442.\n   \u0414\u043E\u043A\u0442\u043E\u0440
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B, \u0434\u0430\u043B\u0435\u043A\u043E
      \u043B\u0438 \u0434\u043E \u043D\u0435\u0433\u043E. \u042F \u0445\u043E\u0442\u0435\u043B\u0430
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C: \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u0437\u0434\u0435\u0441\u044C \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0437\u043D\u0430\u0447\u0438\u0442. \u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442.\n   \u041E\u043D \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B
      \u0432\u043E\u043F\u0440\u043E\u0441 \u0441\u043D\u043E\u0432\u0430 \u0438
      \u0441\u043D\u043E\u0432\u0430. \u041E\u0442 \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u0430
      \u044F \u0437\u0430\u0431\u044B\u0432\u0430\u043B\u0430, \u043A\u0442\u043E
      \u044F \u0438 \u043A\u0443\u0434\u0430 \u0438\u0434\u0443.\n"
  - key: note.dairy_room5_2.page0.1
    value: "\t\n    <b>***</b>\n    \u2026\u0421\u0440\u0435\u0434\u0438 \u0441\u0435\u0440\u044B\u0445
      \u0441\u0442\u0435\u043D \u0441\u043B\u044B\u0448\u043D\u044B \u0448\u0430\u0433\u0438.
      \u041A\u0442\u043E-\u0442\u043E \u0448\u0451\u043B \u043C\u043D\u0435 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443.\n   
      \u042F \u043F\u043E\u0437\u0432\u0430\u043B\u0430.\n    \u0428\u0430\u0433\u0438
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.\n   
      \u0413\u043E\u043B\u043E\u0441 \u041C\u043E\u0440\u0440\u043E \u0431\u044B\u043B
      \u0441\u043E\u0432\u0441\u0435\u043C \u0440\u044F\u0434\u043E\u043C, \u043D\u043E
      \u0434\u043E\u043D\u043E\u0441\u0438\u043B\u0441\u044F \u0441\u0432\u0435\u0440\u0445\u0443.\n\n   
      <b>***</b>\n    \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043C\u0430\u043B\u043E.\n    \u042F \u0437\u043D\u0430\u044E. \u041D\u043E
      \u0435\u0441\u043B\u0438 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F,
      - \u0432\u0441\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C\u0438.\n\n   
      <b>***</b>\n    \u041D\u0438\u0442\u044C \u0435\u0449\u0451 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0417\u0430\u0436\u0438\u043C\u0430\u044E \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438.\n   
      \u0421 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430
      \u0442\u044F\u043D\u0443\u0442.\n    \u0425\u043E\u0442\u0435\u043B\u0430 \u043A\u0440\u0438\u043A\u043D\u0443\u0442\u044C:
      \n\n    \u2013 \u041D\u0435 \u0442\u044F\u043D\u0438! \u041E\u043D\u0430 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
      \u0437\u0430 \u0443\u0433\u043E\u043B. \u041D\u0443\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043E\u0441\u043B\u0430\u0431\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u044F \u043C\u043E\u0433\u043B\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u0435\u0451.\n\n    \u041D\u043E \u043C\u043E\u0439 \u0433\u043E\u043B\u043E\u0441
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F \u0432 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0435\u0439
      \u0442\u044C\u043C\u0435.\n\n    <b>***</b>\n    \u0421\u0432\u0435\u0442 \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0432\u0438\u0434\u0435\u043D\u2026\n    \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043D\u0435 \u0442\u044F\u043D\u0438\u0442\u0435 \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E\u2026\n\n"
  - key: note.dairy_room6_1.page0.1
    value: "\t\n    <b>***</b>\n    \u041F\u0435\u0440\u0432\u044B\u043C \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441\u0442\u0440\u0435\u043A\u043E\u0442. \u041F\u043E\u0442\u043E\u043C
      \u2014 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0448\u0451\u043B\u043A\u0430
      \u043F\u043E\u0434 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438. \u0420\u0435\u0448\u0438\u043B\u0430,
      \u0447\u0442\u043E \u0443\u0441\u043D\u0443\u043B\u0430 \u0432\u043E\u0437\u043B\u0435
      \u0442\u0435\u0440\u0440\u0430\u0440\u0438\u0443\u043C\u043E\u0432. \u041D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C,
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u0438
      \u043A \u043B\u0435\u043A\u0446\u0438\u0438.\n    \u0412\u0441\u0442\u0430\u0442\u044C
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u0414\u0430\u0436\u0435 \u0440\u0443\u043A\u0438 \u043C\u0435\u043D\u044F
      \u0441\u043B\u0443\u0448\u0430\u044E\u0442\u0441\u044F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C.\n   
      \u041C\u043E\u0440\u0440\u043E \u0441\u043A\u0430\u0437\u0430\u043B, \u044F
      \u043F\u0440\u043E\u043B\u0435\u0436\u0430\u043B\u0430 \u0432 \u043A\u043E\u043C\u0435
      \u043C\u0435\u0441\u044F\u0446. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
      \u043A\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u043A\u043E\u0440\u043C\u0438\u043B \u043C\u043E\u0438\u0445 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445.\n\n   
      <b>***</b>\n    \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u044F \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043B\u0430
      \u0433\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A\u043E\u0432 \u0438\u0437
      \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0445 \u0434\u043E\u043A\u043E\u0432.
      \u0416\u0434\u0430\u043B\u0430 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F
      \u043B\u0430\u043F\u043E\u043A. \u041C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0438 \u0443 \u043C\u0435\u043D\u044F
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E,
      \u0447\u0435\u0433\u043E \u043F\u043E\u043A\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.\n   
      \u041F\u043E\u0442\u043E\u043C \u0431\u044B\u043B\u0438 \u0441\u043E\u0436\u0436\u0451\u043D\u043D\u0430\u044F
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F, \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438,
      \u0433\u043E\u0434\u044B \u0431\u0435\u0437 \u0441\u0435\u043C\u044C\u0438.
      \u042F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u0437\u0430\u0449\u0438\u0442\u0438\u043B\u0430
      \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E. \u041D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u044C
      \u0441\u0432\u043E\u0451 \u0438\u043C\u044F \u043F\u0435\u0440\u0435\u0434
      \u043F\u043E\u043B\u043D\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0435\u0439.\n   
      \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u043C\u043E\u044F
      \u0436\u0438\u0437\u043D\u044C.\n\n    <b>***</b>\n    \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0434\u043E\u043B\u0433\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438.
      \u041C\u043E\u0440\u0440\u043E \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B
      \u043E \u043F\u0435\u0440\u0435\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0438.
      \u042F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C:
      \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C
      \u043A\u0443\u043A\u043E\u043B\u043A\u0438 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u0430.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u0438\u0434\u0451\u0442 \u0440\u0430\u0431\u043E\u0442\u0430.\n   
      \u041E\u043D \u043E\u0447\u0435\u043D\u044C \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0441\u044F.\n   
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0437\u0440\u044F \u044F
      \u0432\u044B\u0431\u0440\u0430\u043B\u0430 \u044D\u0442\u043E\u0442 \u043F\u0440\u0438\u043C\u0435\u0440.\n\n   
      <b>***</b>\n    \u0422\u0430\u043C \u044F \u043B\u0435\u0436\u0443 \u0432 \u0442\u043E\u043D\u043A\u043E\u0439
      \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435. \u0421\u043A\u0432\u043E\u0437\u044C
      \u043D\u0435\u0451 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0442\u0451\u043F\u043B\u044B\u0439
      \u0441\u0432\u0435\u0442. \u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u0448\u0443\u043C\u0438\u0442
      \u043B\u0435\u0441.\n    \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u0435\u0441\u043D\u043E\u0442\u0430
      \u043F\u0443\u0433\u0430\u043B\u0430. \u041F\u043E\u0442\u043E\u043C \u044F
      \u043F\u043E\u043D\u044F\u043B\u0430: \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442 \u0434\u043E \u043C\u0435\u043D\u044F \u0434\u043E\u0442\u0440\u043E\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0436\u0434\u0430\u0442\u044C.\n    \u041D\u043E \u043C\u043D\u0435 \u0432\u0441\u0451
      \u0447\u0430\u0449\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0443\u0432\u0438\u0434\u0435\u0442\u044C,
      \u0447\u0442\u043E \u0441\u043D\u0430\u0440\u0443\u0436\u0438.\n"
  - key: note.dairy_room6_2.page0.1
    value: "\t\n    <b>***</b>\n    \u041F\u043E\u0441\u043B\u0435 \u043D\u043E\u0432\u043E\u0433\u043E
      \u0443\u043A\u043E\u043B\u0430 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
      \u0441\u0442\u0430\u043B\u0430 \u0442\u0435\u0441\u043D\u0435\u0435. \u041D\u0435
      \u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u043E\u0433\u043D\u0443\u0442\u044C
      \u0440\u0443\u043A\u0438.\n    \u0417\u0430\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0438\u0436\u0443 \u0434\u0432\u0435\u0440\u044C. \u041E\u043D\u0430
      \u0434\u0430\u043B\u0435\u043A\u043E, \u0437\u0430 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0439
      \u0441\u0442\u0435\u043D\u043A\u043E\u0439. \u041F\u043E\u0434 \u043D\u0435\u0439
      \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430.\n   
      \u0414\u043E\u043A\u0442\u043E\u0440 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043C\u043E\u0433\u0443 \u043B\u0438 \u044F \u0442\u0443\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.\n   
      \u042F \u0435\u0449\u0451 \u0434\u0430\u0436\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C
      \u043E\u0442\u0441\u044E\u0434\u0430.\n\n    <b>***</b> \n    \u041B\u0435\u0441
      \u0441\u0442\u0430\u043B \u0433\u0440\u043E\u043C\u0447\u0435. \u041E\u0434\u0438\u043D
      \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0432\u0441\u043F\u043B\u0435\u0441\u043A,
      \u0441\u0442\u0440\u0435\u043A\u043E\u0442, \u043F\u0430\u0443\u0437\u0430.\n   
      \u0417\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0442\u043E\u0436\u0435
      \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E.\n   
      \u041D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0441\u044F.\n\n   
      <b>***</b>\n    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0440\u044B\u043B\u043E.\n   
      \u0417\u043D\u0430\u044E, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F
      \u0435\u0433\u043E \u043D\u0435\u0442 \u2013 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430
      \u0440\u0443\u043A\u043E\u0439, \u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0433\u043B\u0430
      \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F.\n    \u041D\u043E
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.\n\n   
      <b>***</b>\n    \u041C\u043E\u0440\u0440\u043E \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u043F\u043E\u043C\u043E\u0447\u044C \u043C\u043D\u0435 \u0432\u044B\u0439\u0442\u0438.\n   
      \u041D\u0443\u0436\u043D\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C,
      \u043A\u0443\u0434\u0430.\n    \u041F\u043E\u0447\u0435\u043C\u0443 \u044F
      \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430?\n\n   
      <b>***</b>\n    \u042F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0445\u043E\u0447\u0443
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u0432\u0435\u0440\u044C.\n   
      \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0443\u0441\u0442\u044C \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0441 \u044D\u0442\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B.\n"
  - key: note.ftuecontrols.page0.0
    value: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - key: note.ftuecontrols.page0.10
