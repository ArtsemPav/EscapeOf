  - key: note.ftuecontrols.page0.2
    value: "\u0412\u043F\u0435\u0440\u0435\u0434"
  - key: note.ftuecontrols.page0.20
    value: "\u041F\u0430\u0443\u0437\u0430/ \u0412\u044B\u0445\u043E\u0434 \u0438\u0437
      \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A, \n\u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F,
      \u0447\u0442\u0435\u043D\u0438\u044F \u043A\u043D\u0438\u0433"
  - key: note.ftuecontrols.page0.22
    value: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438/ \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438 "
  - key: note.ftuecontrols.page0.24
    value: "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435"
  - key: note.ftuecontrols.page0.4
    value: "\u041D\u0430\u0437\u0430\u0434\n"
  - key: note.ftuecontrols.page0.6
    value: "\u0412\u043B\u0435\u0432\u043E"
  - key: note.ftuecontrols.page0.8
    value: "\u0412\u043F\u0440\u0430\u0432\u043E"
  - key: note.ftuenote1.page0.1
    value: "\u0415\u0449\u0451 \u0440\u0430\u0437: \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0438\u043B\u0438 \n\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430\u0436\u043C\u0438   
      .\n\n\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u043B\u0430\u0446\u0430\u0439
      \u0432\u0441\u0451 \u043F\u043E\u0434\u0440\u044F\u0434 -\n \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439
      \u0432\u0441\u0451 \u0432 Monkey-\u0442\u0435\u0441\u0442\n\n\u041B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0441\u0442\u043E\u043B\u0443"
  - key: note.ftuenote1.page0.1
    value: "\u0415\u0449\u0451 \u0440\u0430\u0437: \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0438\u043B\u0438 \n\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430\u0436\u043C\u0438   
      .\n\n\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u043B\u0430\u0446\u0430\u0439
      \u0432\u0441\u0451 \u043F\u043E\u0434\u0440\u044F\u0434 -\n \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439
      \u0432\u0441\u0451 \u0432 Monkey-\u0442\u0435\u0441\u0442\n\n\u041B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0441\u0442\u043E\u043B\u0443"
  - key: note.ftuenote1.page0.1
    value: "\u0415\u0449\u0451 \u0440\u0430\u0437: \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0438\u043B\u0438 \n\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430\u0436\u043C\u0438   
      .\n\n\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u043B\u0430\u0446\u0430\u0439
      \u0432\u0441\u0451 \u043F\u043E\u0434\u0440\u044F\u0434 -\n \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439
      \u0432\u0441\u0451 \u0432 Monkey-\u0442\u0435\u0441\u0442\n\n\u041B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0441\u0442\u043E\u043B\u0443"
  - key: note.ftuenote10.page0.1
    value: "\u041D\u0435 \u043A\u0430\u0436\u0434\u0430\u044F \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430\n\u041D\u0435 \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F \u043A\u043B\u044E\u0447\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0448\u044C
      \n\u041D\u0435 \u0441\u0434\u0430\u0432\u0430\u0439\u0441\u044F!\n\n\u041F\u0440\u043E\u0439\u0434\u0438
      \u0432\u0441\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B... \n\u0423\u0437\u043D\u0430\u0439
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E...\n\u041D\u0430\u0439\u0434\u0438
      \u0432\u044B\u0445\u043E\u0434!"
  - key: note.ftuenote3.page0.1
    value: "\u0417\u0434\u0435\u0441\u044C \u0442\u0435\u043C\u043D\u043E. \n\u0414\u0430\u043B\u044C\u0448\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C\u043D\u0435\u0435\n\n\u041D\u0430\u0439\u0434\u0438
      \u0444\u043E\u043D\u0430\u0440\u044C:\n\u043F\u043E\u0438\u0449\u0438 \u0432
      \u044F\u0449\u0438\u043A\u0430\u0445 \u0441\u0442\u043E\u043B\u0430\n\n\u0417\u0430\u0436\u043C\u0438       
      \u0438 \u0442\u044F\u043D\u0438 \u043D\u0430 \u0441\u0435\u0431\u044F, \n\u043D\u0435
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0439!"
  - key: note.ftuenote4.page0.1
    value: "\u0411\u0435\u0437 \u0431\u0430\u0442\u0430\u0440\u0435\u0435\u043A \u043E\u043D
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u0435\u043D\n\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0430\u0445\n\n\u041F\u0440\u044B\u0433\u0430\u0439!
      \t\n\u041F\u0440\u044B\u0433\u0430\u0439!\n\n\u0422\u044B \u043D\u0435 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C
      \u0431\u0440\u043E\u0434\u0438\u0442\u044C \n\u0437\u0434\u0435\u0441\u044C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435"
  - key: note.ftuenote5.page0.1
    value: "         \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\n\n\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0438
      \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \n\u0441 \u043D\u043E\u0432\u044B\u043C\u0438
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438\n\n\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?\n\u041D\u0430\u0436\u043C\u0438       
      , \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0441\u0432\u0435\u0442"
  - key: note.ftuenote6.page0.1
    value: "\u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430 \u043F\u0443\u0442\u0438 -\n\u043E\u0442\u043E\u0434\u0432\u0438\u043D\u044C
      \u044D\u0442\u043E\n\u041D\u0435 \u0434\u0430\u0439 \u0441\u0435\u0431\u044F
      \u0441\u0431\u0438\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\n\n\u0415\u0441\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u043D\u0430
      \u043F\u0443\u0442\u0438 -\n\u043E\u0442\u043E\u0434\u0432\u0438\u043D\u044C
