      \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u0435\u043D."
  - key: item.DirtColba.name
    value: GR-B7
  - key: item.Empty.desc
    value: "\u0421\u0442\u0435\u0440\u0438\u043B\u044C\u043D\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u044F
      \u043A\u043E\u043B\u0431\u0430. \u0411\u0435\u0437 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E."
