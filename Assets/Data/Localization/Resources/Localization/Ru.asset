  - key: item.DirtColba.desc
    value: "\u041F\u0435\u043F\u0442\u0438\u0434\u043D\u043E-\u0444\u043E\u0441\u0444\u043E\u043B\u0438\u043F\u0438\u0434\u043D\u044B\u0439
