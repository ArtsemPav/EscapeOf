  entries:
  - key: hints.close.action
    value: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
  - key: hints.close.key
    value: Tab / I
  - key: hints.combine.action
    value: "\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C / \u043A\u0440\u0430\u0444\u0442"
  - key: hints.combine.key
    value: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u044C \u043D\u0430
      \u0441\u043B\u043E\u0442"
  - key: hints.drag.action
    value: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442"
  - key: hints.drag.key
    value: "\u041B\u041A\u041C + \u0442\u0430\u0449\u0438\u0442\u044C"
  - key: hints.rotate.action
    value: "3D-\u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430"
  - key: hints.rotate.key
    value: "\u041F\u041A\u041C"
  - key: note.book_doctor_safe.page0.0
    value: "\u041F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0435"
  - key: note.book_doctor_safe.page0.1
    value: "\t\u0421\u043B\u0443\u0448\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0443\u0447\u0435\u043D\u0438\u043A. \u0421\u0435\u0439\u0444 \u2014 \u043D\u0435
      \u0432\u0440\u0430\u0433 \u0442\u0435\u0431\u0435. \u041E\u043D \u2014 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0441 \u0442\u043E\u0431\u043E\u0439
      \u043D\u0430 \u044F\u0437\u044B\u043A\u0435 \u0449\u0435\u043B\u0447\u043A\u043E\u0432,
      \u0438 \u043B\u0438\u0448\u044C \u0442\u043E\u0442, \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442
      \u043C\u043E\u043B\u0447\u0430\u0442\u044C \u0438 \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u0443\u0441\u043B\u044B\u0448\u0438\u0442 \u0435\u0433\u043E \u0437\u0432\u0443\u043A\u0438.
      \n\t\u0417\u0430\u0431\u0443\u0434\u044C \u043E \u0441\u043F\u0435\u0448\u043A\u0435.
      \n\t\u0417\u0430\u0431\u0443\u0434\u044C \u043E \u0441\u0438\u043B\u0435. \n\t\u0417\u0434\u0435\u0441\u044C
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435."
  - key: note.book_doctor_safe.page0.2
    value: "\t\u0418\u0437 \u0437\u0430\u043F\u0438\u0441\u043E\u043A \u043C\u0430\u0441\u0442\u0435\u0440\u0430-\u043C\u0435\u0434\u0432\u0435\u0436\u0430\u0442\u043D\u0438\u043A\u0430,
      \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u0434\u043B\u044F
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0438\u0434\u0451\u0442 \u0441\u043B\u0435\u0434\u043E\u043C"
  - key: note.book_doctor_safe.page0.3
    value: "\u0413\u043B\u0430\u0432\u0430 I. \u041E \u043F\u0440\u0438\u0440\u043E\u0434\u0435
      \u0437\u0430\u043C\u043A\u0430"
  - key: note.book_doctor_safe.page0.4
    value: "\u0413\u043B\u0430\u0432\u0430 II. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
  - key: note.book_doctor_safe.page0.5
    value: "\t\u0412\u0441\u044F\u043A\u0438\u0439 \u0441\u0435\u0439\u0444 \u0435\u0441\u0442\u044C
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u0442\u0430\u0439\u043D,
      \u0438 \u0442\u0430\u0439\u043D\u0430 \u0435\u0433\u043E \u2014 \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438.
      \u0422\u0440\u0438 \u0447\u0438\u0441\u043B\u0430, \u0447\u0435\u0442\u044B\u0440\u0435,
      \u0430 \u0442\u043E \u0438 \u043F\u044F\u0442\u044C \u2014 \u043A\u0430\u0436\u0434\u043E\u0435
      \u0438\u0437 \u043D\u0438\u0445 \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043E
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C \u0440\u0443\u0447\u043A\u0438.
      \u0417\u0430\u043C\u043E\u043A \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u0442\u0430\u043A,
      \u0447\u0442\u043E \u043F\u0440\u0438 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438
      \u0438\u0437\u0434\u0430\u0451\u0442 \u043E\u043D \u0442\u0438\u0445\u0438\u0439
      \u0437\u0432\u0443\u043A \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438. \u042D\u0442\u043E \u0435\u0433\u043E
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u0421\u0447\u0438\u0442\u0430\u0439
      \u044D\u0442\u0438 \u0437\u0432\u0443\u043A\u0438, \u0438\u0431\u043E \u043E\u043D\u0438
      \u2014 \u0448\u0430\u0433\u0438 \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0443\u0442\u0438.\n\t\u041D\u043E
      \u0435\u0441\u0442\u044C \u0441\u0440\u0435\u0434\u0438 \u0437\u0432\u0443\u043A\u043E\u0432
      \u043E\u0441\u043E\u0431\u044B\u0435. \u0422\u0435, \u0447\u0442\u043E \u0437\u0432\u0443\u0447\u0430\u0442
      \u0447\u0443\u0442\u044C \u0438\u043D\u0430\u0447\u0435 \u2014 \u0433\u0440\u043E\u043C\u0447\u0435.\u0422\u0440\u0435\u043D\u0438\u0440\u0443\u0439
      \u0443\u0445\u043E \u0441\u0432\u043E\u0451, \u0438\u0431\u043E \u043E\u043D\u043E
      \u2014 \u0442\u0432\u043E\u0439 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.\n\t\u0410 \u043A\u043E\u043B\u0438
      \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F \u2014 \u0441\u0435\u0439\u0444
      \u0437\u0430\u043C\u043E\u043B\u0447\u0438\u0442 \u0438 \u0441\u0431\u0440\u043E\u0441\u0438\u0442
      \u0432\u0441\u0451, \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u043E\u0448\u0451\u043B.
      \u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0439 \u0437\u0430\u043D\u043E\u0432\u043E.
      \u0422\u0430\u043A\u043E\u0432\u0430 \u0435\u0433\u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0430."
  - key: note.book_doctor_safe.page0.6
    value: "\t\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F
      \u0440\u0443\u0447\u043A\u0438, \u0441\u043E\u0442\u0432\u043E\u0440\u0438
      \u0442\u0438\u0448\u0438\u043D\u0443 \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F.\n\t\u0423\u0431\u0430\u0432\u044C
      \u043C\u0443\u0437\u044B\u043A\u0443 \u2014 \u043E\u043D\u0430 \u0432\u0440\u0430\u0433
      \u0442\u0432\u043E\u0439.\n\t\u0414\u044B\u0448\u0438 \u0440\u043E\u0432\u043D\u043E.
      \u0420\u0443\u043A\u0430 \u0434\u0440\u043E\u0433\u043D\u0435\u0442 \u2014
      \u0441\u043E\u0431\u044C\u0451\u0448\u044C\u0441\u044F.\n\t\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0437\u0430\u043C\u043A\u0430 \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0439
      \u043F\u0443\u043B\u044C\u0441. \u041F\u0440\u0438\u0441\u043B\u0443\u0448\u0430\u0439\u0441\u044F
      \u043A \u0435\u0433\u043E \u0431\u0438\u0435\u043D\u0438\u044E, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0437\u043D\u0430\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442."
  - key: note.book_doctor_safe.page1.0
    value: "\u0413\u043B\u0430\u0432\u0430 III. \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C"
  - key: note.book_doctor_safe.page1.1
    value: "\t\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434:
      \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439\n\t\u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0432\u0440\u0430\u0449\u0430\u0442\u044C \u0434\u0438\u0441\u043A \u043F\u043E
      \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435.
      \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435.\n\t\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0448\u0430\u0433\u043E\u0432 \u0437\u0432\u0443\u0447\u0430\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
      - \u0440\u043E\u0432\u043D\u044B\u0435, \u0441\u0443\u0445\u0438\u0435 \u0449\u0435\u043B\u0447\u043A\u0438.
      \u041D\u043E \u0433\u0434\u0435-\u0442\u043E \u043D\u0430 \u043A\u0440\u0443\u0433\u0435
      \u0440\u0430\u0437\u0434\u0430\u0441\u0442\u0441\u044F \u0434\u0440\u0443\u0433\u043E\u0439
      \u0437\u0432\u0443\u043A. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439.
      \u0422\u043E\u0442 \u0441\u0430\u043C\u044B\u0439. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u0447\u0438\u0441\u043B\u043E, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043E\u043D \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B.\n\t\u0415\u0441\u043B\u0438
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0433\u043E \u0449\u0435\u043B\u0447\u043A\u0430
      \u043D\u0435\u0442 \u2014 \u0437\u043D\u0430\u0447\u0438\u0442, \u043D\u0430
      \u044D\u0442\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430
      \u043D\u0435\u0442. \u041D\u043E \u043E\u043D\u043E \u0431\u0443\u0434\u0435\u0442.
      \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C.\n\t\u0412\u0442\u043E\u0440\u043E\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434: \u043F\u0440\u043E\u0442\u0438\u0432
      \u0447\u0430\u0441\u043E\u0432\u043E\u0439\n\t\u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0430\u0447\u043D\u0438\u0442\u0435 \u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438. \u0421\u043D\u043E\u0432\u0430
      \u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435. \u0421\u043D\u043E\u0432\u0430
      \u0438\u0449\u0438\u0442\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
      \u0449\u0435\u043B\u0447\u043E\u043A. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u0447\u0438\u0441\u043B\u043E, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043E\u043D \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B.\n\t\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
      \u043A \u043D\u0430\u0447\u0430\u043B\u0443. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430.
      \u0428\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C. \u0429\u0435\u043B\u0447\u043E\u043A
      \u0437\u0430 \u0449\u0435\u043B\u0447\u043A\u043E\u043C. \u041F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0439\u0442\u0435\u0441\u044C
      \u043A \u0442\u043E\u043C\u0443 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E,
      \u0433\u0434\u0435 \u0432\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439 \u0437\u0432\u0443\u043A.\n\t\u0415\u0441\u043B\u0438
      \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u0449\u0435\u043B\u0447\u043E\u043A \u2014 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F
      \u0432\u0435\u0440\u043D\u0430. \u041E\u0442\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435
      \u0437\u0430\u043C\u043E\u043A.\n\t\u0418 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435
      \u043F\u043E\u043A\u0430 \u0441\u0435\u0439\u0444 \u043D\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
  - key: note.book_doctor_safe.page1.2
    value: "\u0413\u043B\u0430\u0432\u0430 IV. \u0420\u0430\u0431\u043E\u0442\u0430
      \u0441 \u0434\u0438\u0441\u043A\u043E\u043C"
  - key: note.book_doctor_safe.page1.3
    value: "1) \u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u0437\u0430\u043C\u043E\u043A
      \u0438 \u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435  \u0432\u043E\u043A\u0440\u0443\u0433
      \u0446\u0435\u043D\u0442\u0440\u0430 \u0434\u0438\u0441\u043A\u0430. \u0414\u0438\u0441\u043A
      \u043D\u0430\u0447\u043D\u0451\u0442 \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F.\n2)
      \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0449\u0435\u043B\u0447\u043A\u0438.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0449\u0435\u043B\u0447\u043E\u043A \u2014
      \u043E\u0434\u0438\u043D \u0448\u0430\u0433, \u043E\u0434\u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F.
      \u041D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u0435: \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
      \u0449\u0435\u043B\u0447\u043E\u043A \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0448\u0430\u0433\u0435. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.\n3) \u0412\u0435\u0434\u0438\u0442\u0435
      \u0434\u0438\u0441\u043A \u0432 \u043D\u0443\u0436\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.
      \u0415\u0441\u043B\u0438 \u0448\u0430\u0433 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u2014 \u043A\u0440\u0443\u0442\u0438\u0442\u0435
      \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439. \u041F\u0440\u043E\u0442\u0438\u0432
      \u2014 \u043F\u0440\u043E\u0442\u0438\u0432. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C.\n4)
      \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u043D\u0443\u0436\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435. \u041D\u0435
      \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u0442\u0435. \u041D\u0435
      \u043D\u0435\u0434\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u0435. \u0414\u0438\u0441\u043A
      \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043C\u0435\u0440\u0435\u0442\u044C
      \u0442\u043E\u0447\u043D\u043E \u043D\u0430 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438,
      \u0433\u0434\u0435 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
      \u0449\u0435\u043B\u0447\u043E\u043A.\n5) \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0437\u0430\u043C\u043E\u043A. \u0418\u043C\u0435\u043D\u043D\u043E \u0432
      \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0437\u0430\u043C\u043E\u043A
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442:\n\t- \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u043B\u0438 \u0432\u044B \u043D\u0430 \u043D\u0443\u0436\u043D\u043E\u043C
      \u0447\u0438\u0441\u043B\u0435?\n\t- \u0411\u044B\u043B\u043E \u043B\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438?\n\n\t\u0415\u0441\u043B\u0438
      \u043E\u0431\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u2014 \u0448\u0430\u0433 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043D.
      \u0412\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u043A
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443."
  - key: note.book_doctor_safe.page2.0
    value: "\u0413\u043B\u0430\u0432\u0430 V. \u0426\u0435\u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0438"
  - key: note.book_doctor_safe.page2.1
    value: "\t\u041E\u0448\u0438\u0431\u043A\u0430 \u2014 \u044D\u0442\u043E \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435
      \u0447\u0438\u0441\u043B\u043E. \u042D\u0442\u043E \u0438 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u043A\u0430
      \u0432 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u0438.\n\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C:\n\t- \u0414\u0438\u0441\u043A
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0434\u0432\u0430 \u043F\u043E\u043B\u043D\u044B\u0445
      \u043E\u0431\u043E\u0440\u043E\u0442\u0430 \u0438 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044E 0.\n\t- \u0412\u0435\u0441\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438
      \u043E\u0431\u043D\u0443\u043B\u044F\u0435\u0442\u0441\u044F.\n\t- \u0412\u044B
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u2014 \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430,
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430,
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\n\n\t\u041E\u0448\u0438\u0431\u043A\u0430
      \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u0448\u0430\u0433\u0435 \u2014
      \u0431\u0443\u0434\u044C \u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439
      \u0438\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u2014
      \u0441\u0442\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0451. \u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F
      \u0432\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0439
      \u043E\u0448\u0438\u0431\u043A\u0438, \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430."
  - key: note.book_doctor_safe.page2.2
    value: "\u0413\u043B\u0430\u0432\u0430 VI. \u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435"
  - key: note.book_doctor_safe.page2.3
    value: "\t\u041C\u0435\u0434\u0432\u0435\u0436\u0430\u0442\u043D\u0438\u043A,
      \u0447\u0442\u043E \u0441\u043F\u0435\u0448\u0438\u0442, \u2014 \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u043C\u0435\u0434\u0432\u0435\u0436\u0430\u0442\u043D\u0438\u043A. \u0421\u0435\u0439\u0444
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u0441\u0443\u0435\u0442\u044B.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0431\u0440\u043E\u0441 \u2014
      \u043D\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u0430
      \u0443\u0440\u043E\u043A. \u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0440\u0430\u0437\u043E\u043C
      \u0442\u044B \u0441\u043B\u044B\u0448\u0438\u0448\u044C \u043B\u0443\u0447\u0448\u0435.
      \u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0440\u0430\u0437\u043E\u043C
      \u0440\u0443\u043A\u0430 \u0442\u0432\u043E\u044F \u0442\u0432\u0451\u0440\u0436\u0435.\n\t\u0418
      \u043A\u043E\u0433\u0434\u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u0449\u0451\u043B\u043A\u043D\u0435\u0442 \u0437\u0430\u043C\u043E\u043A
      \u0438 \u0434\u0432\u0435\u0440\u0446\u0430 \u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F
      \u2014 \u0442\u044B \u043F\u043E\u0439\u043C\u0451\u0448\u044C, \u0447\u0442\u043E
      \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u043D\u0435 \u0441\u0435\u0439\u0444.
      \n\t\u0422\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0441\u0435\u0431\u044F."
  - key: note.book_doctor_safe.page2.4
    value: "\u041D\u0430\u0447\u043D\u0438 \u0441"
  - key: note.book_morro_dairy.page0.0
    value: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u041C\u043E\u0440\u0440\u043E"
  - key: note.book_morro_dairy.page0.3
    value: "                            <b>\u041B\u0438\u0447\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C</b>\n\n\t\u041C\u043D\u0435
      \u0431\u044B\u043B\u043E \u0442\u0440\u0438\u043D\u0430\u0434\u0446\u0430\u0442\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u043C\u0430\u0442\u0435\u0440\u0438
      \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u0438\u043D\u0441\u0443\u043B\u044C\u0442.
      \u041D\u0435\u0434\u0435\u043B\u044E \u044F \u0441\u0438\u0434\u0435\u043B
      \u0443 \u0435\u0451 \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0438 \u043F\u0440\u043E\u0441\u0438\u043B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430.\n\t\u0412\u0440\u0430\u0447\u0438
      \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C. \u041E\u0442\u0435\u0446 \u0441\u043A\u0430\u0437\u0430\u043B:
      \u043D\u0430 \u0432\u0441\u0451 \u0432\u043E\u043B\u044F \u0411\u043E\u0436\u044C\u044F.\n\t\u041C\u0430\u043C\u0430
      \u0443\u0447\u0438\u043B\u0430, \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043E\u0434\u0438\u043D.\n\t\u042F
      \u0441\u0442\u0430\u043B \u0432\u0440\u0430\u0447\u043E\u043C, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043D\u0435 \u0441\u043C\u043E\u0433 \u0441 \u044D\u0442\u0438\u043C
      \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F."
  - key: note.book_morro_dairy.page1.1
    value: "                       <b>\u0420\u0430\u0431\u043E\u0447\u0430\u044F
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430</b>\n\n\t\u041D\u0443\u0436\u043D\u043E\u0435
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u0441\u043A\u0440\u044B\u0442\u043E
      \u0432 \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0439
      \u0441\u0443\u0441\u043F\u0435\u043D\u0437\u0438\u0438. \u041F\u0440\u0435\u0436\u0434\u0435
      \u0432\u0441\u0435\u0433\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0435\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438
      \u2014 \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0443\u044E
      \u0444\u0440\u0430\u043A\u0446\u0438\u044E \u043E\u0442 \u043F\u0440\u0438\u043C\u0435\u0441\u0435\u0439.\n\t\u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u043D\u0451\u0441 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439\n\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B."
  - key: note.book_scandic_alphabet.page0.0
    value: "\u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0424\u0443\u0442\u0430\u0440\u043A"
  - key: note.book_scandic_alphabet.page0.12
    value: "\u0417\u043D\u0430\u043D\u0438\u0435, \u0440\u0435\u0447\u044C, \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C,
      \n\u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E"
  - key: note.book_scandic_alphabet.page0.15
    value: "\u041F\u0443\u0442\u044C, \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435,
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \n\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C"
  - key: note.book_scandic_alphabet.page0.18
    value: "\u0412\u043E\u0434\u0430, \u043F\u043E\u0442\u043E\u043A, \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F,
      \u044D\u043C\u043E\u0446\u0438\u0438"
  - key: note.book_scandic_alphabet.page0.3
    value: "\u0411\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E, \u0441\u043A\u043E\u0442,
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E, \n\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
  - key: note.book_scandic_alphabet.page0.6
    value: "\u0421\u0438\u043B\u0430, \u043C\u043E\u0449\u044C, \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
      \n\u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0431\u044B\u043A\u0430"
  - key: note.book_scandic_alphabet.page0.9
    value: "\u0428\u0438\u043F, \u0437\u0430\u0449\u0438\u0442\u0430, \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u0435,
      \n\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
  - key: note.book_scandic_alphabet.page1.11
    value: "\u041D\u0443\u0436\u0434\u0430, \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435,
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C"
  - key: note.book_scandic_alphabet.page1.14
    value: "\u041B\u0451\u0434, \u0437\u0430\u0441\u0442\u043E\u0439, \u043F\u0430\u0443\u0437\u0430,
      \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E"
  - key: note.book_scandic_alphabet.page1.17
    value: "\u0423\u0440\u043E\u0436\u0430\u0439, \u0446\u0438\u043A\u043B, \u043D\u0430\u0433\u0440\u0430\u0434\u0430
      \u0437\u0430 \u0442\u0440\u0443\u0434"
  - key: note.book_scandic_alphabet.page1.2
    value: "\u0414\u0430\u0440, \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0441\u0442\u0432\u043E,
      \u0441\u043E\u044E\u0437, \u043E\u0431\u043C\u0435\u043D"
  - key: note.book_scandic_alphabet.page1.20
    value: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441,
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435"
  - key: note.book_scandic_alphabet.page1.23
    value: "\u0422\u0430\u0439\u043D\u0430, \u0441\u0443\u0434\u044C\u0431\u0430,
      \u043D\u0435\u0438\u0437\u0432\u0435\u0434\u0430\u043D\u043D\u043E\u0435"
  - key: note.book_scandic_alphabet.page1.26
    value: "\u0417\u0430\u0449\u0438\u0442\u0430, \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
      \u0432\u0432\u0435\u0440\u0445, \u043E\u043F\u043E\u0440\u0430"
  - key: note.book_scandic_alphabet.page1.29
    value: "\u0421\u043E\u043B\u043D\u0446\u0435, \u043F\u043E\u0431\u0435\u0434\u0430,
      \u044F\u0441\u043D\u043E\u0441\u0442\u044C, \u044D\u043D\u0435\u0440\u0433\u0438\u044F"
  - key: note.book_scandic_alphabet.page1.32
    value: "\u0412\u043E\u0438\u043D, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
      \u043F\u043E\u0431\u0435\u0434\u0430, \u0447\u0435\u0441\u0442\u044C"
  - key: note.book_scandic_alphabet.page1.35
    value: "\u0411\u0435\u0440\u0451\u0437\u0430, \u0440\u043E\u0441\u0442, \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435,
      \u0432\u0435\u0441\u043D\u0430"
  - key: note.book_scandic_alphabet.page1.5
    value: "\u0420\u0430\u0434\u043E\u0441\u0442\u044C, \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u044F,
      \u0443\u0441\u043F\u0435\u0445, \u043F\u043E\u0437\u0438\u0442\u0438\u0432"
  - key: note.book_scandic_alphabet.page1.8
    value: "\u0413\u0440\u0430\u0434, \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435,
      \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435, \n\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B"
  - key: note.book_scandic_alphabet.page2.11
    value: "\u041F\u043B\u043E\u0434\u043E\u0440\u043E\u0434\u0438\u0435, \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435,
      \n\u043D\u043E\u0432\u043E\u0435 \u043D\u0430\u0447\u0430\u043B\u043E"
  - key: note.book_scandic_alphabet.page2.14
    value: "\u0420\u043E\u0434\u0438\u043D\u0430, \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435,
      \u043A\u043E\u0440\u043D\u0438, \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438"
  - key: note.book_scandic_alphabet.page2.17
    value: "\u0414\u0435\u043D\u044C, \u043F\u0440\u043E\u0440\u044B\u0432, \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \n\u0440\u0430\u0441\u0441\u0432\u0435\u0442"
  - key: note.book_scandic_alphabet.page2.2
    value: "\u0422\u0438\u0441, \u0437\u0430\u0449\u0438\u0442\u0430, \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
      \u0432\u044B\u0431\u043E\u0440"
  - key: note.book_scandic_alphabet.page2.5
    value: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E,
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u0440\u0430\u0437\u0443\u043C"
  - key: note.book_scandic_alphabet.page2.8
    value: "\u0424\u0430\u043A\u0435\u043B, \u0441\u0442\u0440\u0430\u0441\u0442\u044C,
      \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u043E, \n\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u0435\u043D\u0438\u0435"
  - key: note.dairy_room1_1.page0.1
    value: "    <b>***</b>    \n    \u041A\u043E\u0433\u0434\u0430 \u0422\u044C\u043C\u0430
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0430, \u044F \u0443\u0432\u0438\u0434\u0435\u043B
      \u043B\u0438\u0446\u043E \u0441\u043A\u043B\u043E\u043D\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F
      \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u044B
      \u0432 \u0431\u0435\u043B\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435.
      \u042F \u043B\u0435\u0436\u0430\u043B \u0432 \u0431\u0435\u043B\u043E\u0439
      \u043F\u0430\u043B\u0430\u0442\u0435, \u0430 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0434\u044B\u0448\u0430\u043B\u0438 \u043F\u0440\u0438\u0431\u043E\u0440\u044B.
      \n    \u041F\u0430\u043C\u044F\u0442\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430\u0441\u044C. \u042F
      \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439
      \u0441\u043A\u043B\u0430\u0434, \u0434\u0440\u0435\u0432\u043D\u0438\u0439
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 - \u0437\u0435\u0440\u043A\u0430\u043B\u043E
      \u044D\u043F\u043E\u0445\u0438 \u0426\u0438\u043D. \u0412 \u043D\u0435\u043C
      \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u0421\u0438\u043B\u0430
      \u0438 \u041A\u0430\u0440\u043C\u0430 \u0446\u0435\u043B\u043E\u0439 \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u0438.
      \u042F \u0432\u0437\u044F\u043B\u0441\u044F \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u0435\u0451. \n    \u041F\u043E\u0442\u043E\u043C \u0432\u0441\u0451 \u0437\u0430\u0448\u0430\u0442\u0430\u043B\u043E\u0441\u044C
      \u0438 \u043D\u0430\u0447\u0430\u043B\u043E \u0440\u0443\u0448\u0438\u0442\u044C\u0441\u044F.
      \n    \u042F \u0437\u0430\u043A\u0440\u044B\u043B \u0441\u043E\u0431\u043E\u0439
      \u0437\u0435\u0440\u043A\u0430\u043B\u043E, \u0438 \u043E\u0442\u0431\u043B\u0435\u0441\u043A
      \u0441\u0432\u0435\u0442\u0430 \u0432 \u043D\u0435\u043C \u043E\u0441\u043B\u0435\u043F\u0438\u043B
      \u043C\u043D\u0435 \u0433\u043B\u0430\u0437\u0430. \n    \u041F\u043E\u0441\u043B\u0435
      - \u043C\u0435\u043D\u044F \u043E\u043A\u0443\u0442\u0430\u043B\u0430 \u0422\u044C\u043C\u0430\u2026
      \n    \u041D\u043E \u044F \u043D\u0435 \u0441\u043F\u0430\u043B. \u0422\u0430\u043C
      \u043D\u0435\u0442 \u0441\u043D\u0430. \u042F \u0434\u043E\u043B\u0433\u043E
      \u043D\u0435 \u043C\u043E\u0433 \u043E\u0441\u043E\u0437\u043D\u0430\u0442\u044C
      \u0441\u0435\u0431\u044F \u0446\u0435\u043B\u044B\u043C. \u041F\u043E\u0442\u043E\u043C
      \u044F \u0448\u0451\u043B \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 \u0438
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435. \n    \u0427\u0442\u043E-\u0442\u043E
      \u043A\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C \u043C\u0435\u043D\u044F.
      \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0435 \u0438 \u0448\u0435\u0440\u0448\u0430\u0432\u043E\u0435.
      \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0440\u043E\u0448\u043B\u043E
      \u0432\u0434\u043E\u043B\u044C \u0442\u0435\u043B\u0430, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F, \u0447\u0442\u043E \u044F
      \u0435\u0441\u0442\u044C. \n    \u041F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0448\u043B\u0438
      \u0437\u0432\u0443\u043A\u0438\u2026 \u0428\u043E\u0440\u043E\u0445\u2026 \u0428\u0435\u043F\u043E\u0442\u2026
      \u0414\u0430\u043B\u0435\u043A\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430\u2026\n   
      \u042F \u043F\u043E\u0448\u0435\u043B \u043D\u0430 \u0437\u0432\u0443\u043A.
      \u0412\u043E \u0422\u044C\u043C\u0435 \u0447\u0442\u043E-\u0442\u043E \u0434\u0432\u0438\u0433\u0430\u043B\u043E\u0441\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u043A\u0430\u0441\u0430\u044F\u0441\u044C.
      \u0412\u0435\u043B\u043E \u043C\u0435\u043D\u044F\u2026 \u0417\u0432\u0430\u043B\u043E
      \u043C\u0435\u043D\u044F\u2026 \u042D\u0442\u043E \u0431\u044B\u043B\u0430
      \u0411\u0435\u043B\u0430\u044F \u0417\u043C\u0435\u044F. \n    \u0418 \u0432\u043E\u0442
      \u044F \u0441\u043D\u043E\u0432\u0430 \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438.\n\n   
      ***\n    \u0414\u043E\u043A\u0442\u043E\u0440 \u041C\u043E\u0440\u0440\u043E
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043C\u043D\u0435 \u043E
      \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
      \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043A\u043E\u043C\u0435,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u044F \u043F\u0440\u043E\u0431\u044B\u043B
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0435\u0441\u044F\u0446\u0430.
      \u0418 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0432 \u0435\u0433\u043E \u043A\u043B\u0438\u043D\u0438\u043A\u0435, \u043C\u043D\u0435
      \u0434\u0430\u044E\u0442 \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0413\u0440\u0430\u043D\u044C. \u041E\u043D \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B
      \u043C\u043D\u0435, \u0447\u0442\u043E \u0445\u043E\u0442\u044C \u0435\u0433\u043E
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u0438\u0437 \u043A\u043E\u043C\u044B, \u044D\u0444\u0444\u0435\u043A\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043E\u043D \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0443\u0432\u0435\u0440\u0435\u043D,
      \u0447\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0435\u0433\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C.
      \n    \u0410 \u043F\u043E\u043A\u0430 \u0434\u043B\u044F \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0438\u0434\u044B
      \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438:  \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435
      \u0447\u0430\u0448\u0438, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u043D\u0438\u044F.
      \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043A \u043F\u043E\u0440\u043E\u0448\u043A\u0443 \u0438\u0437 \u043D\u0435\u0444\u0440\u0438\u0442\u0430
      \u0425\u0443\u0430\u043D\u0446\u0438, \u0414\u0430\u043D\u0433\u0443\u0439
      \u0438 \u0424\u0443\u0446\u0437\u044B - \u0442\u0440\u0430\u0432 \u0441 \u043C\u043E\u0435\u0439
      \u0440\u043E\u0434\u0438\u043D\u044B. \n    \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0432
      \u043C\u043E\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437 \u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u043E\u043C,
      \u0434\u043E\u043A\u0442\u043E\u0440 \u043D\u0430\u0437\u0432\u0430\u043B \u044D\u0442\u043E
      \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435\u043C. \n    \u041C\u044B
      \u043E\u0431\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u043C, \u0447\u0442\u043E
      \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0442\u0438.\n\n   
      ***\n    \u0427\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432
      \u044F \u0441\u043D\u043E\u0432\u0430 \u0431\u044B\u043B \u0432\u043E \u0422\u044C\u043C\u0435.
      \u041C\u0435\u043D\u044F \u0443\u0436\u0435 \u0436\u0434\u0430\u043B\u0438.
      \u0411\u0435\u043B\u0430\u044F \u0437\u043C\u0435\u044F \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u043B\u0430
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043C\u0435\u043D\u044F, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044F.
      \u0421\u043E \u0432\u0441\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
      \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u0448\u043E\u0440\u043E\u0445\u0438,
      \u0441\u0432\u0438\u0441\u0442 \u0438 \u0448\u0435\u043F\u043E\u0442, \u0432
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0437\u0432\u0443\u0447\u0430\u043B\u043E
      \u043C\u043E\u0451 \u0438\u043C\u044F. \n    \u042F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u0437\u0430 \u0411\u0435\u043B\u043E\u0439 \u0417\u043C\u0435\u0451\u0439
      \u0438 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0435\u0433\u043E - \u041A\u0440\u0443\u0433 \u0421\u0430\u043D\u0441\u0430\u0440\u044B.
      \n"
  - key: note.dairy_room1_2.page0.1
    value: "\t\n    <b>***</b>\n\u2026\u0414\u043E\u043A\u0442\u043E\u0440 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u0435\u0439
      \u044F \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043F\u0440\u043E\u0432\u043E\u0436\u0443 \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438.
      \u0425\u043E\u0442\u044F \u0438 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0440\u0430\u0437\u043E\u043C \u043C\u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0447\u043D\u0443\u0442\u044C\u0441\u044F.
      \n\n    <b>***</b>\n\u2026\u041F\u0440\u043E\u0448\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      9 \u0447\u0430\u0441\u043E\u0432 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u0438\u2026 \u0430 \u044F \u0443\u0436\u0435
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043F\u044F\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442
      \u0422\u044C\u043C\u0430. \n    \u041C\u043D\u0435 \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043C\u043E\u0451
      \u043C\u0435\u0441\u0442\u043E \u043D\u0435 \u0437\u0434\u0435\u0441\u044C.\n   
      \u041C\u043E\u0440\u0440\u043E \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0431\u043E\u0440\u043E\u0442\u044C \u044D\u0442\u043E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442,
      \u043D\u043E \u044F \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E
      \u043C\u043D\u0435 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E\u2026
      \n    \u042F \u0441\u043C\u043E\u0442\u0440\u044E \u0432 \u043E\u0441\u043A\u043E\u043B\u043A\u0438
      \u0441\u0442\u0435\u043A\u043B\u0430 \u043D\u0430 \u043F\u043E\u043B\u0443
      \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0432\u0441\u0451 \u0447\u0442\u043E
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u2013 \u044D\u0442\u043E
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u041A\u0440\u0443\u0433!"
  - key: note.dairy_room2_1.page0.1
    value: "    <b>10 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\n    \u0412
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439
      \u043F\u043E\u0434 \u041A\u0438\u043E\u0442\u043E \u0441\u0442\u043E\u044F\u043B\u0438
      \u043F\u043E\u043B\u043A\u0438 \u0441 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0438\u043C\u0438
      \u0447\u0430\u0448\u0430\u043C\u0438. \u041C\u0430\u043C\u0430 \u0434\u043E\u0432\u0435\u0440\u044F\u043B\u0430
      \u043C\u043D\u0435 \u0441\u043C\u044B\u0432\u0430\u0442\u044C \u0441 \u043D\u0438\u0445
      \u043F\u044B\u043B\u044C. \u042F \u0437\u043D\u0430\u043B\u0430: \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043D\u0443\u0436\u043D\u043E \u0431\u0435\u0440\u0435\u0436\u043D\u043E,
      \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u0430\u043A \u0434\u0435\u0440\u0436\u0430\u0442 \u043C\u0435\u043D\u044F.\n   
      \u0412 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u044F \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0430 \u0432 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u043C\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u0442\u0440\u0438
      \u0433\u0430\u043B\u0435\u0440\u0435\u0438, \u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043D\u0443\u0436\u043D\u0443\u044E
      \u043A\u0440\u0430\u0441\u043A\u0443 \u044F \u0438\u043D\u043E\u0433\u0434\u0430
      \u043C\u043E\u0433\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E
      \u043D\u043E\u043C\u0435\u0440\u0443 \u043D\u0430 \u0442\u044E\u0431\u0438\u043A\u0435.\n   
      \u041A\u0440\u0438\u0442\u0438\u043A\u0438 \u043F\u0438\u0448\u0443\u0442,
      \u0447\u0442\u043E \u0441 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E
      \u044F \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u043D\u043E\u0432\u044B\u0435
      \u0446\u0432\u0435\u0442\u0430. \u042F \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430.
      \u042F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043F\u0440\u0435\u0436\u043D\u0438\u0435.\n\n   
      <b>12 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\n    \u0414\u043E\u043A\u0442\u043E\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0432\u043E \u0441\u043D\u0435
      \u043C\u043E\u0439 \u043C\u043E\u0437\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0433\u0434\u0435-\u0442\u043E \u044F \u0435\u0449\u0451 \u0443\u043C\u0435\u044E
      \u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0435\u0431\u043E.\n    \u0421\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \xAB\u0413\u0440\u0430\u043D\u044C\xBB. \u041F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0431\u0443\u043C\u0430\u0433\u0443: \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
      \u043F\u043E\u043A\u0430 \u043C\u0435\u043D\u044F \u043D\u0435\u0442."
  - key: note.dairy_room2_1.page0.2
    value: "     ****\n    \u041A\u043B\u0430\u0440\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u044D\u0442\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0438
      \u043C\u043E\u0438. \u041D\u043E \u044F \u043D\u0435 \u0443\u043C\u0435\u044E
      \u0442\u0430\u043A \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C.\n    \u041D\u0435\u0431\u043E
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0431\u0443\u0434\u0443 \u0437\u0430\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C.
      \u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0441\u0438\u043D\u0435\u0433\u043E
      \u043C\u0435\u043B\u043A\u0430\u2026\n\n    \u2013 \u041A\u043E\u0433\u0434\u0430
      \u043F\u0440\u0438\u0434\u0435\u0442 \u043C\u0430\u043C\u0430?\n"
  - key: note.dairy_room2_1.page0.3
    value: "    <b>15 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\n    \u041F\u0440\u043E\u0447\u043B\u0430
      \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C.
      \u041C\u0430\u043C\u0430 \u0443\u043C\u0435\u0440\u043B\u0430 \u043C\u043D\u043E\u0433\u043E
      \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u041D\u0443\u0436\u043D\u043E
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u041A\u043B\u0430\u0440\u0443
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u044D\u0442\u043E\u0433\u043E
      \u0434\u0435\u0432\u043E\u0447\u043A\u0435. \u041D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0435\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C.\n
      \n\u2026\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u041A\u043B\u0430\u0440\u0435
      \u043E Cirque du Soleil. \u041E\u043D\u0430 \u0442\u0430\u043A \u0441\u043B\u0443\u0448\u0430\u043B\u0430,
      \u0447\u0442\u043E \u044F \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0430
      \u0435\u0439 \u0431\u0438\u043B\u0435\u0442 \u043D\u0430 \u0444\u0435\u0432\u0440\u0430\u043B\u044C\u0441\u043A\u0443\u044E
      \u043F\u0440\u0435\u043C\u044C\u0435\u0440\u0443. \u041F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0445\u043E\u0442\u044C \u0440\u0430\u0437 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C \u0447\u0442\u043E-\u0442\u043E, \u043D\u0435
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0435 \u0441 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E.\n\n   
      <b>18 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\n    \u0421\u043D\u043E\u0432\u0430
      \u0441\u043D\u0438\u043B\u0430\u0441\u044C \u0434\u043E\u043B\u0438\u043D\u0430.
      \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043F\u0438\u0441\u0430\u043B\u0430
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E: \u0442\u0430\u043C \u0431\u044B\u043B
      \u0441\u0430\u0434. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0430\u043C
      \u0445\u043E\u0434\u044F\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430,
      \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0443 \u043C\u0435\u043D\u044F
      \u043D\u0435\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0439.\n    \u0420\u0438\u0441\u0443\u044E
      \u0438\u0445 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u044F. \u041D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0445 \u0432 \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u0445.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u043E \u0441\u043D\u0435
      \u0443\u0437\u043D\u0430\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E:
      \u0432\u0447\u0435\u0440\u0430 \u044F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0430
      \u0434\u043E\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u0435\u043C\u0443
      \u0440\u0443\u043A\u0438.\n    \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u043C\u043D\u0435, \u0433\u0434\u0435 \u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C.\n"
  - key: note.dairy_room2_2.page0.1
    value: "                                                                   \u0418\u0437
      \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0425\u0438\u0432\u044B \u0421\u0430\u0431\u0438\n"
  - key: note.dairy_room2_2.page0.2
    value: "    <b>***</b>\n    \u042F \u0437\u0430\u043A\u0440\u0430\u0441\u0438\u043B\u0430
      \u0435\u043C\u0443 \u0433\u043B\u0430\u0437\u0430.\n    \u041E\u043D \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
  - key: note.dairy_room2_2.page0.3
    value: "    <b>19 \u0434\u0435\u043A\u0430\u0431\u0440\u044F</b>\n    \u041A\u043B\u0430\u0440\u0430
      \u043F\u0440\u043E\u0441\u0438\u0442 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F.
      \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043B\u0430
      \u0432\u0441\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u043B\u0443\u0447\u0430.
      \u041F\u043E\u0441\u043B\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u0438\u0445
      \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u043E\u0448\u0438\u0431\u043E\u043A
      \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439. \u041D\u0435\u043B\u044C\u0437\u044F
      \u0443\u0445\u043E\u0434\u0438\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441.\n   
      \u0423 \u043A\u0430\u0440\u0442\u0438\u043D \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
      \u0432\u044B\u0441\u043E\u0442\u0430 \u0438 \u0441\u0432\u0435\u0442. \u042F
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C! \n    \u0417\u0430\u043F\u0438\u0448\u0443
      \u0435\u0449\u0435 \u043D\u0430 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u0435,
      \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439 \u0441\u043B\u0443\u0447\u0430\u0439!\n"
  - key: note.dairy_room2_2.page0.4
    value: "    <b>***</b>\n    \u0412\u0441\u0451 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0417\u043D\u0430\u043A\u0438
      \u0432\u0438\u0434\u043D\u044B.\n    \u2013 \u042F \u0440\u0435\u0448\u0438\u043B\u0430,
      \u0434\u043E\u043A\u0442\u043E\u0440!\n    \u041F\u043E\u0447\u0435\u043C\u0443
      \u0441\u0430\u0434 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F?\n"
  - key: note.dairy_room2_2.page0.5
    value: "    <b>***</b>\n    \u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u043A\u0440\u0430\u0441\u043D\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430. \u041D\u0443\u0436\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043D\u0435\u0451 \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D.\n    \u041C\u043D\u0435 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0433\u043E\u0434\u0430. \u041C\u0435\u043D\u044F
      \u0437\u043E\u0432\u0443\u0442 \u0425\u0438\u0432\u0430 \u0421\u0430\u0431\u0438\u2026\n"
  - key: note.dairy_room2_2.page0.6
    value: "    <b>***</b>\n    \u041C\u0430\u043C\u0430, \u044F \u0431\u043E\u043B\u044C\u0448\u0435
