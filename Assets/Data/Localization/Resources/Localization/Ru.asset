  - key: item.KeyCard.name
    value: "\u041A\u0430\u0440\u0442\u041A\u043B\u044E\u0447"
  - key: item.LensWhite.desc
    value: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043B\u0438\u043D\u0437\u0430
      \u0434\u043B\u044F \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0430"
  - key: item.LensWhite.name
    value: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043B\u0438\u043D\u0437\u0430"
  - key: item.ReactiveColba.desc
    value: "\u0424\u043E\u0441\u0444\u0430\u0442 \u0438\u043C\u0438\u0434\u0430\u0437\u043E\u043F\u0438\u0440\u0438\u0434\u0438\u043D\u043E\u0432\u043E\u0433\u043E
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u043D\u043E\u0433\u043E. \u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439
      \u0440\u0435\u0430\u0433\u0435\u043D\u0442. \u0412\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0432 \u0440\u0435\u0430\u043A\u0446\u0438\u044E \u043F\u0440\u0438 \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u0438
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C\u0438."
  - key: item.ReactiveColba.name
    value: GR-A3
  - key: item.SerumColba.desc
    value: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0442
      \u0441\u0438\u043D\u0442\u0435\u0437\u0430. \u0418\u0437\u043B\u0443\u0447\u0430\u0435\u0442
      \u0441\u043B\u0430\u0431\u043E\u0435 \u0433\u043E\u043B\u0443\u0431\u043E\u0435
      \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435. \u041A\u043B\u044E\u0447
      \u043A \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0435."
  - key: item.SerumColba.name
    value: "\u041F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \"\u0413\u0440\u0430\u043D\u044C\""
  - key: item.SpoiledColba.desc
    value: "\u0421\u043C\u0435\u0441\u044C \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043B\u0438\u043F\u0438\u0434\u043E\u0432, \u043F\u0440\u0438\u043C\u0435\u0441\u0435\u0439
      \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u044B\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432
      \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0435\u0439 \u0444\u0440\u0430\u043A\u0446\u0438\u0438.
      \u0426\u0435\u043B\u0435\u0432\u043E\u0433\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430
      \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442. \u041E\u0431\u0440\u0430\u0437\u0435\u0446
      \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u0435\u043D, \u0434\u043B\u044F
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u0435\u043D. \u041F\u043E\u0434\u043B\u0435\u0436\u0438\u0442
      \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
  - key: item.SpoiledColba.name
    value: "\u0428\u043B\u0430\u043C"
  - key: item.SpoiledColbaBlue.desc
    value: "\u041F\u0440\u0438\u0437\u043D\u0430\u043A\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F.
      \u0426\u0435\u043B\u0435\u0432\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D.
      \u041E\u0431\u0440\u0430\u0437\u0435\u0446 \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u0435\u043D,
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
      \u043F\u043E\u0431\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
      \u041F\u043E\u0434\u043B\u0435\u0436\u0438\u0442 \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
  - key: item.SpoiledColbaBlue.name
    value: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0448\u043B\u0430\u043C"
  - key: item.SpoiledColbaGreen.desc
    value: "\u0410\u0433\u0440\u0435\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u043B\u0438\u043F\u0438\u0434\u044B, \u043F\u0440\u0438\u043C\u0435\u0441\u0438,
      \u0441\u043B\u0435\u0434\u044B \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0435\u0439
      \u0444\u0440\u0430\u043A\u0446\u0438\u0438. \u0426\u0435\u043B\u0435\u0432\u043E\u0433\u043E
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442.
      \u0414\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439
      \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u0435\u043D."
  - key: item.SpoiledColbaGreen.name
    value: "\u0417\u0435\u043B\u0451\u043D\u044B\u0439 \u0448\u043B\u0430\u043C"
  - key: item.stabilazerColba.desc
    value: "\u041F\u042D\u0413-\u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u043B\u0438\u043B\u0430\u043A\u0442\u0438\u0434-\u0441\u043E-\u0433\u043B\u0438\u043A\u043E\u043B\u0438\u0434.
      \u041F\u043E\u0434\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043F\u0440\u0438 \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u0438
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432."
  - key: item.stabilazerColba.name
    value: GR-S4
  - key: item.SubstrateColba.desc
    value: "\u041F\u0435\u043F\u0442\u0438\u0434\u043D\u043E-\u0444\u043E\u0441\u0444\u043E\u043B\u0438\u043F\u0438\u0434\u043D\u0430\u044F
      \u043C\u0430\u0442\u0440\u0438\u0446\u0430 \u0441 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C
      \u0438\u043C\u0438\u0434\u0430\u0437\u043E\u043F\u0438\u0440\u0438\u0434\u0438\u043D\u043E\u0432\u044B\u043C
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u043C. \u041E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0433\u043E\u043C\u043E\u0433\u0435\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D.
      \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u0430\u0432\u0430."
  - key: item.SubstrateColba.name
    value: GR-BA7
  - key: item.UnknownActivatorColba.desc
    value: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u044F.
