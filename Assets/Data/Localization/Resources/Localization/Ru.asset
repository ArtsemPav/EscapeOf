  entries:
  - key: ui.interact.press_button2
    value: "2\u0439 \u044D\u0442\u0430\u0436"
  - key: ui.interact.press_button1
    value: "1\u0439 \u044D\u0442\u0430\u0436"
  - key: credits.Entry_Designer.text
    value: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0422\u0430\u0445\u0430\u0443\u0442\u0434\u0438\u043D\u043E\u0432\n\u0410\u0440\u0442\u0435\u043C
      \u041F\u0430\u0432\u043B\u044E\u0449\u0438\u043A\n\u0410\u043D\u043D\u0430
      \u0416\u0438\u043B\u0435\u043D\u043A\u043E\n\u0421\u0435\u0440\u0433\u0435\u0439
      \u0413\u043E\u0440\u0431\u0430\u0447\u0451\u0432\nBezi"
  - key: credits.Entry_Designer.title
    value: "\u0412 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438:"
  - key: credits.Entry_Story.text
    value: "\u0418\u0441\u043A\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C.\n\u0418\u0441\u0442\u043E\u0440\u0438\u044F
      \u041C\u043E\u0440\u0440\u043E \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A
      \u043A\u043E\u043D\u0446\u0443."
  - key: credits.Entry_Thanks.text
    value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438
      \u043D\u0430\u0448\u0443 \u0438\u0433\u0440\u0443!"
  - key: hints.close.action
    value: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
  - key: hints.close.key
    value: Tab / I
  - key: hints.combine.action
    value: "\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C / \u043A\u0440\u0430\u0444\u0442"
  - key: hints.combine.key
    value: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u044C \u043D\u0430
      \u0441\u043B\u043E\u0442"
  - key: hints.drag.action
    value: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442"
  - key: hints.drag.key
    value: "\u041B\u041A\u041C + \u0442\u0430\u0449\u0438\u0442\u044C"
  - key: hints.rotate.action
    value: "3D-\u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430"
  - key: hints.rotate.key
    value: "\u041F\u041A\u041C"
  - key: item.ActivatorColba.desc
    value: "\u0422\u0435\u0440\u043C\u043E\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441. \u041E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0433\u043E\u043C\u043E\u0433\u0435\u043D\u0435\u043D, \u043F\u0440\u0438\u0433\u043E\u0434\u0435\u043D
      \u0434\u043B\u044F \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
      \u0441\u043E\u0441\u0442\u0430\u0432\u0430."
  - key: item.ActivatorColba.name
    value: GR-BA7t
  - key: item.Bottle1.desc
    value: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u0432\u0438\u043D\u0430 \u0441
      \u0437\u0430\u043C\u044B\u0441\u043B\u043E\u0432\u0430\u0442\u044B\u043C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C.
      \n\u0410\u043B\u043A 15%"
  - key: item.Bottle1.name
    value: "\u0412\u0438\u043D\u043E"
  - key: item.Bottle2.desc
    value: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E
      \u0412\u0435\u0440\u043C\u0443\u0442\u0430.\n\u0410\u043B\u043A 18%"
  - key: item.Bottle2.name
    value: "\u0412\u0435\u0440\u043C\u0443\u0442"
  - key: item.Bottle3.desc
    value: "\u041D\u0435\u043E\u0431\u044B\u0447\u043D\u0430\u044F \u0431\u0443\u0442\u044B\u043B\u043A\u0430
      \u0441 \u0413\u0440\u0430\u043F\u043F\u043E\u0439.\n\u0410\u043B\u043A 40%"
  - key: item.Bottle3.name
    value: "\u0413\u0440\u0430\u043F\u043F\u0430"
  - key: item.Bottle4.desc
    value: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u044F\u0434\u0440\u0435\u043D\u043E\u0439
      \u0413\u0440\u0430\u043F\u043F\u044B. \n\u0410\u043B\u043A 43%"
  - key: item.Bottle4.name
    value: "\u042F\u0434\u0440\u0435\u043D\u0430\u044F \u0433\u0440\u0430\u043F\u043F\u0430"
  - key: item.Bottle5.desc
    value: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u043C\u0430\u043B\u044C\u0442\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0432\u0438\u0441\u043A\u0438.\n\u0410\u043B\u043A 53%"
  - key: item.Bottle5.name
    value: "\u0412\u0438\u0441\u043A\u0438"
  - key: item.Bottle6.desc
    value: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u0441 \u043E\u0447\u0435\u043D\u044C
      \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u0435\u043C.
      \n\u0410\u043B\u043A 60%"
  - key: item.Bottle6.name
    value: "\u0420\u043E\u043C"
  - key: item.CleanColba.desc
    value: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0430\u044F \u0444\u0440\u0430\u043A\u0446\u0438\u044F.
      \u041F\u0440\u0438\u043C\u0435\u0441\u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u044B,
      \u0441\u043E\u0441\u0442\u0430\u0432 \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D
      \u0438 \u0433\u043E\u0442\u043E\u0432 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u044D\u0442\u0430\u043F\u0443."
  - key: item.CleanColba.name
    value: GR-B7*
  - key: item.DataBottleWithGrayLiquid.desc
    value: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u0430\u0433\u0435\u043D\u0442.
      \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0434\u043B\u044F
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438"
  - key: item.DataBottleWithGrayLiquid.name
    value: "\u0420\u0435\u0430\u0433\u0435\u043D\u0442 \u0441 \u0441\u0435\u0440\u043E\u0439
      \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C\u044E"
  - key: item.DataBottleWithWhiteLiquid.desc
    value: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u0430\u0433\u0435\u043D\u0442.
      \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0434\u043B\u044F
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438"
  - key: item.DataBottleWithWhiteLiquid.name
    value: "\u0420\u0435\u0430\u0433\u0435\u043D\u0442 \u0441 \u0431\u0435\u043B\u043E\u0439
      \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C\u044E"
  - key: item.DataBottleWithYellowLiquid.desc
    value: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u0430\u0433\u0435\u043D\u0442.
      \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0434\u043B\u044F
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438"
  - key: item.DataBottleWithYellowLiquid.name
    value: "\u0420\u0435\u0430\u0433\u0435\u043D \u0441 \u0436\u0435\u043B\u0442\u043E\u0439
      \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C\u044E"
  - key: item.DataDiplom.name
    value: "\u0414\u0438\u043F\u043B\u043E\u043C"
  - key: item.DataFlashLight.desc
    value: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A \u0431\u0435\u0437 \u0431\u0430\u0442\u0430\u0440\u0435\u0435\u043A."
  - key: item.DataFlashLight.name
    value: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A"
  - key: item.DataLockPicks.desc
    value: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043D\u0430\u0431\u043E\u0440
      \u0432\u0441\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043E\u0442\u043C\u044B\u0447\u0435\u043A.
      \u0422\u0430\u043A\u0438\u043C\u0438 \u043C\u043E\u0436\u043D\u043E \u043B\u0435\u0433\u043A\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u0430\u0432\u0435\u0441\u043D\u043E\u0439
      \u0437\u0430\u043C\u043E\u043A."
  - key: item.DataLockPicks.name
    value: "\u041D\u0430\u0431\u043E\u0440 \u043E\u0442\u043C\u044B\u0447\u0435\u043A"
  - key: item.DataRune1.desc
    value: "\u0411\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E, \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E,
