  fileName: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \"\u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441\""
  fileIcon: {fileID: 21300000, guid: c46c187235317974e9d8b669521e5ed8, type: 3}
  fileId: 1370cb82-90ca-4a57-a2c0-8bdb7485b8db
  content: "\u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B \xAB\u0420\u0415\u0417\u041E\u041D\u0410\u041D\u0421\xBB\r\n\u041E\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0439
    \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0438\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
    \u0438\u043D\u0435\u0440\u0442\u0435\u043D. \u0414\u043B\u044F \u0437\u0430\u043F\u0443\u0441\u043A\u0430
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C
    \u0430\u043A\u0442\u0438\u0432\u0430\u0442\u043E\u0440.\r\n\r\n\u041F\u043E\u0441\u043B\u0435
    \u0438\u0445 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0439:
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0439 \u0441\u043C\u0435\u0441\u0438
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0442\u0435\u043F\u043B\u0430.\r\n\r\n[\u041E\u0428\u0418\u0411\u041A\u0410
    \u0427\u0422\u0415\u041D\u0418\u042F. \u0417\u0410\u041A\u041B\u042E\u0427\u0418\u0422\u0415\u041B\u042C\u041D\u042B\u0419
    \u0411\u041B\u041E\u041A \u041F\u041E\u0412\u0420\u0415\u0416\u0414\u0401\u041D.]"
