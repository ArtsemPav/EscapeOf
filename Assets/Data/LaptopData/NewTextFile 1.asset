  m_Script: {fileID: 11500000, guid: c2566b79749dfc64087e5d1f70759f37, type: 3}
  m_Name: NewTextFile 1
  m_EditorClassIdentifier: Assembly-CSharp::EscapeOf.Puzzle.Laptop.LaptopTextFile
  fileName: Patient 2
  fileIcon: {fileID: 21300000, guid: c46c187235317974e9d8b669521e5ed8, type: 3}
  fileId: 4
  content: "\xAB\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u044B \u0410\u043D\u043D\u044B
    \u0418\u0432\u0430\u043D\u043E\u0432\u043D\u044B\r\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0434\u043E\u043A\u0442\u043E\u0440 \u041C\u043E\u0440\u0440\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B
    \u043C\u043D\u0435 \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442.
    \xAB\u0413\u0440\u0430\u043D\u044C\xBB, \u043D\u0430\u0437\u0432\u0430\u043B
    \u043E\u043D \u0435\u0433\u043E. \u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
    \u044D\u0442\u043E \u043A\u043B\u044E\u0447 \u043A \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443.
    \u0427\u0442\u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u043C\u0435\u0436\u0434\u0443
    \u043C\u0438\u0440\u0430\u043C\u0438, \u0441\u043C\u043E\u0433\u0443\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F,
    \u0435\u0441\u043B\u0438 \u0432\u0432\u0435\u0441\u0442\u0438 \u0438\u043C \u044D\u0442\u043E
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E.\r\n\u042F \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430,
    \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B \u043B\u0438 \u043E\u043D \u0441\u0430\u043C.\r\n\u041E\u043D
    \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043B. \u041F\u043E\u0442\u043E\u043C
    \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u041F\u0440\u043E\u0431\u043E\u0432\u0430\u043B.
    \u041D\u0430 \u0441\u0435\u0431\u0435. \u042F \u0432\u0432\u043E\u0434\u0438\u043B
    \u0435\u0433\u043E \u0442\u0440\u0438\u0436\u0434\u044B. \u041A\u0430\u0436\u0434\u044B\u0439
    \u0440\u0430\u0437 \u044F \u0432\u0438\u0434\u0435\u043B \u0441\u0432\u0435\u0442,
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B, \u043A\u0430\u043A
    \u0442\u0435\u043B\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0447\u0443\u0436\u0438\u043C. \u041D\u043E \u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043B.
    \u042F \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u043D\u0430 \u0433\u0440\u0430\u043D\u0438.
    \u041F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u0434\u0432\u0435\u0440\u044C. \u041E\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043E\u043A\u043D\u043E. \u0422\u044B \u0432\u0438\u0434\u0438\u0448\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
    \u043D\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0434\u043E \u043D\u0435\u0451
    \u0434\u043E\u0442\u0440\u043E\u043D\u0443\u0442\u044C\u0441\u044F\xBB\r\n\u042F
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430, \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442,
    \u0435\u0441\u043B\u0438 \u0432\u0432\u0435\u0441\u0442\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043C\u043D\u043E\u0433\u043E.\r\n\u041E\u043D \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u043D\u0430 \u043C\u0435\u043D\u044F. \u0413\u043B\u0430\u0437\u0430 \u0443
    \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438 \u043F\u0443\u0441\u0442\u044B\u0435.
    \u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0421\u0435\u0440\u0434\u0446\u0435
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F. \u0422\u044B
    \u0443\u0432\u0438\u0434\u0438\u0448\u044C \u0432\u0441\u0451. \u0418 \u0443\u043C\u0440\u0451\u0448\u044C,
    \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C\xBB\r\n\u042F
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430, \u0437\u0430\u0447\u0435\u043C
    \u0442\u043E\u0433\u0434\u0430 \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442.\r\n\u041E\u043D
    \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F. \xAB\u0414\u043B\u044F
    \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F. \u0414\u043B\u044F
    \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442
    \u0441\u043C\u0435\u0440\u0442\u044C \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C\u0443
    \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443\xBB\r\n\u042F \u043D\u0435 \u0437\u043D\u0430\u044E,
    \u0447\u0442\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435. \u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
    \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
    \u0418\u043B\u0438 \u0443\u0439\u0442\u0438 \u0442\u0443\u0434\u0430, \u043E\u0442\u043A\u0443\u0434\u0430
    \u043D\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430.\r\n\u041C\u043D\u0435
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u043E\u043A\u0442\u043E\u0440
    \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B \u0441\u0432\u043E\u0439
    \u0432\u044B\u0431\u043E\u0440. \u041E\u043D \u043F\u0440\u043E\u0441\u0442\u043E
    \u0435\u0449\u0451 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F
    \u0441\u0435\u0431\u0435 \u0432 \u044D\u0442\u043E\u043C\xBB\r\n"
