  fileName: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \"\u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441\""
  fileIcon: {fileID: 21300000, guid: c46c187235317974e9d8b669521e5ed8, type: 3}
  fileId: 1370cb82-90ca-4a57-a2c0-8bdb7485b8db
  content: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    #1\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    C.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u043D\u0430\u0433\u0440\u0435\u0442\u044C
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 C.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F:
    \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043E\u0447\u0438\u0441\u0442\u043A\u0438.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u043F\u0440\u0438 \u043D\u0430\u0433\u0440\u0435\u0432\u0435
    \u043C\u0435\u043D\u044F\u0435\u0442 \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u044E,
    \u043D\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442
    \u043D\u0435\u0446\u0435\u043B\u0435\u0432\u043E\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u043D\u0430\u0433\u0440\u0435\u0432
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 C \u0434\u043E \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u044F
    \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C. \r\n\n-------------------------------------------------------------------------------\r\n\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #2\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0411.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u043D\u0430\u0433\u0440\u0435\u0442\u044C \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0411.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u043F\u0440\u0438 \u043D\u0430\u0433\u0440\u0435\u0432\u0435 \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442
    \u0432 \u0446\u0435\u043B\u0435\u0432\u043E\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u2014 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F
    \u043D\u0435 \u0442\u0430.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \xAB\u0441\u043F\u0435\u043A\u0430\u0435\u0442\u0441\u044F\xBB, \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0439
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0411 \u043D\u0435\u043B\u044C\u0437\u044F \u0433\u0440\u0435\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E.
    \u0415\u0433\u043E \u0440\u043E\u043B\u044C \u2014 \u043D\u0435 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #3\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0416.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u043D\u0430\u0433\u0440\u0435\u0442\u044C \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0416.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u043F\u0440\u0438 \u043D\u0430\u0433\u0440\u0435\u0432\u0435 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044F
    \u2014 \u0446\u0435\u043B\u0435\u0432\u043E\u0433\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430
    \u043D\u0435\u0442.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0446\u0432\u0435\u0442\u0430
    \u0438 \u0437\u0430\u043F\u0430\u0445\u0430, \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u043D\u0430\u0433\u0440\u0435\u0432
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432 \u043F\u043E
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0432 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0435
    \u043D\u0435\u0432\u0435\u0440\u0435\u043D. \u041D\u0430\u0433\u0440\u0435\u0432
    \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F
    \u043A \u0441\u043C\u0435\u0441\u0438, \u0430 \u043D\u0435 \u043A \u0447\u0438\u0441\u0442\u044B\u043C
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430\u043C.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #4\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0416.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0416.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u043F\u043E\u043F\u044B\u0442\u043A\u0430
    \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u0441\u0438
    \u0438\u0437 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u043F\u0440\u0438\u043C\u0435\u0441\u0438 \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F,
    \u0430 \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0432 \u0440\u0435\u0430\u043A\u0446\u0438\u044E
    \u0441 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0435\u043C; \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u043E\u0447\u0438\u0441\u0442\u043A\u0430
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430 \u0432 \u0447\u0438\u0441\u0442\u043E\u043C
    \u0432\u0438\u0434\u0435 \u043F\u043E\u0440\u0442\u0438\u0442 \u0435\u0433\u043E.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #5\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0411.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0411.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u043F\u0440\u0438 \u043E\u0447\u0438\u0441\u0442\u043A\u0435 \u0442\u0435\u0440\u044F\u0435\u0442
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0440\u0430\u0441\u0442\u0432\u043E\u0440 \u043C\u0443\u0442\u043D\u0435\u0435\u0442,
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u043E\u0447\u0438\u0441\u0442\u043A\u0430
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430 \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u0430.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #6\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0421.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0421.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u0438\u0437 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430
    \u0443\u0434\u0430\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u0441\u0438,
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442,
    \u043F\u0440\u0438\u043C\u0435\u0441\u0438 \u0443\u0445\u043E\u0434\u044F\u0442
    \u0432 \u043E\u0441\u0430\u0434\u043E\u043A; \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442 \u0447\u0438\u0441\u0442\u044B\u0439
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0439 \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442
    (\u041E\u0421).\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430
    \u0421 \u0434\u0430\u0451\u0442 \u0442 \u041E\u0421. \u0420\u0435\u0430\u0433\u0435\u043D\u0442
    \u0421 \u2014 \xAB\u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439\xBB
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0446\u0435\u043F\u043E\u0447\u043A\u0438.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #7\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041E\u0421.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u043D\u0430\u0433\u0440\u0435\u0442\u044C
    \u041E\u0421.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u041E\u0421
    \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D
    \u2014 \u043F\u0440\u0438 \u043D\u0430\u0433\u0440\u0435\u0432\u0435 \u0440\u0430\u0441\u043F\u0430\u0434\u0430\u0435\u0442\u0441\u044F.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043D\u0438\u0435, \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u041E\u0421
    \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u044C\u044C \u043D\u0435\u043B\u044C\u0437\u044F.
    \r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #8\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041E\u0421, \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0421.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u0441\u043C\u0435\u0448\u0430\u0442\u044C \u041E\u0421 \u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0421.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u041E\u0421 \u0438
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0421 \u043D\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442
    \u0446\u0435\u043B\u0435\u0432\u043E\u0433\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u043E\u0441\u0430\u0434\u043E\u043A,
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0421 \u0438 \u041E\u0421 \u2014 \u043D\u0435\u0432\u0435\u0440\u043D\u0430\u044F
    \u043F\u0430\u0440\u0430.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #9\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041E\u0421, \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0411.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u0441\u043C\u0435\u0448\u0430\u0442\u044C \u041E\u0421 \u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0411.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u041E\u0421 \u0438
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0411 \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E\u0442
    \u2014 \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u043D\u0430 \u044D\u0442\u043E\u043C \u044D\u0442\u0430\u043F\u0435.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0441\u043C\u0435\u0441\u044C \u0440\u0430\u0441\u0441\u043B\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0411 \u0438 \u041E\u0421 \u2014 \u043D\u0435\u0432\u0435\u0440\u043D\u0430\u044F
    \u043F\u0430\u0440\u0430.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #10\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041E\u0421, \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0416.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
    \u0441\u043C\u0435\u0448\u0430\u0442\u044C \u041E\u0421 \u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0416.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u041E\u0421 \u0438
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0416 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
    \u043D\u043E\u0432\u043E\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u0441\u043C\u0435\u0441\u044C \u0442\u0435\u043F\u043B\u0435\u0435\u0442, \u0446\u0432\u0435\u0442
    \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439;
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442
    \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u044B\u0439 \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442
    (\u041F\u0421).\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u044B\u0439 \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442.\r\n\r\n\u0412\u044B\u0432\u043E\u0434:
    \u041E\u0421 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0416. \u041E\u0421 + \u0440\u0435\u0430\u0433\u0435\u043D\u0442
    \u0416 = \u041F\u0421 \u2014 \u043A\u043B\u044E\u0447\u0435\u0432\u0430\u044F
    \u0440\u0430\u0431\u043E\u0447\u0430\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #11\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041F\u0421.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
    \u041F\u0421 \u043D\u0430 \u0446\u0435\u043D\u0442\u0440\u0438\u0444\u0443\u0433\u0435.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F:
    \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u043B\u0430\u0431\u0438\u043B\u044C\u043D\u0443\u044E
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u041F\u0421.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u041F\u0421 \u0440\u0430\u0441\u0441\u043B\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u2014 \u0448\u043B\u0430\u043C.\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0448\u043B\u0430\u043C.\r\n\r\n\u0412\u044B\u0432\u043E\u0434: \u041F\u0421
    \u043E\u0447\u0438\u0449\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F.
    \u0426\u0435\u043D\u0442\u0440\u0438\u0444\u0443\u0433\u0430 \u043F\u043E\u0440\u0442\u0438\u0442
    \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442.\r\n\n-------------------------------------------------------------------------------\n\r\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #12\r\n\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0435:
    \u041F\u0421.\r\n\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u043D\u0430\u0433\u0440\u0435\u0442\u044C
    \u041F\u0421.\r\n\r\n\u0420\u0435\u0430\u043A\u0446\u0438\u044F: \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F \u041F\u0421 \u2192 \u0434\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B, \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
    \u043D\u043E\u0432\u043E\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043D\u0438\u0435.\r\n\r\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435:
    \u041F\u0421 \u043F\u0440\u0438 \u043D\u0430\u0433\u0440\u0435\u0432\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F,
    \u0446\u0432\u0435\u0442 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F;
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u0440\u043C\u043E\u0430\u043A\u0442\u0438\u0432\u0430\u0442\u043E\u0440
    (\u0422\u0410).\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0440\u0435\u0430\u0433\u0435\u043D\u0442 \u0442\u0435\u0440\u043C\u043E\u0430\u043A\u0442\u0438\u0432\u0430\u0442\u043E\u0440.\r\n\r\n\u0412\u044B\u0432\u043E\u0434:
    \u043D\u0430\u0433\u0440\u0435\u0432 \u041F\u0421 \u2014 \u0432\u0435\u0440\u043D\u044B\u0439
    \u0448\u0430\u0433. \u042D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439 \u043D\u0430\u0433\u0440\u0435\u0432
    \u0432 \u0446\u0435\u043F\u043E\u0447\u043A\u0435.\n\n-------------------------------------------------------------------------------\n\n\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 #13 \n\n\u041E\u0448\u0438\u0431\u043A\u0430
    \u0447\u0442\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445......\n"
