    \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442. \u041E\u0431\u0440\u0430\u0437\u0435\u0446
    \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u0435\u043D, \u0434\u043B\u044F
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
