  itemName: "\u0428\u043B\u0430\u043C"
  description: "\u0421\u043C\u0435\u0441\u044C \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u043B\u0438\u043F\u0438\u0434\u043E\u0432, \u043F\u0440\u0438\u043C\u0435\u0441\u0435\u0439
    \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u044B\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432
