  pages:
  - "\u042D\u0442\u043E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0431\u044B\u043B
    \u0441\u043E\u0437\u0434\u0430\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F
    \u0442\u043E\u0433\u043E. \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u043A\u0430\u043A \u0432\u0435\u0434\u0435\u0442 \u0441\u0435\u0431\u044F \u043D\u043E\u0432\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0442\u0435\u043A\u0441\u0442\u043E\u0432.   
    \u043E\u043D\u0430 \u043D\u0443\u0436\u043D\u0430 \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F
    \u0437\u0430\u043F\u0438\u0441\u043E\u043A\u044E.  \u043A\u043D\u0438\u0433. 
    \u0436\u0443\u0440\u043D\u0430\u043B\u043E\u0432 \u0438\u0442\u0434.  \u043C\u043D\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u0447\u0435 \u0441\u0432\u044F\u043A\u043E\u0439 \u0431\u0438\u043B\u0438\u0431\u0435\u0440\u0434\u044B.  "
  - "\u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0447\u043A\u0435
