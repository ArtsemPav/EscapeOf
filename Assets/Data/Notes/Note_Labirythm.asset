  m_Name: Note_Labirythm
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  title: 
  pages:
  - "\u041D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u0441\u0435 \u0441\u043B\u043E\u0432\u0430 \u0432\u043F\u043B\u0435\u0442\u0430\u0442\u044C
    \u0432 \u0443\u0437\u043E\u0440,\r\n\u041D\u043E \u0420\u043E\u0434\u0438\u043D\u0430
    \u0441\u043B\u044B\u0448\u043D\u0430 \u0432 \u0434\u044B\u0445\u0430\u043D\u0438\u0438
    \u0432\u0435\u0442\u0432\u0435\u0439,\r\n\u0413\u0434\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0448\u043B\u0435\u0442 \u0441\u043A\u0432\u043E\u0437\u044C \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440\r\n\u0422\u0440\u0430\u0434\u0438\u0446\u0438\u044F\u043C
    \u2014 \u0438 \u043A\u043E\u0440\u043D\u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F
    \u0438\u0437 \u043D\u0435\u0439.\r\n\r\n\u041F\u0440\u0438\u043C\u0438 \u043C\u043E\u0439
    \u0414\u0430\u0440 \u2014 \u043D\u0435 \u0433\u0440\u0443\u0437, \u0430 \u043B\u0435\u0433\u043A\u0438\u0439
    \u0441\u0432\u0435\u0442,\r\n\u0412 \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u0441\u0442\u0432\u0435
    \u0440\u0443\u043A \u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0441\u043E\u044E\u0437.\r\n\u041E\u0431\u043C\u0435\u043D
    \u0431\u0435\u0437 \u0441\u043B\u043E\u0432 \u2014 \u0438 \u0432\u043E\u0442
    \u0443\u0436 \u0442\u044B \u0441\u043E\u0433\u0440\u0435\u0442,\r\n\u041A\u043E\u0433\u0434\u0430
    \u0442\u0435\u0440\u044F\u0435\u0448\u044C \u0441\u0447\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0445
    \u043C\u0438\u043D\u0443\u0442.\r\n\r\n\u042F \u0432\u043D\u043E\u0432\u044C
    \u043D\u0435\u0441\u0443 \u0441\u0432\u043E\u0439 \u0414\u0430\u0440 \u0441\u043A\u0432\u043E\u0437\u044C
    \u0448\u0443\u043C \u0434\u043E\u0436\u0434\u044F,\r\n\u041F\u0430\u0440\u0442\u043D\u0435\u0440\u0441\u0442\u0432\u043E
    \u043A\u0440\u0435\u043F\u0447\u0435 \u0441\u0442\u0430\u043B\u0438 \u0432 \u0447\u0430\u0441
    \u0431\u0435\u0434\u044B,\r\n\u0421\u043E\u044E\u0437 \u2014 \u043D\u0435 \u043A\u043B\u044F\u0442\u0432\u0430,
    \u0430 \u0441\u0443\u0434\u044C\u0431\u0430, \u0432\u043E\u0436\u0434\u044F\r\n\u0414\u043E\u0441\u0442\u043E\u0439\u043D\u0430\u044F,
    \u0433\u0434\u0435 \u043D\u0435\u0442 \u043F\u0443\u0441\u0442\u043E\u0439 \u0432\u043E\u0434\u044B.\r\n\r\n\u0417\u0430\u0449\u0438\u0442\u0430
    \u2014 \u0449\u0438\u0442, \u043D\u043E \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
    \u0432\u0432\u0435\u0440\u0445 \u2014 \u043C\u0435\u0447\u0442\u0430,\r\n\u041E\u043F\u043E\u0440\u0430
    \u2014 \u0442\u0432\u0435\u0440\u0434\u044C, \u0433\u0434\u0435 \u0441\u0442\u0440\u043E\u044F\u0442,
    \u0430 \u043D\u0435 \u0436\u0433\u0443\u0442.\r\n\u0418 \u0432 \u044D\u0442\u043E\u0439
    \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438 \u043A\u0440\u0430\u0441\u043E\u0442\u0430,\r\n\u0413\u0434\u0435
    \u043A\u043E\u0440\u043D\u0438 \u043F\u0440\u043E\u0448\u043B\u044B\u0445 \u043B\u0435\u0442
    \u0433\u0440\u044F\u0434\u0443\u0449\u0435\u0435 \u0440\u0430\u0441\u0442\u0443\u0442."
