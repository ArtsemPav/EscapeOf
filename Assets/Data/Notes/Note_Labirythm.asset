  m_Name: Note_Labirythm
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  title: 
  pages:
  - "\xAB\u0427\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u043E \u0441\u043F\u043B\u0435\u0441\u0442\u0438
    \u043D\u0438\u0442\u0438 \u043C\u0430\u0433\u0438\u0438 \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u0440\u0443\u043D\u044B \u0432 \u0435\u0434\u0438\u043D\u0443\u044E \u0446\u0435\u043F\u044C,
    \u043D\u0435\u0443\u043A\u043E\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0439 \u0442\u0440\u0438 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
    \u0437\u0430\u043A\u043E\u043D\u0430 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0442\u043E\u043A\u0430\xBB:\r\n\r\n\u041D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u044C
    \u0442\u043E\u043A\u0430.\r\n\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u0442\u0435\u0447\u0451\u0442
    \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E \u0445\u043E\u0434\u0443 \u043D\u0430\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F
    \u0440\u0443\u043D\u044B \u2014 \u043E\u0442 \u0438\u0441\u0442\u043E\u043A\u0430
    \u043A \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044E. \u0417\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E
    \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0442\u044C \u043F\u043E\u0442\u043E\u043A,
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043A
    \u0443\u0436\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u043E\u043C\u0443
    \u0437\u0432\u0435\u043D\u0443 \u0438\u043B\u0438 \xAB\u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C\xBB
    \u043B\u0438\u043D\u0438\u044E \u0437\u0430\u0434\u043D\u0438\u043C \u0445\u043E\u0434\u043E\u043C.
    \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043C\u0430\u0433\u0438\u0438
    \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434,
    \u043F\u043E \u0441\u043F\u0438\u0440\u0430\u043B\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430.\r\n\r\n\u041F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u044C
    \u043B\u0438\u043D\u0438\u0439.\r\n\u0420\u0443\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0432\u044F\u0437\u044C \u043D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442 \u0443\u0433\u043B\u043E\u0432\u0430\u0442\u044B\u0445
    \u0438\u0437\u043B\u043E\u043C\u043E\u0432 \u0438 \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432. \u0412\u0441\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B
    \u043C\u0435\u0436\u0434\u0443 \u0440\u0443\u043D\u0430\u043C\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u0442\u044C \u043F\u043B\u0430\u0432\u043D\u044B\u043C\u0438, \u0441\u043B\u043E\u0432\u043D\u043E
    \u0432\u044B\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u043E\u0434\u043D\u0438\u043C
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u043A\u0438\u0441\u0442\u0438.
    \u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u044C
    \u0434\u0443\u0433\u0438, \u0431\u0435\u0437 \u043E\u0441\u0442\u0440\u044B\u0445
    \xAB\u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439\xBB \u0438 \u0441\u043A\u0430\u0447\u043A\u043E\u0432
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\r\n\r\n\u0421\u0430\u043A\u0440\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A.\r\n\u041C\u0430\u0441\u0442\u0435\u0440
    \u043E\u0431\u044F\u0437\u0430\u043D \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0440\u0443\u043D\u044B \u0438\u043C\u0435\u043D\u043D\u043E \u0432 \u0442\u043E\u043C
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435, \u0432 \u043A\u0430\u043A\u043E\u043C
    \u043E\u043D\u0438 \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u044B
    \u0441\u0432\u0438\u0442\u043A\u043E\u043C-\u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C.
    \u041D\u0438 \u043E\u0434\u043D\u0443 \u0440\u0443\u043D\u0443 \u043D\u0435\u043B\u044C\u0437\u044F
    \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0439
    \u2014 \u0438\u043D\u0430\u0447\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u0430
    \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u0438\u043B\u0443. \u0422\u043E\u043B\u044C\u043A\u043E
    \u0441\u0442\u0440\u043E\u0433\u043E\u0435 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u0446\u0435\u043F\u043E\u0447\u043A\u0435 \u0437\u043D\u0430\u043A\u043E\u0432
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044C
    \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0439 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0440\u0443\u0433."
