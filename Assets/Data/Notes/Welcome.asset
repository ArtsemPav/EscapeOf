  title: "\u0435\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0448\u044C"
  content: "\u0437\u043D\u0430\u0447\u0438\u0442 \u0432\u0441\u0435 \u043F\u043E\u0448\u043B\u043E
    \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443.
    \u0412\u0441\u0435 \u0440\u0430\u0434\u0438 \u0447\u0435\u0433\u043E \u043C\u044B
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0440\u0443\u0445\u043D\u0443\u043B\u043E.
    \u0430 \u0432\u0435\u0434\u044C \u044F \u0442\u0435\u0431\u044F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B!"
