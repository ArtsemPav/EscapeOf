  m_Script: {fileID: 11500000, guid: 8f0ece008fac77f4287466e5199d9083, type: 3}
  m_Name: Note_MorroDairy
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  title: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u041C\u043E\u0440\u0440\u043E"
  pages:
  - "\u041C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u043E
    \u043A\u0443\u0434\u0430 \u0443\u0445\u043E\u0434\u044F\u0442 \u043B\u044E\u0434\u0438
    \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438. \u0427\u0442\u043E
    \u0436\u0434\u0451\u0442 \u043D\u0430\u0441 \u0437\u0430 \u0447\u0435\u0440\u0442\u043E\u0439
    \u0438 \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0442\u0435\u0445 \u043A\u0442\u043E \u0443\u0448\u0435\u043B \u043D\u0435\u0434\u0430\u0432\u043D\u043E.
    \u041F\u043E\u0437\u0432\u0430\u0442\u044C \u043D\u0430\u0437\u0430\u0434,  \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u043F\u0443\u0442\u044C \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u043C\u043E\u0439.\r\n\u041C\u043E\u044F
    \u043C\u0430\u0442\u044C, \u043D\u0430\u0431\u043E\u0436\u043D\u0430\u044F \u0436\u0435\u043D\u0449\u0438\u043D\u0430,
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
    \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438
    \u043D\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u0435\u0442 \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F
    \u0438\u043B\u0438 \u0421\u0443\u0434. \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043B\u0438\u0446\u0435\u0442\u0432\u043E\u0440\u044F\u044E\u0442
    \u0432\u0441\u044E \u043D\u0430\u0448\u0443 \u0436\u0438\u0437\u043D\u044C \u0438
    \u0435\u0441\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
    \u0432\u044B\u0431\u043E\u0440 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
    \u043D\u0430\u0433\u0440\u0430\u0434\u0443 \u043D\u0430 \u0432\u044B\u0431\u043E\u0440
    - \u043F\u0440\u043E\u0445\u043E\u0434 \u043D\u0430 \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u0438\u043B\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u0432 \u044D\u0442\u0443
    \u0436\u0438\u0437\u043D\u044C. \u0412 \u0441\u043B\u0443\u0447\u0430\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
    \u0442\u044B \u0442\u0435\u0440\u044F\u0435\u0448\u044C \u0432\u0441\u0451 -
    \u0441\u0432\u0435\u0442, \u0436\u0438\u0437\u043D\u044C, \u043F\u043E\u043A\u043E\u0439.\r\n\u0421
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435\u043C
    \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
    \u0442\u0435\u0431\u0435 \u0432 \u044D\u0442\u043E\u043C \u043F\u043E\u043C\u043E\u0447\u044C.\r\n\u041F\u0440\u0438
    \u044D\u0442\u043E\u043C \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u043D\u0430\u0441
    \u0443\u0447\u0438\u0442 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u043C.
    \u0418 \u044D\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C: \u043F\u043E\u043C\u043E\u0433\u0438
    \u0431\u043B\u0438\u0436\u043D\u0435\u043C\u0443 \u0441\u0432\u043E\u0435\u043C\u0443.
    \u041D\u043E \u0432 \u0447\u0435\u043C \u0442\u043E\u0433\u0434\u0430 \u0441\u043C\u044B\u0441\u043B?
    \u0412\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u0438\u0434\u0442\u0438 \u0441
    \u043A\u0435\u043C-\u0442\u043E \u043F\u043E \u043F\u0443\u0442\u0438, \u0440\u0435\u0448\u0430\u0442\u044C
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438
    \u0438 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B, \u0430 \u043F\u043E\u0442\u043E\u043C
    \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0434\u0438\u043D \u043D\u0430
    \u043E\u0434\u0438\u043D \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u044C\u044E.\r\n"
  - "\u042D\u0442\u043E\u0442 \u0434\u0438\u0441\u0441\u043E\u043D\u0430\u043D\u0441
    \u043F\u043E\u0441\u0435\u043B\u0438\u043B \u0432\u043E \u043C\u043D\u0435 \u0442\u0432\u0451\u0440\u0434\u0443\u044E
    \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0447\u0442\u043E
    \u0438 \u0422\u0430\u043C, \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u043A\u0442\u043E-\u0442\u043E \u043A\u0442\u043E \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043C\u043E\u0447\u044C \u043F\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
    \u0438\u043B\u0438  \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0434\u043E\u043C\u043E\u0439.\r\n"
  - "\u201C\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0439
    \u0434\u0440\u0443\u0433\u0438\u043C \u0438 \u0441\u043B\u0435\u0434\u0443\u0439
    \u0441\u043B\u043E\u0432\u0443 \u0411\u043E\u0436\u044C\u0435\u043C\u0443\u201D,
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u043C\u0430\u043C\u0430.\r\n\u042D\u0442\u043E
    \u0438 \u0441\u0442\u0430\u043B\u043E \u043C\u043E\u0438\u043C \u0441\u043C\u044B\u0441\u043B\u043E\u043C
    \u0436\u0438\u0437\u043D\u0438.  \u041F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
    \u0434\u0440\u0443\u0433\u0438\u043C, \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u044B,
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u044B\u0445\u043E\u0434.\r\n\u0410
    \u043A\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0430 \u043F\u043E\u0440\u043E\u0433\u0435
    \u043C\u0435\u0436\u0434\u0443 \u0436\u0438\u0437\u043D\u044C\u044E \u0438 \u0441\u043C\u0435\u0440\u0442\u0438,
    \u043A\u0430\u043A \u043D\u0435 \u0432\u0440\u0430\u0447. \u041C\u043E\u0439
    \u043F\u0443\u0442\u044C \u043F\u0440\u0438\u0432\u0435\u043B \u043C\u0435\u043D\u044F
    \u0432 \u043D\u0435\u0439\u0440\u043E\u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0438\u044E.
    \r\n"
  - "\u041E\u0442\u0435\u0446 \u043A\u0430\u043A-\u0442\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u043B
    \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u043D\u0435 \u043F\u043E\u0448\u0435\u043B
    \u0432 \u0445\u0438\u0440\u0443\u0440\u0433\u0438. \r\n\u042F \u043E\u0442\u0432\u0435\u0442\u0438\u043B:
    \r\n\u201C\u0425\u0438\u0440\u0443\u0440\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0441\u043A\u0430\u043B\u044C\u043F\u0435\u043B\u0435\u043C \u0438 \u043C\u043E\u0436\u0435\u0442
    \u0437\u0430\u043D\u043E\u0432\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0442\u0435\u043B\u043E, \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u0443\u044E
    \u0442\u043A\u0430\u043D\u044C \u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u044B\u0439 \u043E\u0440\u0433\u0430\u043D.
    \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0447\u044C \u0438\u0434\u0435\u0442
    \u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
    \u0438\u0437 \u043A\u043E\u043C\u044B - \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0434\u043E\u043C\u043E\u0439
    \u2014 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u043F\u0430\u043C\u044F\u0442\u044C
    \u0438 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435, \u0430 \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0435\u043B\u043E.\r\n\u0410 \u0434\u043B\u044F
    \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0435\u0433\u043E \u043C\u043E\u0437\u0433.\r\n\u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u043E\u0437\u0433 \u2013 \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0438 \u0441\u0430\u043C\u044B\u0439 \u0441\u043B\u043E\u0436\u043D\u044B\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0438\u0445 \u043F\u043E\u0440
    \u0442\u0430\u043A \u043C\u0430\u043B\u043E \u0438\u0437\u0443\u0447\u0435\u043D.
    \u0412 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u043A \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044F
    \u0440\u0435\u0448\u0430\u0435\u0442 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438, \u043D\u0435\u0439\u0440\u043E\u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0438\u044F
    \u0432\u0435\u0434\u0435\u0442 \u0442\u043E\u043D\u0447\u0430\u0439\u0448\u0443\u044E
    \u0431\u0438\u043E\u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0438 \u0444\u0438\u0437\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0431\u043E\u0440\u044C\u0431\u0443 \u0437\u0430 \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0438\u0439
    \u0440\u0430\u0437\u0443\u043C. \u0421\u0442\u0430\u0442\u044C \u043D\u0435\u0439\u0440\u043E\u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u043E\u043C
    \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C \u043A\u0440\u0430\u0435
    \u043D\u0430\u0443\u043A\u0438 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439
    \u0434\u0435\u043D\u044C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0440\u0430\u0437\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0442\u0430\u0439\u043D\u044B
    \u043C\u043E\u0437\u0433\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438\u0437 \u043A\u043E\u043C\u044B
    \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0438\u0442\u044C \u0440\u043E\u0434\u043D\u044B\u043C
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0438\u0432\u043E\u0435
    \u0442\u0435\u043B\u043E, \u0430 \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u043E,
    \u043A\u043E\u0433\u043E \u043E\u043D\u0438 \u043B\u044E\u0431\u044F\u0442.\r\n\u0415\u0441\u043B\u0438
    \u0431\u044B \u0432\u0440\u0430\u0447\u0438 \u0437\u043D\u0430\u043B\u0438 \u0442\u0430\u043A\u0436\u0435
    \u043C\u043D\u043E\u0433\u043E \u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u043C
    \u043C\u043E\u0437\u0433\u0435, \u043A\u0430\u043A \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043E\u0440\u0433\u0430\u043D\u0430\u0445, \u043C\u044B \u043F\u043E\u0434 \u0442\u0430\u043A
    \u0440\u0430\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
    \u043C\u0430\u043C\u0443.\u201D\r\n"
  - "\u041C\u0430\u043C\u0430\u2026 \r\n\u041C\u0430\u043C\u0443 \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
    \u0434\u0430\u0432\u043D\u043E. \u041C\u043D\u0435 \u0431\u044B\u043B\u043E 13,
    \u043A\u043E\u0433\u0434\u0430 \u0443 \u043C\u0430\u043C\u044B \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
    \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u0438\u043D\u0441\u0443\u043B\u044C\u0442.
    \u0415\u0451 \u043E\u0442\u0432\u0435\u0437\u043B\u0438 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443.
    \u042F \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B \u0443 \u0435\u0451 \u043A\u0440\u043E\u0432\u0430\u0442\u0438
    \u0446\u0435\u043B\u0443\u044E \u043D\u0435\u0434\u0435\u043B\u044E: \u043F\u043B\u0430\u043A\u0430\u043B,
    \u0437\u0432\u0430\u043B \u0435\u0451, \u043F\u0440\u043E\u0441\u0438\u043B \u0435\u0451
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F, \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0433\u043B\u0430\u0437\u0430. \u041C\u043E\u043B\u0438\u043B\u0441\u044F. \u0421\u043D\u043E\u0432\u0430
    \u043F\u043B\u0430\u043A\u0430\u043B \u0438 \u043E\u043F\u044F\u0442\u044C \u0435\u0451
    \u0437\u0432\u0430\u043B. \u0418\u043D\u043E\u0433\u0434\u0430 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u0432\u043E\u0442-\u0432\u043E\u0442 \u0438 \u0443 \u043D\u0435\u0451
    \u0434\u0440\u043E\u0433\u043D\u0443\u0442\u044C \u0440\u0435\u0441\u043D\u0438\u0446\u044B
    \u0438 \u043E\u043D\u0430 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0433\u043B\u0430\u0437\u0430.
    \u0418\u043D\u043E\u0433\u0434\u0430, \u0447\u0442\u043E \u044F \u0432\u0438\u0436\u0443
    \u043D\u0430 \u0435\u0451 \u0433\u0443\u0431\u0430\u0445 \u0443\u043B\u044B\u0431\u043A\u0443. 
    \u041D\u043E \u0441\u0442\u043E\u0438\u043B\u043E \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F,
    \u043A\u0430\u043A \u043D\u0430 \u043B\u0438\u0446\u0435 \u043E\u043F\u044F\u0442\u044C
    \u0437\u0430\u0441\u0442\u044B\u0432\u0430\u043B\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
    \u0431\u0435\u0437\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u0430\u044F, \u0432\u043E\u0441\u043A\u043E\u0432\u0430\u044F
    \u043C\u0430\u0441\u043A\u0430 \u2013 \u0435\u0451 \u043B\u0438\u0446\u043E.
    \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E \u043C\u0430\u043C\u0430
    \u0443\u0448\u043B\u0430, \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u0440\u0438\u0434\u044F
    \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435. \u0412\u0440\u0430\u0447\u0438
    \u0440\u0430\u0437\u0432\u0435\u043B\u0438 \u0440\u0443\u043A\u0430\u043C\u0438:
    \u0435\u0441\u043B\u0438 \u0431\u044B \u043C\u044B \u043C\u043E\u0433\u043B\u0438
    \u0431\u043E\u043B\u044C\u0448\u0435, \u0435\u0441\u043B\u0438 \u0431\u044B \u043C\u044B
    \u0437\u043D\u0430\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435, \u2013 \u043E\u0434\u043D\u0430\u043A\u043E
    \u043D\u0430 \u0434\u0430\u043D\u043D\u043E\u043C \u044D\u0442\u0430\u043F\u0435
    \u043C\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u0441\u0434\u0435\u043B\u0430\u0442\u044C.\r\n\u041E\u0442\u0435\u0446
    \u0442\u043E\u0436\u0435 \u0442\u043E\u0433\u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0440\u0443\u043A\u0430\u043C\u0438 \u0440\u0430\u0437\u0432\u0435\u043B: \u043D\u0430
    \u0432\u0441\u0435 \u0432\u043E\u043B\u044F \u0411\u043E\u0436\u044C\u044F.\r\n"
  - "\u0414\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u044F \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
    \u0436\u0438\u0442\u044C \u043A\u0430\u043A \u0437\u0430\u0432\u0435\u0449\u0430\u043B\u0430
    \u043C\u043D\u0435 \u043C\u0430\u0442\u044C \u0438 \u0435\u0451 \u043B\u044E\u0431\u0438\u043C\u0430\u044F
    \u041A\u043D\u0438\u0433\u0430. \u0418 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u0443 \u043C\u0435\u043D\u044F \u0434\u0430\u0436\u0435
    \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C.\r\n\u0414\u043E
    \u0441\u043C\u0435\u0440\u0442\u0438 \u043C\u0430\u0442\u0435\u0440\u0438 \u044F
    \u043D\u0435 \u0431\u044B\u043B \u0442\u0430\u043A\u0438\u043C \u0443\u0436 \u043F\u0440\u0438\u043B\u0435\u0436\u043D\u044B\u043C
    \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C. \u041E\u0434\u043D\u0430\u043A\u043E
    \u043F\u043E\u0441\u043B\u0435, \u044F \u0442\u0432\u0451\u0440\u0434\u044B\u0439
    \u0440\u0435\u0448\u0438\u043B, \u0432\u043E \u0447\u0442\u043E\u0431\u044B \u0442\u043E
    \u043D\u0438 \u0441\u0442\u0430\u043B\u043E \u043D\u0430\u0439\u0442\u0438 \u043E\u0442\u0432\u0435\u0442/\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445, \u043A\u0430\u043A \u043C\u043E\u044F
    \u043C\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u043D\u0438 \u043E\u0434\u0438\u043D
    \u0440\u0435\u0431\u0451\u043D\u043E\u043A \u0432 \u043C\u0438\u0440\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043C\u0430\u0442\u044C
    \u0438\u0437-\u0437\u0430 \u0431\u043E\u043B\u0435\u0437\u043D\u0438 \u043C\u043E\u0437\u0433\u0430.\r\n\u041C\u0438\u0440
    \u043D\u0435 \u0431\u0435\u0437 \u0434\u043E\u0431\u0440\u044B\u0445 \u043B\u044E\u0434\u0435\u0439.
    \u0421\u043E\u0441\u0435\u0434\u043A\u0430 \u0441 \u043D\u0430\u0448\u0435\u0439
    \u0443\u043B\u0438\u0446\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430
    \u043C\u043D\u0435 \u0441 \u0443\u0440\u043E\u043A\u0430\u043C\u0438. \u0423\u0447\u0438\u0442\u0435\u043B\u044F
    \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438\u0441\u044C \u0441\u043D\u0438\u0441\u0445\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u2013 \u043D\u0443 \u043A\u0430\u043A \u0436\u0435, \u0432 \u0442\u0430\u043A\u043E\u043C
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
    \u0431\u0435\u0437 \u043C\u0430\u0442\u0435\u0440\u0438. \u042F \u043E\u0441\u043E\u0431\u043E\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0443\u0434\u0435\u043B\u044F\u043B
    \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043D\u0430\u0443\u043A\u0430\u043C
    \u0438 \u0432\u0441\u043A\u043E\u0440\u0435 \u0443 \u043C\u0435\u043D\u044F \u043A
    \u043D\u0438\u043C \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F \u0442\u0430\u043B\u0430\u043D\u0442.\r\n\u042F
    \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0443\u044E
    \u0448\u043A\u043E\u043B\u0443, \u0430 \u043F\u043E\u0442\u043E\u043C, \u043D\u0435
    \u0438\u043D\u0430\u0447\u0435 \u043A\u0430\u043A \u0447\u0443\u0434\u043E\u043C,
    \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432 \u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0443\u0440\u0435
    \u041C\u0430\u0441\u0441\u0430\u0447\u0443\u0441\u0435\u0442\u0441\u043A\u043E\u0439
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435 \u043E\u0431\u0449\u0435\u0433\u043E
    \u043F\u0440\u043E\u0444\u0438\u043B\u044F \u0432 \u0411\u043E\u0441\u0442\u043E\u043D\u0435
    \u2013 \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
    \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u044B\u0445 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 \u043F\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044E
    \u0438  \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E \u0442\u0430\u043A\u043E\u0439
    \u043E\u0442\u0440\u0430\u0441\u043B\u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u044B
    \u043A\u0430\u043A \u043D\u0435\u0439\u0440\u043E\u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F.\r\n\u0412\u043E\u0442
    \u0443\u0436 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430: \xAB\u041F\u0440\u043E\u0441\u0438\u0442\u0435,
    \u0438 \u0434\u0430\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u0430\u043C;
    \u0438\u0449\u0438\u0442\u0435, \u0438 \u043D\u0430\u0439\u0434\u0435\u0442\u0435;
    \u0441\u0442\u0443\u0447\u0438\u0442\u0435, \u0438 \u043E\u0442\u0432\u043E\u0440\u044F\u0442
    \u0432\u0430\u043C; \u0438\u0431\u043E \u0432\u0441\u044F\u043A\u0438\u0439 \u043F\u0440\u043E\u0441\u044F\u0449\u0438\u0439
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442, \u0438 \u0438\u0449\u0443\u0449\u0438\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442, \u0438 \u0441\u0442\u0443\u0447\u0430\u0449\u0435\u043C\u0443
    \u043E\u0442\u0432\u043E\u0440\u044F\u0442\xBB (\u041E\u0442 \u041C\u0430\u0442\u0444\u0435\u044F
    7:7\u20138).\r\n"
  - "\u041D\u0430 \u043F\u0440\u0435\u0434\u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
    \u0433\u043E\u0434\u0443 \u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0443\u0440\u044B
    \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043A\u0430,
    \u0441 \u0442\u044F\u0436\u0435\u043B\u043E\u0439 \u0444\u043E\u0440\u043C\u044B
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0437\u0433\u0430
    \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0440\u0430\u0437\u0440\u044B\u0432\u0430
    2\u0445 \u0430\u043D\u0435\u0432\u0440\u0438\u0437\u043C.   \u0421\u043B\u0443\u0447\u0430\u0439
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0440\u0435\u0434\u043A\u0438\u0439,
    \u043D\u043E, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
    \u0442\u0440\u0430\u0433\u0438\u0447\u043D\u044B\u0439. \u0414\u0435\u0432\u0443\u0448\u043A\u0430,
    \u0435\u0449\u0451 \u0441\u043E\u0432\u0441\u0435\u043C \u0440\u0435\u0431\u0435\u043D\u043E\u043A,
    \u0431\u044B\u043B\u0430 \u0438\u0437 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
    \u0441\u0435\u043C\u044C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441
    \u043E\u043F\u0430\u0441\u043A\u043E\u0439 \u0438 \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C
    \u043A\u043E\u0441\u044F\u0442\u0441\u044F \u043D\u0430 \u0432\u0440\u0430\u0447\u0435\u0439.
    \u0412\u043D\u0430\u0447\u0430\u043B\u0435 \u043E\u043D\u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438\u0441\u044C
    \u043B\u044E\u0431\u044B\u0445 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B \u043F\u043E\u043C\u043E\u0433\u043B\u0438
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0436\u0438\u0437\u043D\u0438 \u0438\u0445
    \u0434\u043E\u0447\u0435\u0440\u0438. \u041E\u043D\u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
    \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u0438, \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435
    \u0443 \u043D\u0435\u0435 \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u0432\u0430\u0435\u0442
    \u0438 \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u043E\u0439\u0434\u0451\u0442,
    \u0432\u0441\u0451, \u0447\u0442\u043E \u0435\u0439 \u043D\u0443\u0436\u043D\u043E
    - \u044D\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043A\u043E\u044F.
    \u0412\u0441\u0451, \u0447\u0442\u043E \u043C\u044B \u0434\u043E\u0431\u0438\u043B\u0438\u0441\u044C
    \u043E\u0442 \u0435\u0451 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439,
    - \u044D\u0442\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u041A\u0422 \u043C\u043E\u0437\u0433\u0430.
    \u0418 \u0434\u0430\u0436\u0435 \u0443\u0432\u0438\u0434\u0435\u0432 \u043D\u0430
    \u0441\u043D\u0438\u043C\u043A\u0435 \u0430\u043D\u0435\u0432\u0440\u0438\u0437\u043C\u0443
    \u043E\u043D\u0438 \u0434\u043E\u043B\u0433\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438\u0441\u044C
    \u043E\u0442 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043A\u0430\u043A\u0438\u0445-\u043B\u0438\u0431\u043E
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0438 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440
    \u0438 \u043C\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043A
    \u0441\u0442\u0430\u0440\u044B\u043C \u043C\u0435\u0442\u043E\u0434\u043E\u043C
    \u043B\u0435\u0447\u0435\u043D\u0438\u044F: \u0441\u0442\u0440\u043E\u0433\u0438\u0439
    \u043F\u043E\u0441\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C,
    \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u0432.
    \r\n\u0412 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442
    \u043E\u043D\u0430 \u0434\u0430\u0436\u0435 \u043F\u0440\u0438\u0448\u043B\u0430
    \u0432 \u0441\u0435\u0431\u0435. \u0411\u044B\u043B\u0430 \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430,
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u043D\u0435
    \u0445\u043E\u0447\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
    \u0432 \u044D\u0442\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
    \u041C\u044B \u0432\u0441\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0438
    \u043E\u043D\u0430 \u043F\u0440\u043E \u0434\u043E\u043C. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438
    \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0438
    \u0438 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430 \u043D\u0435\u0451 \u043A\u0440\u0438\u0447\u0430\u0442\u044C,
    \u0447\u0442\u043E \u043E\u043D\u0430 \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430\u044F
    \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0435\u0439 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0434\u043E\u043C\u043E\u0439,
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043E\u043D\u0430 \u0435\u0449\u0435
    \u0440\u0435\u0431\u0435\u043D\u043E\u043A. \u041E\u0436\u0438\u0434\u0430\u0435\u043C\u043E
    \u0443 \u043D\u0435\u0451 \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u0438 \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F
    \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u0438\u0441\u0442\u0443\u043F \u2013
    \u0443 \u043D\u0435\u0451 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C
    , \u043A\u0430\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u0443\u0436\u0435 \u0432\u0442\u043E\u0440\u0430\u044F \u0430\u043D\u0435\u0432\u0440\u0438\u0437\u043C\u0430
    \u0438 \u0435\u0451 \u0432 \u0441\u0440\u043E\u0447\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0432 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E,
    \u043D\u043E \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0437\u0433\u0430
    \u0431\u044B\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u0431\u0448\u0438\u0440\u043D\u044B\u0435
    \r\n\u0417\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043D\u0435\u0439\u0440\u043E
    \u0442\u043E\u0433\u0434\u0430 \u0441\u043A\u0430\u0437\u0430\u043B \u0447\u0442\u043E
    \u043C\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E
    \u0441\u0442\u0430\u043B\u0438 \u0435\u0451 \u043E\u043F\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0435\u0449\u0451 \u0440\u0430\u0437 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u043E\u0435 \u043C\u0435\u0442\u043E\u0434\u044B
    \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0430\u044E\u0442, \u043D\u0443\u0436\u043D\u043E
    \u0438\u0441\u043A\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u043F\u0443\u0442\u0438
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C
    \u0438\u0445 \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435
    \u0447\u0435\u043C \u043C\u044B \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437.
    \u041E\u043D \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430
    \u043D\u0430\u0441 \u043E\u0440\u0434\u0438\u043D\u0430\u0442\u043E\u0440\u043E\u0432,
    \u0438 \u0441\u043A\u0430\u0437\u0430\u043B \u0447\u0442\u043E \u044D\u0442\u043E
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043D\u0430\u043C \u2013 \u043D\u0430\u0439\u0442\u0438 \u043D\u043E\u0432\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u043D\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C\u0441\u044F
    \u0441 \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C,
    \u043F\u043E\u0440\u0438\u0446\u0430\u043D\u0438\u0435\u043C \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0434\u0430\u0436\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C
    \u043A\u0430\u043A \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0442\u0430\u043A
    \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u0446\u0435\u043B\u043E\u043C.
    \u041D\u043E \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043B\u044F \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F
    \u043D\u0430\u0448\u0438\u0445 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432.\r\n\u0422\u043E\u0433\u0434\u0430
    \u044D\u0442\u043E \u0437\u0432\u0443\u0447\u0430\u043B\u043E, \u043A\u0430\u043A
    \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u043E\u0442 \u0418\u0441\u0430\u0438\u044F
    43:19 \xAB\u0412\u043E\u0442, \u042F \u0434\u0435\u043B\u0430\u044E \u043D\u043E\u0432\u043E\u0435;
    \u043D\u044B\u043D\u0435 \u043E\u043D\u043E \u043F\u0440\u043E\u0437\u044F\u0431\u0430\u0435\u0442;
    \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u0432\u044B \u043D\u0435 \u0445\u043E\u0442\u0438\u0442\u0435
    \u0437\u043D\u0430\u0442\u044C \u0435\u0433\u043E? \u042F \u043F\u0440\u043E\u043B\u043E\u0436\u0443
    \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u0441\u0442\u0435\u043F\u0438, \u0440\u0435\u043A\u0438
    \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435\xBB\r\n"
  - "\u0417\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430
    \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0430
    \u0434\u0430\u043B\u0435\u043A\u043E \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C
    \u0432\u043F\u0435\u0440\u0451\u0434 \u043D\u0430 \u043F\u0443\u0442\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u043D\u0435\u0439\u0440\u043E\u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438.
    \u0411\u044B\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B \u043D\u043E\u0432\u044B\u0435
    \u043C\u0435\u0442\u043E\u0434\u044B, \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u044B
    \u043D\u043E\u0432\u044B\u0435 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B.
    \u041F\u0440\u043E\u0446\u0435\u043D\u0442 \u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0441\u0442\u0438
    \u0441\u043D\u0438\u0437\u0438\u043B\u0441\u044F \u0441 60 \u0434\u043E 30%.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u0435 \u0435\u0449\u0451 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B\u0438
    \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0436\u0435 \u043D\u043E\u0432\u044B\u0435
    \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043C\u0435\u0442\u043E\u0434\u044B
    \u043B\u0435\u0447\u0435\u043D\u0438\u044F. \u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E
    \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u043E\u0432\u043E\u0435
    \u043F\u0443\u0442\u0438, \u043D\u043E\u0432\u043E\u0435 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B,
    \u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044B \u2013 
    \u044D\u0442\u0438\u043C \u044F \u0438 \u0440\u0435\u0448\u0438\u043B \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
    \u043F\u0435\u0440\u0435\u0439\u0434\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0443 \u0432 \u0430\u043F\u0441\u0442\u0435\u0439\u0442
    \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0430, \u043F\u043E\u0441\u0440\u0435\u0434\u0438
    \u0433\u043B\u0443\u0445\u043E\u0433\u043E \u043B\u0435\u0441\u0430, \u0433\u0434\u0435
    \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442.
    \r\n\u041F\u0440\u043E\u0432\u0435\u0434\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0445 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u0432,
    \u0432 \u0438\u0442\u043E\u0433\u0435 \u043C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0436\u0438\u0437\u043D\u044C \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E
    \u0431\u0438\u0437\u043D\u0435\u0441\u043C\u0435\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C 
    \u043F\u043E\u043C\u043E\u0433 \u043C\u043D\u0435 \u0432\u044B\u043A\u0443\u043F\u0438\u0442\u044C
    \u044D\u0442\u043E \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u043F\u0435\u0440\u0435\u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430 \u0441\u0432\u043E\u0439 \u0432\u043A\u0443\u0441. \r\n\u0422\u0430\u043A
    \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u041D\u0435\u0439\u0440\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043B\u0438\u043D\u0438\u043A\u0430 \u0434\u043E\u043A\u0442\u043E\u0440\u0430
    \u041C\u043E\u0440\u0440\u043E, \u0438 \u0438\u043C\u044F \u043C\u043E\u0435
    \u0441\u0442\u0430\u043B\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u0440\u0443\u0433\u0430\u0445
    \u043D\u0435\u0439\u0440\u043E\u043C\u0435\u0434\u0438\u0446\u0438\u043D\u044B,
    \u043D\u043E \u0434\u0430\u0436\u0435 \u043F\u0430\u0440\u0443 \u0440\u0430\u0437
    \u043F\u043E\u044F\u0432\u043B\u044F\u043B\u043E\u0441\u044C \u0432 \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0430\u0445
    \u0433\u0430\u0437\u0435\u0442, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0448\u0443\u043C\u0438\u0445\u0430
    \u0431\u044B\u043B\u0430 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438,
    \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0436\u0435 \u043C\u043E\u0435\u0439,
    \u043A\u043B\u0438\u043D\u0438\u043A\u0438.\r\n"
  - "\u041A\u0430\u043A \u0443\u043A\u0430\u0437\u0430\u043D\u043E \u0432 \u043D\u0430\u0448\u0438\u0445
    \u0431\u0440\u043E\u0448\u044E\u0440\u0430\u0445, \u0432 \u0441\u0432\u043E\u0435\u0439
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435 \u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u043C\u0435\u0442\u043E\u0434\u044B
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043D\u0430
    \u043D\u0435\u0439\u0440\u043E\u043D\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u0438
    \u043C\u043E\u0437\u0433\u0430: \u0437\u0432\u0443\u043A, \u0441\u0432\u0435\u0442
    \u0438 \u0446\u0432\u0435\u0442, \u0441\u0435\u043D\u0441\u043E\u0440\u0438\u043A\u0443,
    \u0430 \u043F\u043E\u0441\u043B\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F
    \u201C\u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u041B\u0430\u0437\u0430\u0440\u044F\u201D,
    \u044F \u0441\u0442\u0430\u043B \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442,
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0437\u043E\u043B\u043F\u0435\u0434\u0435\u043C\u0430,
    \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u043F\u0440\u043E\u0434\u043B\u0438\u0442\u044C,
    \u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438 \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u044D\u0442\u043E\u0442
    \u044D\u0444\u0444\u0435\u043A\u0442.\r\n\r\n"
  - "\u041A\u0430\u043A \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B
    \u043D\u0430\u0448 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A, \u043A\u0430\u043A
    \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u043D\u0430\u0447\u0430\u043B \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C
    \u0441\u0432\u043E\u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u043D\u0430 \u044D\u0442\u0443 \u0442\u0435\u043C\u0443, \u0442\u043E \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F
    \u0441 \u0432\u043E\u043B\u043D\u043E\u0439 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u0430
    \u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0439, \u043A\u0430\u043A \u0441\u043E
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0442\u0430\u043A
    \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438.
    \u041E\u0441\u043E\u0431\u043E \u0440\u044C\u044F\u043D\u044B\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0441\u0442\u044B
    \u0432 \u043F\u0435\u0440\u0432\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438
    \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u044B \u043F\u043E\u0434 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438
    \u043A\u043B\u0438\u043D\u0438\u043A\u0438. \u041E\u043D\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u0438,
    \u0447\u0442\u043E \u0442\u043E \u0447\u0442\u043E \u044F \u0434\u0435\u043B\u0430\u044E
    \u2013 \u0438\u0434\u0451\u0442 \u043D\u0435 \u043E\u0442 \u0411\u043E\u0433\u0430,
    \u0430 \u043E\u0442 \u0434\u044C\u044F\u0432\u043E\u043B\u0430. \u0418\u0431\u043E
    \u043D\u0435 \u0434\u0430\u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
    \u0440\u0435\u0448\u0430\u0442\u044C \u043A\u043E\u0433\u0434\u0430 \u043A\u043E\u043C\u0443
    \u0436\u0438\u0442\u044C, \u0430 \u043A\u043E\u0433\u0434\u0430 \u0443\u043C\u0438\u0440\u0430\u0442\u044C.
    \u042F \u0436\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u043B
    \u0438\u043C \u0441\u0442\u0438\u0445\u043E\u043C \u0438\u0437 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u044F
    \u0415\u0444\u0435\u0441\u044F\u043D\u0430\u043C 2:10: \u0412\u0441\u0451, \u0447\u0435\u0433\u043E
    \u044F \u0434\u0435\u043B\u0430\u044E \u0435\u0441\u0442\u044C \u0431\u043B\u0430\u0433\u043E,
    \xAB\u0418\u0431\u043E \u043C\u044B \u2014 \u0415\u0433\u043E \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435,
    \u0441\u043E\u0437\u0434\u0430\u043D\u044B \u0432\u043E \u0425\u0440\u0438\u0441\u0442\u0435
    \u0418\u0438\u0441\u0443\u0441\u0435 \u043D\u0430 \u0434\u043E\u0431\u0440\u044B\u0435
    \u0434\u0435\u043B\u0430...\xBB.\r\n"
  - "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B
    \u044F \u0434\u043E\u0431\u0438\u043B\u0441\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0443\u0441\u043F\u0435\u0445\u043E\u0432 \u0432 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0438
    \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u041B\u0430\u0437\u0430\u0440\u044F
    \u0443 \u0441\u0432\u043E\u0438\u0445 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432.
    \u042F \u0432\u0438\u0434\u043E\u0438\u0437\u043C\u0435\u043D\u0438\u043B \u0444\u043E\u0440\u043C\u0443\u043B\u0443
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0437\u043C
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432 \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u043F\u0435\u0440\u0438\u043E\u0434 \u043F\u043E\u043B\u0443\u0440\u0430\u0441\u043F\u0430\u0434\u0430
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u0438\u0445 \u0442\u0435\u043B\u0430\u0445
    \u0441 4 \u0447\u0430\u0441\u043E\u0432 \u0434\u043E 8, \u0430 \u0443 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432 \u2013 \u0434\u043E 12.
    \u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B \u043F\u043E\u0441\u043B\u0435
    \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430 \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
    \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435 \u043E\u0447\u0435\u043D\u044C
    \u044F\u0440\u043A\u043E \u0438 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
    \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438 \u0441\u0432\u043E\u0439
    \u043E\u043F\u044B\u0442 \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u044F
    \u0432 \u043A\u043E\u043C\u0435. \u041D\u043E, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u043C\u043D\u043E\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0441\u0432\u043E\u0438\u043C \u0440\u043E\u0434\u043D\u044B\u043C,
    \u0447\u0442\u043E \u043E\u0449\u0443\u0449\u0430\u043B\u0438 \u0438\u0445 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0438\u043B\u0438 \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0441\u043B\u043E\u0432\u0430,
    \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u0435 \u043A \u043D\u0438\u043C, 
    \u044D\u0442\u0438 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0434\u0440\u0443\u0433\u043E\u0439
    \u041E\u043F\u044B\u0442, \u0432\u0438\u0434\u0435\u043D\u0438\u044F \u0438 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F.
    \u0418 \u044D\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u043E
    \u043C\u0435\u043D\u044F \u043A \u043C\u043E\u0438\u043C \u0434\u0435\u0442\u0441\u043A\u0438\u043C
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
    \u043E \u043C\u0430\u043C\u0435 \u0438 \u0435\u0451 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430\u0445
    \u043E\u0431 \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u0445. \r\n\u041F\u0430\u0446\u0438\u0435\u043D\u0442\u044B,
    \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0448\u0438\u0435 \u041E\u043F\u044B\u0442
    \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
    \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434 \u0438\u0437 \u044D\u0442\u043E\u0433\u043E
    \u0441\u043D\u0430\u2013\u0432\u0435\u0434\u0435\u043D\u0438\u044F. \u041E\u043D\u0438
    \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0437\u0430\u043F\u0435\u0440\u0442\u044B
    \u0432 \u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0438 \u043F\u043E\u043A\u0430
    \u043D\u0435 \u043F\u043E\u0439\u043C\u0443\u0442 \u043A\u0430\u043A \u0438\u043C
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0438\u043B\u0438 \u0447\u0442\u043E
    \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C, -
    \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E,
    \u0438  \u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
    \u043E\u043D\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442. \u0414\u0430\u0436\u0435
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u201C\u0432\u0438\u0434\u044F\u0442\u201D
    \u0432\u044B\u0445\u043E\u0434, \u043D\u043E \u043D\u0438\u043A\u0430\u043A \u043D\u0435
    \u043C\u043E\u0433\u0443\u0442 \xAB\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\xBB
    \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\u0441\u044F \u043A
    \u0440\u0435\u0448\u0435\u043D\u0438\u044E, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
    \u0438\u0445 \u0447\u0442\u043E-\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
    \r\n"
  - "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u043F\u0435\u0440\u0432\u044B\u0439
    \u0440\u0430\u0437 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u044D\u0442\u0443
    \u0438\u0441\u0442\u043E\u0440\u0438\u044E, \u043A\u0442\u043E-\u0442\u043E \u0438\u0437
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B,
    \u0447\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u044D\u0442\u043E
    \u0438\u0445 \u0442\u0435\u043B\u043E, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0438\u0445 \u043E\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u0448\u0430\u0433\u0430.  \r\n\u0427\u0442\u043E \u0436, \u044F \u043F\u043E\u043C\u043E\u0433\u0443
    \u0438\u043C \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u044D\u0442\u043E\u0442
    \u0448\u0430\u0433 \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0441\u0432\u044F\u0437\u044C \u0441 \u0442\u0435\u043B\u043E\u043C.\r\n\u041D\u0443\u0436\u043D\u043E
    \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0435\u0449\u0435 \u043F\u0430\u0440\u043E\u0447\u043A\u0443
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439!\r\n"
  - "\u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E, \u043C\u043D\u0435 \u043D\u0435
    \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0434\u043E\u043B\u0433\u043E
    \u0436\u0434\u0430\u0442\u044C \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430. \u0412\u0441\u0435\u0433\u043E
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439
    \u043A \u043D\u0430\u043C \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u043E\u0432\u044B\u0439
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442. \u0415\u0433\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u0431\u043E\u043B\u0435\u0437\u043D\u0438 \u0438 \u0440\u043E\u0434 \u0437\u0430\u043D\u044F\u0442\u0438\u0439
    \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442!\r\n\u0427\u0442\u043E
    \u0436 \u0447\u0442\u043E \u0436, \u043F\u043E\u0440\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
    \u043D\u043E\u0432\u044B\u0439 \u0446\u0438\u043A\u043B \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430, \u0430 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F
    \u0435\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435,
    \u044F \u043D\u0430\u0437\u0432\u0430\u043B \u0435\u0433\u043E \u2013 \u0413\u0440\u0430\u043D\u044C.\r\n"
